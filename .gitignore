# Marketing: masters y derivados pesados del video (los .json/.srt sí van al repo)
dist-mascara
# Copia de marketing/mascara/public/mediapipe (la hace scripts/copiar-mediapipe.mjs)
/public/mediapipe/
marketing/video/*/original.mp4
marketing/video/*/musica.mp3
marketing/video/*/pantalla.mov
marketing/video/*/tts/
marketing/video/*/salida/
