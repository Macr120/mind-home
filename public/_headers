# Cabeceras de caché (formato Netlify / Cloudflare Pages; inerte en otros
# hostings — si el deploy acaba en Vercel, portar a vercel.json con las mismas
# rutas). Los assets de /assets/* llevan hash en el nombre: inmutables. El
# resto de public/ NO lleva hash: max-age corto + stale-while-revalidate.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/textures/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/ejercicios/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/cocina/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/ejemplos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/demo/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/mediapipe/*
  Cache-Control: public, max-age=604800

/index.html
  Cache-Control: no-cache
