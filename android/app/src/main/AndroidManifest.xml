<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:screenOrientation="fullSensor"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Widgets de pantalla de inicio (ver src/core/widgets/ y widgets/ en java) -->
        <receiver
            android:name=".widgets.HoyWidgetProvider"
            android:label="@string/widget_hoy_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hoy_info" />
        </receiver>

        <receiver
            android:name=".widgets.CasaWidgetProvider"
            android:label="@string/widget_casa_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_casa_info" />
        </receiver>

        <receiver
            android:name=".widgets.ChatWidgetProvider"
            android:label="@string/widget_chat_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_chat_info" />
        </receiver>

        <service
            android:name=".widgets.HoyWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <receiver
            android:name=".widgets.WidgetAccionReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Dictado por voz (fallback de Whisper: SpeechRecognition no existe en este WebView) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Máscara AR (getUserMedia de video en el WebView; el Bridge pide el permiso runtime) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      `@capacitor/local-notifications` fusiona SCHEDULE_EXACT_ALARM, otro permiso
      que Play revisa con lupa (solo lo admite en relojes y calendarios). No hace
      falta: los avisos se emiten en el momento, no se programan con antelación.
      El día que se programen para una hora futura exacta, hay que quitar este
      `remove` y justificar el permiso en la ficha.
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />

    <!--
      Visibilidad de paquetes (Android 11+): sin esto el motor de texto a voz del
      sistema queda invisible y `speechSynthesis.getVoices()` devuelve una lista
      vacía, así que la app creería que hay voz y no sonaría nada. Lo necesitan
      la lectura de los asistentes y la narración de los tutoriales.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
