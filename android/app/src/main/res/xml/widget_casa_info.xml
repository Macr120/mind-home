<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis: 30 min es el mínimo que Android respeta; solo refresca
     la fecha — la foto y los datos los empuja la app cuando cambian. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_casa_desc"
    android:initialLayout="@layout/widget_casa"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:previewLayout="@layout/widget_casa"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
