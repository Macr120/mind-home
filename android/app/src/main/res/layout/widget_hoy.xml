<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Hoy»: cabecera + lista palomeable (HoyWidgetService). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_hoy_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_hoy_cabecera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_hoy_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#EDEDF2"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_hoy_fecha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#9AA0AA"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_hoy_cuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8BE9B6"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_hoy_desactualizado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#F87171"
            android:textSize="10sp"
            android:visibility="gone" />

        <ListView
            android:id="@+id/widget_hoy_lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:divider="#14FFFFFF"
            android:dividerHeight="1dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hoy_vacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="#9AA0AA"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
