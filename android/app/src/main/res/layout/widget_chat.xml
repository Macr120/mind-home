<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Chat»: lanzador puro (no lee el snapshot). Abre el chat de la casa,
     o directo con la cámara o el dictado. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/chat_abrir"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_pildora"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="26dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/widget_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/widget_chat_abrir"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/chat_camara"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_circulo"
            android:contentDescription="@string/widget_chat_camara"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_camara" />

        <ImageView
            android:id="@+id/chat_voz"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/widget_circulo"
            android:contentDescription="@string/widget_chat_voz"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_voz" />
    </LinearLayout>
</LinearLayout>
