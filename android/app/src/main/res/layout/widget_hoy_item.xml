<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de la lista «Hoy»: emoji · título/detalle · hora · palomita. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_fila"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/item_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#EDEDF2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/item_detalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#9AA0AA"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/item_hora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="#9AA0AA"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Palomita en dos capas para poder teñirla del tema: el círculo/aro
         (item_check) del acento o tinta2, y la marca (item_check_marca) del
         color del FONDO, que sobre el círculo parece recortada. -->
    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="10dp">

        <ImageView
            android:id="@+id/item_check"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_palomear" />

        <ImageView
            android:id="@+id/item_check_marca"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:src="@drawable/widget_check_marca"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
