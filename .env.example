# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` está ignorado por git: NUNCA subas claves al repo.
# Sin este archivo la app funciona 100% local (sin cuenta, sin IA de servidor).

# Scripts de generación de contenido (no van al bundle: sin prefijo VITE_).
# `npm run ejemplos:texto` usa Claude; `npm run ejemplos:imagenes`, OpenAI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Proyecto Supabase (Dashboard → Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# RevenueCat Web Billing (public API key `rcb_...`): la caja del navegador y del
# escritorio, que cobra DIRECTO y sin comisión de tienda.
VITE_REVENUECAT_WEB_KEY=

# RevenueCat en las tiendas (compra in-app, obligatoria en Android e iOS).
# Public SDK keys del MISMO proyecto de RevenueCat: `goog_...` y `appl_...`.
# Sin ellas la app nativa no puede vender nada (`hayPagos()` da false).
VITE_REVENUECAT_ANDROID_KEY=
VITE_REVENUECAT_IOS_KEY=

# Finnhub (acciones del Despacho): SIN variable a propósito. Cualquier VITE_*
# acaba legible en el bundle y el APK, así que la clave ya no se incluye: cada
# usuario pega la suya desde la UI (⚙️ API en Mercados; clave gratuita en
# https://finnhub.io/register).

# Web pública (landing + /cuenta). URL_WEB = dominio de venta (sin barra final);
# URL_APP = dónde vive la app web. La app los usa para enlazar el checkout y
# la landing para el botón «Abrir la app». En dev: 5174 y 5173.
# OJO: sin URL_WEB los CTA de suscripción caen al fallback de
# `src/core/cuenta/urlWeb.ts` (dev: localhost:5174) o desaparecen en silencio.
VITE_URL_WEB=
VITE_URL_APP=

# «Cómo llegar» (sala de viajes): rutas, transporte público, buscador y mapa de HERE.
# Clave del plan Base de HERE (cupo gratis POR API: 2 500 intermodales/mes es el techo;
# ver docs/HERE.md para registrar la app, los dominios de confianza y el consumo).
# Aquí va la clave de la app WEB (también la que usa `npm run dev`).
VITE_HERE_KEY=
# HERE pide un App ID por aplicación y cuenta como distintas la web, Android, iOS y
# el escritorio. Las otras tres claves NO van aquí: cada una vive en su propio
# archivo, con el MISMO nombre de variable, y la inyecta el build de ese canal
# (`scripts/build-canal.mjs`, que sigue compilando en modo producción):
#   .env.android.local     -> npm run build:android     (lo usa Gradle)
#   .env.ios.local         -> npm run build:ios         (lo usa la fase de Xcode)
#   .env.escritorio.local  -> npm run build:escritorio  (lo usa escritorio:win/mac)
# Se crean con `node scripts/clave-here.mjs --android|--ios|--windows <clave>`.
# Así cada artefacto lleva solo su clave (ver docs/HERE.md).
