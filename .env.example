# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` está ignorado por git: NUNCA subas claves al repo.
# Sin este archivo la app funciona 100% local (sin cuenta, sin IA de servidor).

# Scripts de generación de contenido (no van al bundle: sin prefijo VITE_).
# `npm run ejemplos:texto` usa Claude; `npm run ejemplos:imagenes`, OpenAI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Proyecto Supabase (Dashboard → Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# RevenueCat Web Billing (public API key `rcb_...`)
VITE_REVENUECAT_WEB_KEY=

# Finnhub (acciones del Despacho): SIN variable a propósito. Cualquier VITE_*
# acaba legible en el bundle y el APK, así que la clave ya no se incluye: cada
# usuario pega la suya desde la UI (⚙️ API en Mercados; clave gratuita en
# https://finnhub.io/register).

# Web pública (landing + /cuenta). URL_WEB = dominio de venta (sin barra final);
# URL_APP = dónde vive la app web. La app los usa para enlazar el checkout y
# la landing para el botón «Abrir la app». En dev: 5174 y 5173.
# OJO: sin URL_WEB los CTA de suscripción caen al fallback de
# `src/core/cuenta/urlWeb.ts` (dev: localhost:5174) o desaparecen en silencio.
VITE_URL_WEB=
VITE_URL_APP=
