          "visual": {
            "tipo": "dato",
            "cifra": "150–300",
            "clave": "minutosModerados"
          },
          "texto": "耐力：世界卫生组织建议，成年人每周进行150到300分钟的中等强度活动，或者75到150分钟的高强度活动。超过这个范围，还能带来更多好处。",
          "lamina": "resistencia"
        },
        {
          "id": "fuerza",
          "escena": "Peso muerto rumano",
          "visual": {
            "tipo": "dato",
            "cifra": "2+",
