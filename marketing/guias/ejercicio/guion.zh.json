              "masSeries",
              "masLento",
              "menosApoyo"
            ]
          },
          "texto": "没有器械也一样能加负荷：多做几次、多加一组、下放得更慢，或者减少支撑，比如从跪姿俯卧撑过渡到标准俯卧撑。",
          "lamina": "variables"
        },
        {
          "id": "diez",
          "escena": "Trote suave",
          "visual": {
            "tipo": "dato",
            "cifra": "≈10 %",
            "clave": "progresion"
