[
  { "ruta": "recetas.0.nombre", "texto": "跑者隔夜燕麦" },
  { "ruta": "recetas.0.carpeta", "texto": "跑者" },
  { "ruta": "recetas.0.ingredientes.0", "texto": "燕麦片 60克" },
  { "ruta": "recetas.0.ingredientes.1", "texto": "牛奶 150毫升(或燕麦奶)" },
  { "ruta": "recetas.0.ingredientes.2", "texto": "无糖希腊酸奶 100克" },
  { "ruta": "recetas.0.ingredientes.3", "texto": "奇亚籽 1汤匙(12克)" },
  { "ruta": "recetas.0.ingredientes.4", "texto": "成熟香蕉 1根" },
  { "ruta": "recetas.0.ingredientes.5", "texto": "蜂蜜 1茶匙" },
  { "ruta": "recetas.0.ingredientes.6", "texto": "肉桂粉 少许" },
  { "ruta": "recetas.0.ingredientes.7", "texto": "盐 少许" },
  { "ruta": "recetas.0.pasos.0", "texto": "在玻璃罐里把燕麦、奇亚籽、肉桂粉和盐搅拌均匀。" },
  { "ruta": "recetas.0.pasos.1", "texto": "倒入牛奶和酸奶,搅拌至没有干燥的结块。" },
  { "ruta": "recetas.0.pasos.2", "texto": "用叉子压碎半根香蕉拌入,另一半放冰箱保存。" },
  { "ruta": "recetas.0.pasos.3", "texto": "盖上盖子,冷藏6到10小时。" },
  { "ruta": "recetas.0.pasos.4", "texto": "第二天早上,把剩下的香蕉切片铺在上面,淋上蜂蜜。出门跑步前90分钟吃完。" },
  { "ruta": "recetas.1.nombre", "texto": "赛前一晚的碳水补充意面" },
  { "ruta": "recetas.1.carpeta", "texto": "跑者" },
  { "ruta": "recetas.1.ingredientes.0", "texto": "意大利面 200克" },
  { "ruta": "recetas.1.ingredientes.1", "texto": "番茄碎罐头 400克" },
  { "ruta": "recetas.1.ingredientes.2", "texto": "大蒜 2瓣" },
  { "ruta": "recetas.1.ingredientes.3", "texto": "橄榄油 2汤匙" },
  { "ruta": "recetas.1.ingredientes.4", "texto": "干牛至 1茶匙" },
  { "ruta": "recetas.1.ingredientes.5", "texto": "白糖 1茶匙" },
  { "ruta": "recetas.1.ingredientes.6", "texto": "帕玛森芝士碎 40克" },
  { "ruta": "recetas.1.ingredientes.7", "texto": "新鲜罗勒叶 6片" },
  { "ruta": "recetas.1.ingredientes.8", "texto": "盐" },
  { "ruta": "recetas.1.pasos.0", "texto": "大锅烧一锅加了足量盐的水,煮沸。" },
  { "ruta": "recetas.1.pasos.1", "texto": "同时,把蒜片放入橄榄油里,中小火煎2分钟上色,注意别煎焦。" },
  { "ruta": "recetas.1.pasos.2", "texto": "加入番茄、牛至、白糖和一小撮盐,小火炖15分钟。" },
  { "ruta": "recetas.1.pasos.3", "texto": "意面煮的时间比包装说明少一分钟,留半杯煮面水备用。" },
  { "ruta": "recetas.1.pasos.4", "texto": "把意面倒进酱汁里,加一点煮面水拌炒1分钟。" },
  { "ruta": "recetas.1.pasos.5", "texto": "撒上帕玛森芝士和罗勒装盘。低脂清淡、不辣的晚餐:明天要比赛。" },
  { "ruta": "recetas.2.nombre", "texto": "一周分量的鸡肉碗" },
  { "ruta": "recetas.2.ingredientes.0", "texto": "鸡胸肉 600克" },
  { "ruta": "recetas.2.ingredientes.1", "texto": "糙米(生) 300克" },
  { "ruta": "recetas.2.ingredientes.2", "texto": "红薯(切块) 400克" },
  { "ruta": "recetas.2.ingredientes.3", "texto": "西兰花(切小朵) 400克" },
  { "ruta": "recetas.2.ingredientes.4", "texto": "橄榄油 3汤匙" },
  { "ruta": "recetas.2.ingredientes.5", "texto": "甜红椒粉 1茶匙" },
  { "ruta": "recetas.2.ingredientes.6", "texto": "孜然粉 1茶匙" },
  { "ruta": "recetas.2.ingredientes.7", "texto": "无糖希腊酸奶 200克" },
  { "ruta": "recetas.2.ingredientes.8", "texto": "柠檬 1个" },
  { "ruta": "recetas.2.ingredientes.9", "texto": "盐和胡椒" },
  { "ruta": "recetas.2.pasos.0", "texto": "烤箱预热到200°C。" },
  { "ruta": "recetas.2.pasos.1", "texto": "红薯拌1汤匙橄榄油、盐和胡椒,烤25分钟。" },
  { "ruta": "recetas.2.pasos.2", "texto": "鸡胸肉调味,抹上甜红椒粉、孜然和1汤匙橄榄油,煎锅两面各煎6分钟。静置5分钟后切条。" },
  { "ruta": "recetas.2.pasos.3", "texto": "糙米用加盐的水煮25分钟,沥干。" },
  { "ruta": "recetas.2.pasos.4", "texto": "西兰花蒸5分钟就好:要保持脆度才能放到周四还好吃。" },
  { "ruta": "recetas.2.pasos.5", "texto": "酸奶拌入半个柠檬的汁、盐和剩下的1汤匙橄榄油。" },
  { "ruta": "recetas.2.pasos.6", "texto": "把所有食材分装进四个饭盒,酱汁单独放。冷藏能保存四天。" },
  { "ruta": "recetas.3.nombre", "texto": "在家做日式咖喱" },
  { "ruta": "recetas.3.carpeta", "texto": "来自日本" },
  { "ruta": "recetas.3.ingredientes.0", "texto": "鸡腿肉(切块) 500克" },
  { "ruta": "recetas.3.ingredientes.1", "texto": "洋葱(切丝) 2个" },
  { "ruta": "recetas.3.ingredientes.2", "texto": "胡萝卜(切厚片) 2根" },
  { "ruta": "recetas.3.ingredientes.3", "texto": "土豆(切块) 400克" },
  { "ruta": "recetas.3.ingredientes.4", "texto": "黄油 40克" },
  { "ruta": "recetas.3.ingredientes.5", "texto": "面粉 40克" },
  { "ruta": "recetas.3.ingredientes.6", "texto": "咖喱粉 2汤匙" },
  { "ruta": "recetas.3.ingredientes.7", "texto": "加拉姆马萨拉香料 1茶匙" },
  { "ruta": "recetas.3.ingredientes.8", "texto": "酱油 1汤匙" },
  { "ruta": "recetas.3.ingredientes.9", "texto": "蜂蜜 1茶匙" },
  { "ruta": "recetas.3.ingredientes.10", "texto": "鸡高汤 700毫升" },
  { "ruta": "recetas.3.ingredientes.11", "texto": "食用油 1汤匙" },
  { "ruta": "recetas.3.ingredientes.12", "texto": "短粒米(生) 300克" },
  { "ruta": "recetas.3.pasos.0", "texto": "先做咖喱糊:化开黄油,拌入面粉,小火翻炒5分钟至榛子色。加入咖喱粉和加拉姆马萨拉,搅拌1分钟后离火。" },
  { "ruta": "recetas.3.pasos.1", "texto": "锅中倒油,把鸡肉煎上色后盛出。" },
  { "ruta": "recetas.3.pasos.2", "texto": "炒洋葱8分钟至金黄,加入胡萝卜和土豆炒2分钟。" },
  { "ruta": "recetas.3.pasos.3", "texto": "把鸡肉倒回锅中,加高汤没过食材,中火炖20分钟。" },
  { "ruta": "recetas.3.pasos.4", "texto": "用一勺热汤把咖喱糊化开,倒回锅中,继续煮5分钟并不断搅拌,直到浓稠有光泽。" },
  { "ruta": "recetas.3.pasos.5", "texto": "加入酱油和蜂蜜,尝一下咸淡,浇在刚煮好的米饭上即可。" },
  { "ruta": "recetas.4.nombre", "texto": "快手味噌拉面" },
  { "ruta": "recetas.4.carpeta", "texto": "来自日本" },
  { "ruta": "recetas.4.ingredientes.0", "texto": "干拉面面条 200克" },
  { "ruta": "recetas.4.ingredientes.1", "texto": "鸡高汤 900毫升" },
  { "ruta": "recetas.4.ingredientes.2", "texto": "味噌酱 2汤匙" },
  { "ruta": "recetas.4.ingredientes.3", "texto": "酱油 1汤匙" },
  { "ruta": "recetas.4.ingredientes.4", "texto": "芝麻油 1茶匙" },
  { "ruta": "recetas.4.ingredientes.5", "texto": "大蒜(切末) 2瓣" },
  { "ruta": "recetas.4.ingredientes.6", "texto": "姜(擦碎) 10克" },
  { "ruta": "recetas.4.ingredientes.7", "texto": "五花肉或鸡肉(切条) 200克" },
  { "ruta": "recetas.4.ingredientes.8", "texto": "鸡蛋 2个" },
  { "ruta": "recetas.4.ingredientes.9", "texto": "甜玉米粒 100克" },
  { "ruta": "recetas.4.ingredientes.10", "texto": "小葱(切段) 2根" },
  { "ruta": "recetas.4.ingredientes.11", "texto": "海苔 1片" },
  { "ruta": "recetas.4.pasos.0", "texto": "鸡蛋煮6分30秒,放进冰水冷却后剥壳。" },
  { "ruta": "recetas.4.pasos.1", "texto": "锅中倒芝麻油,把五花肉或鸡肉煎上色,加入蒜末和姜末炒1分钟。" },
  { "ruta": "recetas.4.pasos.2", "texto": "倒入高汤,小火煮15分钟后离火。" },
  { "ruta": "recetas.4.pasos.3", "texto": "用一勺高汤把味噌化开,连同酱油一起倒回锅中拌匀。不要再次煮沸。" },
  { "ruta": "recetas.4.pasos.4", "texto": "面条另锅按包装说明煮好,充分沥干。" },
  { "ruta": "recetas.4.pasos.5", "texto": "组装碗中食材:面条、汤、肉、玉米粒、切半的鸡蛋、小葱和海苔。" },
  { "ruta": "recetas.5.nombre", "texto": "咖啡店柜台香蕉面包" },
  { "ruta": "recetas.5.carpeta", "texto": "甜品" },
  { "ruta": "recetas.5.ingredientes.0", "texto": "熟透的香蕉(去皮350克) 3根" },
  { "ruta": "recetas.5.ingredientes.1", "texto": "鸡蛋 2个" },
  { "ruta": "recetas.5.ingredientes.2", "texto": "红糖 80克" },
  { "ruta": "recetas.5.ingredientes.3", "texto": "葵花籽油 60毫升" },
  { "ruta": "recetas.5.ingredientes.4", "texto": "面粉 220克" },
  { "ruta": "recetas.5.ingredientes.5", "texto": "泡打粉 1茶匙" },
  { "ruta": "recetas.5.ingredientes.6", "texto": "小苏打 1/2茶匙" },
  { "ruta": "recetas.5.ingredientes.7", "texto": "肉桂粉 1茶匙" },
  { "ruta": "recetas.5.ingredientes.8", "texto": "盐 1/2茶匙" },
  { "ruta": "recetas.5.ingredientes.9", "texto": "核桃碎 60克" },
  { "ruta": "recetas.5.pasos.0", "texto": "烤箱预热到175°C,给22厘米的吐司模铺上油纸。" },
  { "ruta": "recetas.5.pasos.1", "texto": "用叉子把香蕉压成带小颗粒的泥。" },
  { "ruta": "recetas.5.pasos.2", "texto": "鸡蛋、糖和油打散,拌入香蕉泥。" },
  { "ruta": "recetas.5.pasos.3", "texto": "另取一个碗,混合面粉、泡打粉、小苏打、肉桂粉和盐。" },
  { "ruta": "recetas.5.pasos.4", "texto": "用刮刀把干湿两部分轻轻拌匀,不要过度搅拌,再加入核桃碎。" },
  { "ruta": "recetas.5.pasos.5", "texto": "倒入模具,烤50到55分钟,直到竹签插入取出后是干净的。" },
  { "ruta": "recetas.5.pasos.6", "texto": "脱模后放在架子上晾凉。切成十片,用纸包好能放三天。" },
  { "ruta": "recetas.6.nombre", "texto": "红扁豆浓汤" },
  { "ruta": "recetas.6.ingredientes.0", "texto": "红扁豆 250克" },
  { "ruta": "recetas.6.ingredientes.1", "texto": "洋葱(切碎) 1个" },
  { "ruta": "recetas.6.ingredientes.2", "texto": "胡萝卜(切丁) 2根" },
  { "ruta": "recetas.6.ingredientes.3", "texto": "大蒜 2瓣" },
  { "ruta": "recetas.6.ingredientes.4", "texto": "孜然粉 1茶匙" },
  { "ruta": "recetas.6.ingredientes.5", "texto": "姜黄粉 1茶匙" },
  { "ruta": "recetas.6.ingredientes.6", "texto": "蔬菜高汤 1升" },
  { "ruta": "recetas.6.ingredientes.7", "texto": "橄榄油 2汤匙" },
  { "ruta": "recetas.6.ingredientes.8", "texto": "椰奶 100毫升" },
  { "ruta": "recetas.6.ingredientes.9", "texto": "柠檬 1个" },
  { "ruta": "recetas.6.ingredientes.10", "texto": "盐和胡椒" },
  { "ruta": "recetas.6.pasos.0", "texto": "洋葱和胡萝卜加橄榄油和一小撮盐,炒软8分钟。" },
  { "ruta": "recetas.6.pasos.1", "texto": "加入蒜末、孜然粉和姜黄粉,翻炒1分钟。" },
  { "ruta": "recetas.6.pasos.2", "texto": "扁豆冲洗后加入,倒入高汤,煮沸。" },
  { "ruta": "recetas.6.pasos.3", "texto": "中小火炖20分钟,不时搅拌。" },
  { "ruta": "recetas.6.pasos.4", "texto": "用搅拌机打成顺滑浓汤,拌入椰奶和半个柠檬的汁,调整咸淡。" },
  { "ruta": "recetas.6.pasos.5", "texto": "分装进饭盒;分成单人份冷冻保存效果很好。" },
  { "ruta": "recetas.7.nombre", "texto": "照烧三文鱼配菠菜" },
  { "ruta": "recetas.7.carpeta", "texto": "来自日本" },
  { "ruta": "recetas.7.ingredientes.0", "texto": "三文鱼柳(150克/片) 2片" },
  { "ruta": "recetas.7.ingredientes.1", "texto": "酱油 3汤匙" },
  { "ruta": "recetas.7.ingredientes.2", "texto": "味淋 2汤匙" },
  { "ruta": "recetas.7.ingredientes.3", "texto": "白糖 1汤匙" },
  { "ruta": "recetas.7.ingredientes.4", "texto": "姜(擦碎) 1茶匙" },
  { "ruta": "recetas.7.ingredientes.5", "texto": "玉米淀粉 1茶匙" },
  { "ruta": "recetas.7.ingredientes.6", "texto": "食用油 1汤匙" },
  { "ruta": "recetas.7.ingredientes.7", "texto": "短粒米(生) 150克" },
  { "ruta": "recetas.7.ingredientes.8", "texto": "新鲜菠菜 200克" },
  { "ruta": "recetas.7.ingredientes.9", "texto": "芝麻 1茶匙" },
  { "ruta": "recetas.7.pasos.0", "texto": "按包装说明开始煮米饭。" },
  { "ruta": "recetas.7.pasos.1", "texto": "把酱油、味淋、白糖、姜和玉米淀粉在杯中混合。" },
  { "ruta": "recetas.7.pasos.2", "texto": "把三文鱼擦干,鱼皮朝下放入热油煎锅,煎4分钟。" },
  { "ruta": "recetas.7.pasos.3", "texto": "翻面再煎2分钟,倒入酱汁,煮2分钟至浓稠,用勺子把汁浇在鱼上。" },
  { "ruta": "recetas.7.pasos.4", "texto": "在同一个煎锅的空位炒菠菜2分钟,加一小撮盐,不要碰到三文鱼。" },
  { "ruta": "recetas.7.pasos.5", "texto": "盛在米饭上,淋上酱汁,撒上芝麻。" },
  { "ruta": "recetas.8.nombre", "texto": "烟熏红椒扁豆塔可" },
  { "ruta": "recetas.8.ingredientes.0", "texto": "煮熟沥干的棕色扁豆 400克" },
  { "ruta": "recetas.8.ingredientes.1", "texto": "洋葱(切碎) 1个" },
  { "ruta": "recetas.8.ingredientes.2", "texto": "红甜椒(切丁) 1个" },
  { "ruta": "recetas.8.ingredientes.3", "texto": "大蒜 2瓣" },
  { "ruta": "recetas.8.ingredientes.4", "texto": "孜然粉 1茶匙" },
  { "ruta": "recetas.8.ingredientes.5", "texto": "烟熏红椒粉 1茶匙" },
  { "ruta": "recetas.8.ingredientes.6", "texto": "番茄碎罐头 200克" },
  { "ruta": "recetas.8.ingredientes.7", "texto": "橄榄油 2汤匙" },
  { "ruta": "recetas.8.ingredientes.8", "texto": "玉米饼 8张" },
  { "ruta": "recetas.8.ingredientes.9", "texto": "牛油果 1个" },
  { "ruta": "recetas.8.ingredientes.10", "texto": "青柠 1个" },
  { "ruta": "recetas.8.ingredientes.11", "texto": "新鲜香菜" },
  { "ruta": "recetas.8.ingredientes.12", "texto": "原味酸奶 100克" },
  { "ruta": "recetas.8.ingredientes.13", "texto": "盐" },
  { "ruta": "recetas.8.pasos.0", "texto": "洋葱和红甜椒用橄榄油炒8分钟。" },
  { "ruta": "recetas.8.pasos.1", "texto": "加入大蒜、孜然和烟熏红椒粉,翻炒1分钟。" },
  { "ruta": "recetas.8.pasos.2", "texto": "加入番茄和扁豆,煮10分钟,用勺子稍微压碎让它更浓稠。" },
  { "ruta": "recetas.8.pasos.3", "texto": "调味,加入半个青柠的汁。" },
  { "ruta": "recetas.8.pasos.4", "texto": "把玉米饼在干锅里加热,每面30秒。" },
  { "ruta": "recetas.8.pasos.5", "texto": "填入扁豆、切片的牛油果、酸奶和香菜。每人两个塔可。" },
  { "ruta": "recetas.9.nombre", "texto": "恢复奶昔" },
  { "ruta": "recetas.9.carpeta", "texto": "跑者" },
  { "ruta": "recetas.9.ingredientes.0", "texto": "冷冻香蕉(切片) 1根" },
  { "ruta": "recetas.9.ingredientes.1", "texto": "牛奶 200毫升" },
  { "ruta": "recetas.9.ingredientes.2", "texto": "无糖希腊酸奶 150克" },
  { "ruta": "recetas.9.ingredientes.3", "texto": "冷冻莓果 100克" },
  { "ruta": "recetas.9.ingredientes.4", "texto": "花生酱 1汤匙(16克)" },
  { "ruta": "recetas.9.ingredientes.5", "texto": "纯可可粉 1茶匙" },
  { "ruta": "recetas.9.ingredientes.6", "texto": "盐 少许" },
  { "ruta": "recetas.9.pasos.0", "texto": "所有材料放进搅拌机,液体先放。" },
  { "ruta": "recetas.9.pasos.1", "texto": "打45秒至顺滑;太浓稠的话加一点牛奶稀释。" },
  { "ruta": "recetas.9.pasos.2", "texto": "长跑结束后30分钟内喝完,直接用搅拌机的杯子喝,省得多洗一个杯子。" },
  { "ruta": "dietas.0.nombre", "texto": "马拉松周" },
  { "ruta": "dietas.0.descripcion", "texto": "比赛前的七天。周一到周四照常吃(周日批量做好的鸡肉碗,轻松跑之前吃燕麦);周五到周六提高碳水、降低纤维和脂肪。赛前一晚吃番茄意面,不做任何新尝试。奶昔留到冲线后半小时喝,配上周四烤好的香蕉面包片。" },
  { "ruta": "dietas.0.recetas.0", "texto": "跑者隔夜燕麦" },
  { "ruta": "dietas.0.recetas.1", "texto": "赛前一晚的碳水补充意面" },
  { "ruta": "dietas.0.recetas.2", "texto": "一周分量的鸡肉碗" },
  { "ruta": "dietas.0.recetas.3", "texto": "恢复奶昔" },
  { "ruta": "dietas.0.recetas.4", "texto": "咖啡店柜台香蕉面包" },
  { "ruta": "dietas.1.nombre", "texto": "日本回来后的清淡饮食" },
  { "ruta": "dietas.1.descripcion", "texto": "三周的拉面、便利店食品和炸猪排咖喱让身体变得沉重,冰箱也空了。两周清淡的晚餐,多吃豆类和蔬菜,每周吃一顿像样的鱼,早餐提前一晚准备好,不用在七点上班前手忙脚乱。是对日本的一点致意,但在家做,分量适度。" },
