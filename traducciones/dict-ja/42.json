[
  {
    "clave": "tut.app-entretenimiento--archivo.resumen",
    "es": "El archivo guarda lo que ves, lees y juegas: cada ficha con su estado, sus estrellas y tu reseña. Se agrupa por fecha en carpetas de año y mes, o por género.",
    "en": "The archive keeps what you watch, read and play: each entry with its status, its stars and your review. Group it by date into year and month folders, or by genre."
  },
  {
    "clave": "tut.app-entretenimiento--programas.titulo",
    "es": "Programas para ver",
    "en": "Watchlists"
  },
  {
    "clave": "tut.app-entretenimiento--programas.resumen",
    "es": "Un programa es una lista de títulos por tema o género convertida en metas: palomeas lo que completas y, si quieres, les pones fecha para verlas en el calendario.",
    "en": "A programme is a list of titles by theme or genre turned into goals: tick off what you finish and, if you like, give them dates to see them in the calendar."
  },
  {
    "clave": "tut.app-entretenimiento--juegos.titulo",
    "es": "La mesa digital",
    "en": "The digital table"
  },
  {
    "clave": "tut.app-entretenimiento--juegos.resumen",
    "es": "Más de veinte juegos de mesa y arcade, agrupados por familia y filtrados por número de jugadores: se juegan ahí mismo, sin salir de la casa.",
    "en": "More than twenty board and arcade games, grouped by family and filtered by player count: play them right there, without leaving the home."
  },
  {
    "clave": "tut.app-diario--habito.titulo",
    "es": "El hábito de leer el diario",
    "en": "The newspaper habit"
  },
  {
    "clave": "tut.app-diario--habito.resumen",
    "es": "El periódico es efímero: cada día trae titulares por categoría y efemérides, y a medianoche se renueva. Lo que se guarda es tu constancia — leerlo cuenta como el registro del día.",
    "en": "The paper is ephemeral: every day brings headlines by category and «on this day» facts, and at midnight it is replaced. What is kept is your consistency — reading it counts as the day."
  },
  {
    "clave": "tut.app-diario--reparto.titulo",
    "es": "Que te lo traigan a ti",
    "en": "Have it brought to you"
  },
  {
    "clave": "tut.app-diario--reparto.resumen",
    "es": "Puedes programar qué secciones te entrega cada asistente en su chat: a una hora fija o en un momento sorpresa del día.",
    "en": "You can schedule which sections each assistant delivers in their chat: at a fixed time or at a surprise moment during the day."
  },
