[
  { "ruta": "recetas.0.nombre", "texto": "شوفان منقوع طوال الليل" },
  { "ruta": "recetas.0.carpeta", "texto": "عدّاء" },
  { "ruta": "recetas.0.ingredientes.0", "texto": "60 غ من رقائق الشوفان" },
  { "ruta": "recetas.0.ingredientes.1", "texto": "150 مل من الحليب (أو مشروب الشوفان)" },
  { "ruta": "recetas.0.ingredientes.2", "texto": "100 غ من الزبادي اليوناني السادة" },
  { "ruta": "recetas.0.ingredientes.3", "texto": "ملعقة كبيرة من بذور الشيا (12 غ)" },
  { "ruta": "recetas.0.ingredientes.4", "texto": "موزة ناضجة" },
  { "ruta": "recetas.0.ingredientes.5", "texto": "ملعقة صغيرة من العسل" },
  { "ruta": "recetas.0.ingredientes.6", "texto": "رشة قرفة" },
  { "ruta": "recetas.0.ingredientes.7", "texto": "رشة ملح" },
  { "ruta": "recetas.0.pasos.0", "texto": "امزج الشوفان وبذور الشيا والقرفة والملح في وعاء زجاجي." },
  { "ruta": "recetas.0.pasos.1", "texto": "أضف الحليب والزبادي وحرّك حتى تختفي الكتل الجافة." },
  { "ruta": "recetas.0.pasos.2", "texto": "اهرس نصف الموزة بالشوكة وامزجها؛ احتفظ بالنصف الآخر في الثلاجة." },
  { "ruta": "recetas.0.pasos.3", "texto": "غطِّ الوعاء واتركه في الثلاجة من 6 إلى 10 ساعات." },
  { "ruta": "recetas.0.pasos.4", "texto": "في الصباح، زيّن بباقي الموز مقطعًا شرائح والعسل. تناوله قبل 90 دقيقة من الخروج للجري." },
  { "ruta": "recetas.1.nombre", "texto": "معكرونة تحميل الكربوهيدرات قبل السباق" },
  { "ruta": "recetas.1.carpeta", "texto": "عدّاء" },
  { "ruta": "recetas.1.ingredientes.0", "texto": "200 غ من السباغيتي" },
  { "ruta": "recetas.1.ingredientes.1", "texto": "400 غ من الطماطم المهروسة" },
  { "ruta": "recetas.1.ingredientes.2", "texto": "2 فص ثوم" },
  { "ruta": "recetas.1.ingredientes.3", "texto": "2 ملعقة كبيرة زيت زيتون" },
  { "ruta": "recetas.1.ingredientes.4", "texto": "1 ملعقة صغيرة أوريغانو مجفف" },
  { "ruta": "recetas.1.ingredientes.5", "texto": "1 ملعقة صغيرة سكر" },
  { "ruta": "recetas.1.ingredientes.6", "texto": "40 غ من جبن البارميزان المبشور" },
  { "ruta": "recetas.1.ingredientes.7", "texto": "6 أوراق ريحان طازج" },
  { "ruta": "recetas.1.ingredientes.8", "texto": "ملح" },
  { "ruta": "recetas.1.pasos.0", "texto": "اغلِ ماءً وفيرًا ومملّحًا في قدر كبير." },
  { "ruta": "recetas.1.pasos.1", "texto": "في الأثناء، حمّر الثوم المقطّع شرائح في الزيت على نار متوسطة إلى منخفضة لمدة دقيقتين دون أن يحترق." },
  { "ruta": "recetas.1.pasos.2", "texto": "أضف الطماطم والأوريغانو والسكر ورشة ملح؛ اطبخ 15 دقيقة على نار هادئة." },
  { "ruta": "recetas.1.pasos.3", "texto": "اطبخ المعكرونة لمدة دقيقة أقل مما هو مذكور على العبوة، واحتفظ بنصف كوب من ماء الطبخ." },
  { "ruta": "recetas.1.pasos.4", "texto": "قلّب المعكرونة في الصلصة لمدة دقيقة مع رشة من الماء المحتفظ به." },
  { "ruta": "recetas.1.pasos.5", "texto": "قدّمها مع البارميزان والريحان. عشاء خفيف الدهون وبدون توابل حارة: غدًا السباق." },
  { "ruta": "recetas.2.nombre", "texto": "وعاء الدجاج لأسبوع كامل" },
  { "ruta": "recetas.2.ingredientes.0", "texto": "600 غ من صدر الدجاج" },
  { "ruta": "recetas.2.ingredientes.1", "texto": "300 غ من الأرز البني (نيء)" },
  { "ruta": "recetas.2.ingredientes.2", "texto": "400 غ من البطاطا الحلوة مقطعة مكعبات" },
  { "ruta": "recetas.2.ingredientes.3", "texto": "400 غ من البروكلي مقطع زهيرات" },
  { "ruta": "recetas.2.ingredientes.4", "texto": "3 ملاعق كبيرة زيت زيتون" },
  { "ruta": "recetas.2.ingredientes.5", "texto": "1 ملعقة صغيرة بابريكا حلوة" },
  { "ruta": "recetas.2.ingredientes.6", "texto": "1 ملعقة صغيرة كمون مطحون" },
  { "ruta": "recetas.2.ingredientes.7", "texto": "200 غ من الزبادي اليوناني السادة" },
  { "ruta": "recetas.2.ingredientes.8", "texto": "1 ليمونة" },
  { "ruta": "recetas.2.ingredientes.9", "texto": "ملح وفلفل أسود" },
  { "ruta": "recetas.2.pasos.0", "texto": "سخّن الفرن إلى 200 درجة مئوية." },
  { "ruta": "recetas.2.pasos.1", "texto": "اخلط البطاطا الحلوة مع ملعقة كبيرة من الزيت والملح والفلفل؛ اخبزها 25 دقيقة." },
  { "ruta": "recetas.2.pasos.2", "texto": "تبّل الدجاج بالملح والفلفل، وادهنه بالبابريكا والكمون وملعقة كبيرة من الزيت، واشويه في المقلاة 6 دقائق من كل جانب. اترك الدجاج يرتاح 5 دقائق ثم قطّعه شرائح." },
  { "ruta": "recetas.2.pasos.3", "texto": "اطبخ الأرز البني في ماء مملّح لمدة 25 دقيقة ثم صفّه." },
  { "ruta": "recetas.2.pasos.4", "texto": "اطبخ البروكلي على البخار 5 دقائق فقط: يجب أن يبقى صلبًا ليصمد حتى يوم الخميس." },
  { "ruta": "recetas.2.pasos.5", "texto": "اخفق الزبادي مع عصير نصف ليمونة والملح وملعقة الزيت المتبقية." },
  { "ruta": "recetas.2.pasos.6", "texto": "وزّع كل شيء على أربعة أوعية واحتفظ بالصلصة جانبًا. يبقى صالحًا أربعة أيام في الثلاجة." },
  { "ruta": "recetas.3.nombre", "texto": "كاري ياباني منزلي" },
  { "ruta": "recetas.3.carpeta", "texto": "من اليابان" },
  { "ruta": "recetas.3.ingredientes.0", "texto": "500 غ من فخذ الدجاج مقطعًا مكعبات" },
  { "ruta": "recetas.3.ingredientes.1", "texto": "2 بصلة مقطعة شرائح رفيعة" },
  { "ruta": "recetas.3.ingredientes.2", "texto": "2 جزرة مقطعة شرائح سميكة" },
  { "ruta": "recetas.3.ingredientes.3", "texto": "400 غ من البطاطس مقطعة مكعبات" },
  { "ruta": "recetas.3.ingredientes.4", "texto": "40 غ من الزبدة" },
  { "ruta": "recetas.3.ingredientes.5", "texto": "40 غ من الدقيق" },
  { "ruta": "recetas.3.ingredientes.6", "texto": "2 ملعقة كبيرة بودرة الكاري" },
  { "ruta": "recetas.3.ingredientes.7", "texto": "1 ملعقة صغيرة غارام ماسالا" },
  { "ruta": "recetas.3.ingredientes.8", "texto": "1 ملعقة كبيرة صلصة الصويا" },
  { "ruta": "recetas.3.ingredientes.9", "texto": "1 ملعقة صغيرة عسل" },
  { "ruta": "recetas.3.ingredientes.10", "texto": "700 مل من مرق الدجاج" },
  { "ruta": "recetas.3.ingredientes.11", "texto": "1 ملعقة كبيرة زيت" },
  { "ruta": "recetas.3.ingredientes.12", "texto": "300 غ من الأرز قصير الحبة (نيء)" },
  { "ruta": "recetas.3.pasos.0", "texto": "جهّز قوام الصلصة: أذب الزبدة، ثم أضف الدقيق وحرّك 5 دقائق على نار منخفضة حتى يأخذ لون البندق. أضف الكاري والغارام ماسالا وحرّك دقيقة واحدة، ثم ارفعه عن النار." },
  { "ruta": "recetas.3.pasos.1", "texto": "في قدر، حمّر الدجاج بالزيت ثم أخرجه جانبًا." },
  { "ruta": "recetas.3.pasos.2", "texto": "اطبخ البصل على نار هادئة 8 دقائق حتى يذبل ويصبح ذهبيًا؛ أضف الجزر والبطاطس وقلّبهم دقيقتين." },
  { "ruta": "recetas.3.pasos.3", "texto": "أعد الدجاج إلى القدر، غطّه بالمرق واطبخ 20 دقيقة على نار متوسطة." },
  { "ruta": "recetas.3.pasos.4", "texto": "أذب قوام الصلصة بمغرفة من المرق الساخن ثم اسكبه في القدر. اطبخ 5 دقائق إضافية مع التحريك حتى يتكاثف." },
  { "ruta": "recetas.3.pasos.5", "texto": "أضف صلصة الصويا والعسل، تذوّق واضبط الملح، وقدّمه فوق الأرز المطبوخ حديثًا." },
  { "ruta": "recetas.4.nombre", "texto": "رامن ميسو سريع" },
  { "ruta": "recetas.4.carpeta", "texto": "من اليابان" },
  { "ruta": "recetas.4.ingredientes.0", "texto": "200 غ من نودلز الرامن المجففة" },
  { "ruta": "recetas.4.ingredientes.1", "texto": "900 مل من مرق الدجاج" },
  { "ruta": "recetas.4.ingredientes.2", "texto": "2 ملعقة كبيرة معجون ميسو" },
  { "ruta": "recetas.4.ingredientes.3", "texto": "1 ملعقة كبيرة صلصة الصويا" },
  { "ruta": "recetas.4.ingredientes.4", "texto": "1 ملعقة صغيرة زيت السمسم" },
  { "ruta": "recetas.4.ingredientes.5", "texto": "2 فص ثوم مفروم" },
  { "ruta": "recetas.4.ingredientes.6", "texto": "10 غ من الزنجبيل المبشور" },
  { "ruta": "recetas.4.ingredientes.7", "texto": "200 غ من لحم صدر الخنزير أو الدجاج مقطعًا شرائح" },
  { "ruta": "recetas.4.ingredientes.8", "texto": "2 بيضة" },
  { "ruta": "recetas.4.ingredientes.9", "texto": "100 غ من الذرة الحلوة" },
  { "ruta": "recetas.4.ingredientes.10", "texto": "2 بصلة خضراء مقطعة شرائح" },
  { "ruta": "recetas.4.ingredientes.11", "texto": "1 ورقة نوري" },
  { "ruta": "recetas.4.pasos.0", "texto": "اسلق البيض 6 دقائق و30 ثانية، ثم بردّه في ماء مثلج وقشّره." },
  { "ruta": "recetas.4.pasos.1", "texto": "حمّر لحم الخنزير أو الدجاج في قدر بزيت السمسم؛ أضف الثوم والزنجبيل لمدة دقيقة." },
  { "ruta": "recetas.4.pasos.2", "texto": "أضف المرق واتركه يغلي برفق 15 دقيقة، ثم ارفعه عن النار." },
  { "ruta": "recetas.4.pasos.3", "texto": "أذب الميسو في مغرفة من المرق وأعده إلى القدر مع صلصة الصويا. لا تدعه يغلي مرة أخرى." },
  { "ruta": "recetas.4.pasos.4", "texto": "اطبخ النودلز منفصلة حسب تعليمات العبوة وصفّها جيدًا." },
  { "ruta": "recetas.4.pasos.5", "texto": "جهّز الأطباق: النودلز، المرق، اللحم، الذرة، بيضة مقسومة إلى نصفين، البصل الأخضر والنوري." },
  { "ruta": "recetas.5.nombre", "texto": "كعك الموز على طريقة المقهى" },
  { "ruta": "recetas.5.carpeta", "texto": "حلويات" },
  { "ruta": "recetas.5.ingredientes.0", "texto": "3 موزات ناضجة جدًا (350 غ بعد التقشير)" },
  { "ruta": "recetas.5.ingredientes.1", "texto": "2 بيضة" },
  { "ruta": "recetas.5.ingredientes.2", "texto": "80 غ من السكر البني" },
  { "ruta": "recetas.5.ingredientes.3", "texto": "60 مل من زيت عباد الشمس" },
  { "ruta": "recetas.5.ingredientes.4", "texto": "220 غ من دقيق القمح" },
  { "ruta": "recetas.5.ingredientes.5", "texto": "1 ملعقة صغيرة بيكنغ بودر" },
  { "ruta": "recetas.5.ingredientes.6", "texto": "1/2 ملعقة صغيرة صودا الخبز" },
  { "ruta": "recetas.5.ingredientes.7", "texto": "1 ملعقة صغيرة قرفة" },
  { "ruta": "recetas.5.ingredientes.8", "texto": "1/2 ملعقة صغيرة ملح" },
  { "ruta": "recetas.5.ingredientes.9", "texto": "60 غ من الجوز المفروم" },
  { "ruta": "recetas.5.pasos.0", "texto": "سخّن الفرن إلى 175 درجة مئوية وبطّن قالب كيك مستطيلاً طوله 22 سم بورق الخبز." },
  { "ruta": "recetas.5.pasos.1", "texto": "اهرس الموز بالشوكة حتى يصبح مهروسًا مع بعض القطع." },
  { "ruta": "recetas.5.pasos.2", "texto": "اخفق البيض مع السكر والزيت، ثم أضف هريس الموز." },
  { "ruta": "recetas.5.pasos.3", "texto": "في وعاء آخر، اخلط الدقيق وبيكنغ البودر وصودا الخبز والقرفة والملح." },
  { "ruta": "recetas.5.pasos.4", "texto": "امزج المكونات الجافة مع الرطبة بملعقة مطاطية دون الإفراط في الخلط، وأضف الجوز." },
  { "ruta": "recetas.5.pasos.5", "texto": "اسكب الخليط في القالب واخبزه 50-55 دقيقة، حتى يخرج عود الأسنان نظيفًا." },
  { "ruta": "recetas.5.pasos.6", "texto": "أخرج الكعكة من القالب ودعها تبرد على شبكة. مقطعة إلى عشر شرائح، تدوم ثلاثة أيام ملفوفة بالورق." },
  { "ruta": "recetas.6.nombre", "texto": "شوربة كريمية بالعدس الأحمر" },
  { "ruta": "recetas.6.ingredientes.0", "texto": "250 غ من العدس الأحمر" },
  { "ruta": "recetas.6.ingredientes.1", "texto": "1 بصلة مفرومة" },
  { "ruta": "recetas.6.ingredientes.2", "texto": "2 جزرة مقطعة مكعبات" },
  { "ruta": "recetas.6.ingredientes.3", "texto": "2 فص ثوم" },
  { "ruta": "recetas.6.ingredientes.4", "texto": "1 ملعقة صغيرة كمون مطحون" },
  { "ruta": "recetas.6.ingredientes.5", "texto": "1 ملعقة صغيرة كركم" },
  { "ruta": "recetas.6.ingredientes.6", "texto": "1 لتر من مرق الخضار" },
  { "ruta": "recetas.6.ingredientes.7", "texto": "2 ملعقة كبيرة زيت زيتون" },
  { "ruta": "recetas.6.ingredientes.8", "texto": "100 مل من حليب جوز الهند" },
  { "ruta": "recetas.6.ingredientes.9", "texto": "1 ليمونة" },
  { "ruta": "recetas.6.ingredientes.10", "texto": "ملح وفلفل أسود" },
  { "ruta": "recetas.6.pasos.0", "texto": "اطبخ البصل والجزر في الزيت 8 دقائق مع رشة ملح." },
  { "ruta": "recetas.6.pasos.1", "texto": "أضف الثوم المفروم والكمون والكركم وحرّك دقيقة واحدة." },
  { "ruta": "recetas.6.pasos.2", "texto": "اشطف العدس، أضفه مع المرق واتركه يغلي." },
  { "ruta": "recetas.6.pasos.3", "texto": "اطبخ 20 دقيقة على نار متوسطة إلى منخفضة، مع التحريك بين الحين والآخر." },
  { "ruta": "recetas.6.pasos.4", "texto": "اهرسها بالخلاط، أضف حليب جوز الهند وعصير نصف ليمونة، واضبط الملح." },
  { "ruta": "recetas.6.pasos.5", "texto": "وزّعها في أوعية حفظ؛ تتجمد جيدًا في حصص فردية." },
  { "ruta": "recetas.7.nombre", "texto": "سلمون تيرياكي مع السبانخ" },
  { "ruta": "recetas.7.carpeta", "texto": "من اليابان" },
  { "ruta": "recetas.7.ingredientes.0", "texto": "2 فيليه سلمون، 150 غ لكل قطعة" },
  { "ruta": "recetas.7.ingredientes.1", "texto": "3 ملاعق كبيرة صلصة الصويا" },
  { "ruta": "recetas.7.ingredientes.2", "texto": "2 ملعقة كبيرة ميرين" },
  { "ruta": "recetas.7.ingredientes.3", "texto": "1 ملعقة كبيرة سكر" },
  { "ruta": "recetas.7.ingredientes.4", "texto": "1 ملعقة صغيرة زنجبيل مبشور" },
  { "ruta": "recetas.7.ingredientes.5", "texto": "1 ملعقة صغيرة نشا الذرة" },
  { "ruta": "recetas.7.ingredientes.6", "texto": "1 ملعقة كبيرة زيت" },
  { "ruta": "recetas.7.ingredientes.7", "texto": "150 غ من الأرز قصير الحبة (نيء)" },
  { "ruta": "recetas.7.ingredientes.8", "texto": "200 غ من السبانخ الطازج" },
  { "ruta": "recetas.7.ingredientes.9", "texto": "1 ملعقة صغيرة بذور السمسم" },
  { "ruta": "recetas.7.pasos.0", "texto": "ابدأ بطهي الأرز حسب تعليمات العبوة." },
  { "ruta": "recetas.7.pasos.1", "texto": "اخلط صلصة الصويا والميرين والسكر والزنجبيل ونشا الذرة في كوب." },
  { "ruta": "recetas.7.pasos.2", "texto": "جفّف السلمون جيدًا واقليه من جهة الجلد في المقلاة بالزيت لمدة 4 دقائق." },
  { "ruta": "recetas.7.pasos.3", "texto": "اقلبه، اطبخه دقيقتين إضافيتين، ثم اسكب الصلصة؛ اطبخ دقيقتين حتى تتكاثف وأنت تغرف الصلصة فوق السمك." },
  { "ruta": "recetas.7.pasos.4", "texto": "قلّب السبانخ دقيقتين في المقلاة نفسها، بجانب السلمون، مع رشة ملح." },
  { "ruta": "recetas.7.pasos.5", "texto": "قدّمه فوق الأرز مع الصلصة فوقه وبذور السمسم." },
  { "ruta": "recetas.8.nombre", "texto": "تاكو العدس بالبابريكا المدخنة" },
  { "ruta": "recetas.8.ingredientes.0", "texto": "400 غ من العدس البني المطبوخ والمصفى" },
  { "ruta": "recetas.8.ingredientes.1", "texto": "1 بصلة مفرومة" },
  { "ruta": "recetas.8.ingredientes.2", "texto": "1 فلفل أحمر حلو مقطع مكعبات" },
  { "ruta": "recetas.8.ingredientes.3", "texto": "2 فص ثوم" },
  { "ruta": "recetas.8.ingredientes.4", "texto": "1 ملعقة صغيرة كمون" },
