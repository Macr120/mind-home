    "texto": "Dari Jepang"
  },
  {
    "ruta": "recetas.3.ingredientes.0",
    "texto": "500 g daging paha ayam, potong dadu"
  },
  {
    "ruta": "recetas.3.ingredientes.1",
    "texto": "2 bawang bombay, iris tipis"
  },
  {
    "ruta": "recetas.3.ingredientes.2",
    "texto": "2 wortel, iris tebal"
  },
  {
    "ruta": "recetas.3.ingredientes.3",
    "texto": "400 g kentang potong dadu"
  },
  {
    "ruta": "recetas.3.ingredientes.4",
    "texto": "40 g mentega"
  },
  {
    "ruta": "recetas.3.ingredientes.5",
    "texto": "40 g tepung terigu"
  },
  {
    "ruta": "recetas.3.ingredientes.6",
    "texto": "2 sdm bubuk kari"
  },
  {
    "ruta": "recetas.3.ingredientes.7",
    "texto": "1 sdt garam masala"
  },
  {
    "ruta": "recetas.3.ingredientes.8",
    "texto": "1 sdm kecap asin"
  },
  {
    "ruta": "recetas.3.ingredientes.9",
    "texto": "1 sdt madu"
  },
  {
    "ruta": "recetas.3.ingredientes.10",
    "texto": "700 ml kaldu ayam"
  },
  {
    "ruta": "recetas.3.ingredientes.11",
    "texto": "1 sdm minyak"
  },
  {
    "ruta": "recetas.3.ingredientes.12",
    "texto": "300 g beras butir pendek (mentah)"
  },
  {
    "ruta": "recetas.3.pasos.0",
    "texto": "Buat roux: lelehkan mentega, tambahkan tepung, dan aduk dengan api kecil selama 5 menit sampai berwarna cokelat hazelnut. Tambahkan bubuk kari dan garam masala, aduk 1 menit, lalu angkat dari api."
  },
  {
    "ruta": "recetas.3.pasos.1",
    "texto": "Dalam panci, goreng ayam dengan minyak sampai kecokelatan, lalu angkat."
  },
  {
    "ruta": "recetas.3.pasos.2",
    "texto": "Tumis bawang bombay 8 menit sampai keemasan; tambahkan wortel dan kentang, tumis 2 menit lagi."
  },
  {
    "ruta": "recetas.3.pasos.3",
    "texto": "Masukkan kembali ayam, tuang kaldu hingga terendam, dan masak dengan api sedang selama 20 menit."
  },
  {
    "ruta": "recetas.3.pasos.4",
    "texto": "Larutkan roux dengan sesendok kaldu panas, lalu tuang ke dalam panci. Masak 5 menit lagi sambil diaduk sampai mengental."
  },
  {
    "ruta": "recetas.3.pasos.5",
    "texto": "Tambahkan kecap asin dan madu, cicipi rasa garamnya, dan sajikan di atas nasi yang baru matang."
  },
  {
