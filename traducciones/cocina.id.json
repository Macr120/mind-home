  {
    "ruta": "recetas.0.ingredientes.7",
    "texto": "1 sejumput garam"
  },
  {
    "ruta": "recetas.0.pasos.0",
    "texto": "Campur oat, biji chia, kayu manis, dan garam dalam toples kaca."
  },
  {
    "ruta": "recetas.0.pasos.1",
    "texto": "Tambahkan susu dan yogurt, aduk sampai tidak ada gumpalan kering."
  },
  {
    "ruta": "recetas.0.pasos.2",
    "texto": "Haluskan setengah pisang dengan garpu lalu campurkan; simpan setengah lagi di kulkas."
  },
  {
    "ruta": "recetas.0.pasos.3",
    "texto": "Tutup dan simpan di kulkas selama 6-10 jam."
  },
  {
    "ruta": "recetas.0.pasos.4",
    "texto": "Paginya, taburi dengan sisa pisang yang diiris dan madu. Makan 90 menit sebelum lari."
  },
  {
