  {
    "ruta": "recetas.2.pasos.0",
    "texto": "Panaskan oven hingga 200 °C."
  },
  {
    "ruta": "recetas.2.pasos.1",
    "texto": "Campur ubi jalar dengan 1 sdm minyak, garam, dan lada; panggang 25 menit."
  },
  {
    "ruta": "recetas.2.pasos.2",
    "texto": "Bumbui ayam dengan garam dan lada, lumuri dengan paprika, jintan, dan 1 sdm minyak, lalu panggang di wajan datar 6 menit tiap sisi. Diamkan 5 menit lalu potong memanjang."
  },
  {
    "ruta": "recetas.2.pasos.3",
    "texto": "Rebus beras merah dalam air garam selama 25 menit, lalu tiriskan."
  },
  {
    "ruta": "recetas.2.pasos.4",
    "texto": "Kukus brokoli selama 5 menit saja: harus tetap renyah agar masih enak sampai hari Kamis."
  },
  {
    "ruta": "recetas.2.pasos.5",
    "texto": "Kocok yogurt dengan perasan setengah lemon, garam, dan sisa 1 sdm minyak."
  },
  {
    "ruta": "recetas.2.pasos.6",
    "texto": "Bagi semua ke empat wadah, simpan sausnya terpisah. Tahan empat hari di kulkas."
  },
  {
    "ruta": "recetas.3.nombre",
    "texto": "Kari Jepang buatan rumah"
  },
