  {
    "ruta": "recetas.2.ingredientes.2",
    "texto": "400 g ubi jalar potong dadu"
  },
  {
    "ruta": "recetas.2.ingredientes.3",
    "texto": "400 g brokoli, dipotong per kuntum"
  },
  {
    "ruta": "recetas.2.ingredientes.4",
    "texto": "3 sdm minyak zaitun"
  },
  {
    "ruta": "recetas.2.ingredientes.5",
    "texto": "1 sdt paprika bubuk manis"
  },
  {
    "ruta": "recetas.2.ingredientes.6",
    "texto": "1 sdt jintan bubuk"
  },
  {
    "ruta": "recetas.2.ingredientes.7",
