[
 {
  "clave": "corazon.gato.noche.1",
  "texto": "Тихая ночь. Не порти её 🐾"
 },
 {
  "clave": "corazon.gato.rutina.0",
  "texto": "Эй, «{r}» в {h}. Я не двигаюсь 🐾"
 },
 {
  "clave": "corazon.gato.rutina.1",
  "texto": "«{r}» уже скоро ({h}). Ты справишься; я прослежу 🐱"
 },
 {
  "clave": "corazon.gato.generica.0",
  "texto": "Всё под контролем. Проверил, пока дремал 🐾"
 },
 {
  "clave": "corazon.gato.generica.1",
  "texto": "Хм. Дом всё ещё стоит. Не за что 🐱"
 },
 {
  "clave": "corazon.perro.manana.0",
  "texto": "Доброе утро! Сегодня пахнет отличным днём! 🐶"
 },
 {
  "clave": "corazon.perro.manana.1",
  "texto": "Уже утро! Вперёд-вперёд-вперёд! 🦴"
 },
 {
  "clave": "corazon.perro.tarde.0",
  "texto": "Идеальный день, чтобы всё успеть! Гав! 🐶"
 },
 {
  "clave": "corazon.perro.tarde.1",
  "texto": "Всё ещё здесь, слежу за всем! 🎉"
 },
 {
  "clave": "corazon.perro.noche.0",
  "texto": "Какой отличный был день! Правда? Правда? 🐶"
 },
 {
  "clave": "corazon.perro.noche.1",
  "texto": "Тихая ночь… Я на страже! 🦴"
 },
 {
  "clave": "corazon.perro.rutina.0",
  "texto": "«{r}» в {h}! Ты справишься! 🎉"
 },
 {
  "clave": "corazon.perro.rutina.1",
  "texto": "Не забудь про «{r}» в {h}! Гав! 🐶"
 },
 {
  "clave": "corazon.perro.generica.0",
  "texto": "Обожаю этот дом! 🐶"
 },
 {
  "clave": "corazon.perro.generica.1",
  "texto": "Зови, если что-то понадобится! Что угодно! 🦴"
 },
 {
  "clave": "corazon.buho.manana.0",
  "texto": "Рассвет. Идеальное время, чтобы спокойно спланировать день. 🦉"
 },
 {
  "clave": "corazon.buho.manana.1",
  "texto": "Упорядоченное утро приносит двойную пользу."
 },
 {
  "clave": "corazon.buho.tarde.0",
  "texto": "Полдень: хороший момент, чтобы оценить прогресс. 🦉"
 },
 {
  "clave": "corazon.buho.tarde.1",
  "texto": "Вторая половина дня проходит по плану."
 },
 {
  "clave": "corazon.buho.noche.0",
  "texto": "Наступает ночь. Предлагаю закрыть день короткой записью. 🦉"
 },
 {
  "clave": "corazon.buho.noche.1",
  "texto": "Ночь располагает к размышлениям."
 },
 {
  "clave": "corazon.buho.rutina.0",
  "texto": "Своевременное напоминание: «{r}» в {h}. 🦉"
 },
 {
  "clave": "corazon.buho.rutina.1",
  "texto": "В твоём расписании указано «{r}» в {h}."
 },
 {
  "clave": "corazon.buho.generica.0",
  "texto": "Наблюдаю и делаю пометки. Всё в порядке. 🦉"
 },
 {
  "clave": "corazon.buho.generica.1",
  "texto": "Знание накапливается день за днём."
 },
 {
  "clave": "corazon.robot.manana.0",
  "texto": "☀ ДНЕВНОЙ ЦИКЛ ЗАПУЩЕН. СИСТЕМЫ НА 100%. 🤖"
 },
 {
  "clave": "corazon.robot.manana.1",
  "texto": "ДОБРОЕ УТРО. БАТАРЕЯ ЗАРЯЖЕНА ПОЛНОСТЬЮ. ✓"
 },
 {
  "clave": "corazon.robot.tarde.0",
  "texto": "ДНЕВНОЕ СКАНИРОВАНИЕ ЗАВЕРШЕНО. АНОМАЛИЙ НЕТ. ✓"
 },
 {
  "clave": "corazon.robot.tarde.1",
  "texto": "ПРОДУКТИВНОСТЬ В ПРЕДЕЛАХ НОРМЫ. 🤖"
 },
 {
  "clave": "corazon.robot.noche.0",
  "texto": "НОЧНОЙ РЕЖИМ АКТИВЕН. ДЕЖУРСТВО ПРОДОЛЖАЕТСЯ. 🤖"
 },
 {
  "clave": "corazon.robot.noche.1",
  "texto": "РЕКОМЕНДАЦИЯ: ПЕРЕЗАРЯДИТЬ ЧЕЛОВЕЧЕСКИЙ БЛОК (СОН). ✓"
 },
 {
  "clave": "corazon.robot.rutina.0",
  "texto": "НАПОМИНАНИЕ: «{r}» ЗАПЛАНИРОВАНО НА {h}. ✓"
 },
 {
  "clave": "corazon.robot.rutina.1",
  "texto": "ВНИМАНИЕ: «{r}» В {h}. 🤖"
 },
 {
  "clave": "corazon.robot.generica.0",
  "texto": "ВСЕ СИСТЕМЫ В НОРМЕ. 🤖"
 },
 {
  "clave": "corazon.robot.generica.1",
  "texto": "ОЖИДАНИЕ ИНСТРУКЦИЙ. НЕ СРОЧНО. ✓"
 },
