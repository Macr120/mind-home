[
  { "ruta": "recetas.0.nombre", "texto": "러너의 오버나이트 오트밀" },
  { "ruta": "recetas.0.carpeta", "texto": "러너" },
  { "ruta": "recetas.0.ingredientes.0", "texto": "귀리 60g" },
  { "ruta": "recetas.0.ingredientes.1", "texto": "우유 150ml(또는 귀리 음료)" },
  { "ruta": "recetas.0.ingredientes.2", "texto": "플레인 그릭 요거트 100g" },
  { "ruta": "recetas.0.ingredientes.3", "texto": "치아씨드 1큰술(12g)" },
  { "ruta": "recetas.0.ingredientes.4", "texto": "잘 익은 바나나 1개" },
  { "ruta": "recetas.0.ingredientes.5", "texto": "꿀 1작은술" },
  { "ruta": "recetas.0.ingredientes.6", "texto": "시나몬 한 꼬집" },
  { "ruta": "recetas.0.ingredientes.7", "texto": "소금 한 꼬집" },
  { "ruta": "recetas.0.pasos.0", "texto": "유리병에 귀리, 치아씨드, 시나몬, 소금을 넣고 섞어요." },
  { "ruta": "recetas.0.pasos.1", "texto": "우유와 요거트를 넣고 마른 덩어리가 없을 때까지 섞어요." },
  { "ruta": "recetas.0.pasos.2", "texto": "바나나 반 개를 포크로 으깨서 섞고, 나머지 반 개는 냉장고에 보관해요." },
  { "ruta": "recetas.0.pasos.3", "texto": "뚜껑을 덮고 냉장고에서 6~10시간 둬요." },
  { "ruta": "recetas.0.pasos.4", "texto": "다음 날 아침, 남은 바나나를 슬라이스해서 올리고 꿀을 뿌려요. 달리기 나가기 90분 전에 먹어요." },
  { "ruta": "recetas.1.nombre", "texto": "경기 전날 밤의 탄수화물 충전 파스타" },
  { "ruta": "recetas.1.carpeta", "texto": "러너" },
  { "ruta": "recetas.1.ingredientes.0", "texto": "스파게티 200g" },
  { "ruta": "recetas.1.ingredientes.1", "texto": "다진 토마토 통조림 400g" },
  { "ruta": "recetas.1.ingredientes.2", "texto": "마늘 2쪽" },
  { "ruta": "recetas.1.ingredientes.3", "texto": "올리브오일 2큰술" },
  { "ruta": "recetas.1.ingredientes.4", "texto": "말린 오레가노 1작은술" },
  { "ruta": "recetas.1.ingredientes.5", "texto": "설탕 1작은술" },
  { "ruta": "recetas.1.ingredientes.6", "texto": "파르메산 치즈(간 것) 40g" },
  { "ruta": "recetas.1.ingredientes.7", "texto": "신선한 바질 잎 6장" },
  { "ruta": "recetas.1.ingredientes.8", "texto": "소금" },
  { "ruta": "recetas.1.pasos.0", "texto": "큰 냄비에 물을 넉넉히 붓고 소금을 넣어 끓여요." },
  { "ruta": "recetas.1.pasos.1", "texto": "그동안 마늘을 얇게 썰어 오일에 넣고 중약불에서 2분간 타지 않게 색을 내요." },
  { "ruta": "recetas.1.pasos.2", "texto": "토마토, 오레가노, 설탕, 소금 한 꼬집을 넣고 약불로 15분 끓여요." },
  { "ruta": "recetas.1.pasos.3", "texto": "파스타는 봉지 표시 시간보다 1분 짧게 삶고, 삶은 물은 반 컵 정도 남겨둬요." },
  { "ruta": "recetas.1.pasos.4", "texto": "소스에 파스타를 넣고 남겨둔 삶은 물을 조금 부어 1분간 볶아요." },
  { "ruta": "recetas.1.pasos.5", "texto": "파르메산 치즈와 바질을 올려 내요. 기름기 적고 맵지 않은 가벼운 저녁 식사예요. 내일은 경기가 있으니까요." },
  { "ruta": "recetas.2.nombre", "texto": "일주일치 닭가슴살 볼" },
  { "ruta": "recetas.2.ingredientes.0", "texto": "닭가슴살 600g" },
  { "ruta": "recetas.2.ingredientes.1", "texto": "현미(생것) 300g" },
  { "ruta": "recetas.2.ingredientes.2", "texto": "고구마(깍둑썰기) 400g" },
  { "ruta": "recetas.2.ingredientes.3", "texto": "브로콜리(송이) 400g" },
  { "ruta": "recetas.2.ingredientes.4", "texto": "올리브오일 3큰술" },
  { "ruta": "recetas.2.ingredientes.5", "texto": "달콤한 파프리카 가루 1작은술" },
  { "ruta": "recetas.2.ingredientes.6", "texto": "커민 가루 1작은술" },
  { "ruta": "recetas.2.ingredientes.7", "texto": "플레인 그릭 요거트 200g" },
  { "ruta": "recetas.2.ingredientes.8", "texto": "레몬 1개" },
  { "ruta": "recetas.2.ingredientes.9", "texto": "소금과 후추" },
  { "ruta": "recetas.2.pasos.0", "texto": "오븐을 200°C로 예열해요." },
  { "ruta": "recetas.2.pasos.1", "texto": "고구마에 올리브오일 1큰술, 소금, 후추를 버무려 25분간 구워요." },
  { "ruta": "recetas.2.pasos.2", "texto": "닭가슴살에 소금 후추를 뿌리고 파프리카 가루, 커민, 올리브오일 1큰술을 발라 팬에서 한 면당 6분씩 구워요. 5분간 휴지시킨 뒤 얇게 썰어요." },
  { "ruta": "recetas.2.pasos.3", "texto": "현미는 소금물에 25분간 삶아 물기를 빼요." },
  { "ruta": "recetas.2.pasos.4", "texto": "브로콜리는 5분만 쪄요. 목요일까지 먹으려면 아삭한 식감이 남아 있어야 해요." },
  { "ruta": "recetas.2.pasos.5", "texto": "요거트에 레몬 반 개 즙, 소금, 남은 올리브오일 1큰술을 섞어요." },
  { "ruta": "recetas.2.pasos.6", "texto": "네 개의 용기에 나눠 담고 소스는 따로 담아요. 냉장고에서 나흘간 보관돼요." },
  { "ruta": "recetas.3.nombre", "texto": "집에서 만드는 일본식 카레" },
  { "ruta": "recetas.3.carpeta", "texto": "일본에서" },
  { "ruta": "recetas.3.ingredientes.0", "texto": "닭 넓적다리살(깍둑썰기) 500g" },
  { "ruta": "recetas.3.ingredientes.1", "texto": "양파(채썰기) 2개" },
  { "ruta": "recetas.3.ingredientes.2", "texto": "당근(두껍게 썰기) 2개" },
  { "ruta": "recetas.3.ingredientes.3", "texto": "감자(깍둑썰기) 400g" },
  { "ruta": "recetas.3.ingredientes.4", "texto": "버터 40g" },
  { "ruta": "recetas.3.ingredientes.5", "texto": "밀가루 40g" },
  { "ruta": "recetas.3.ingredientes.6", "texto": "카레 가루 2큰술" },
  { "ruta": "recetas.3.ingredientes.7", "texto": "가람 마살라 1작은술" },
  { "ruta": "recetas.3.ingredientes.8", "texto": "간장 1큰술" },
  { "ruta": "recetas.3.ingredientes.9", "texto": "꿀 1작은술" },
  { "ruta": "recetas.3.ingredientes.10", "texto": "닭육수 700ml" },
  { "ruta": "recetas.3.ingredientes.11", "texto": "식용유 1큰술" },
  { "ruta": "recetas.3.ingredientes.12", "texto": "단립종 쌀(생것) 300g" },
  { "ruta": "recetas.3.pasos.0", "texto": "루를 만들어요: 버터를 녹이고 밀가루를 넣어 약불에서 5분간 헤이즐넛 색이 될 때까지 저어요. 카레 가루와 가람 마살라를 넣고 1분간 저은 뒤 불에서 내려요." },
  { "ruta": "recetas.3.pasos.1", "texto": "냄비에 기름을 두르고 닭고기를 노릇하게 볶아 꺼내둬요." },
  { "ruta": "recetas.3.pasos.2", "texto": "양파를 8분간 볶아 노릇하게 만들고, 당근과 감자를 넣어 2분간 더 볶아요." },
  { "ruta": "recetas.3.pasos.3", "texto": "닭고기를 다시 넣고 육수를 부어 중불에서 20분간 끓여요." },
  { "ruta": "recetas.3.pasos.4", "texto": "루를 뜨거운 육수 한 국자로 풀어 냄비에 넣어요. 걸쭉해질 때까지 저으면서 5분 더 끓여요." },
  { "ruta": "recetas.3.pasos.5", "texto": "간장과 꿀을 넣고 간을 맞춘 뒤, 갓 지은 밥 위에 올려 내요." },
  { "ruta": "recetas.4.nombre", "texto": "초간단 미소 라멘" },
  { "ruta": "recetas.4.carpeta", "texto": "일본에서" },
  { "ruta": "recetas.4.ingredientes.0", "texto": "건면 라멘 200g" },
  { "ruta": "recetas.4.ingredientes.1", "texto": "닭육수 900ml" },
  { "ruta": "recetas.4.ingredientes.2", "texto": "미소 된장 2큰술" },
  { "ruta": "recetas.4.ingredientes.3", "texto": "간장 1큰술" },
  { "ruta": "recetas.4.ingredientes.4", "texto": "참기름 1작은술" },
  { "ruta": "recetas.4.ingredientes.5", "texto": "다진 마늘 2쪽" },
  { "ruta": "recetas.4.ingredientes.6", "texto": "간 생강 10g" },
  { "ruta": "recetas.4.ingredientes.7", "texto": "삼겹살 또는 닭고기(채썰기) 200g" },
  { "ruta": "recetas.4.ingredientes.8", "texto": "달걀 2개" },
  { "ruta": "recetas.4.ingredientes.9", "texto": "옥수수콘 100g" },
  { "ruta": "recetas.4.ingredientes.10", "texto": "쪽파(썰기) 2대" },
  { "ruta": "recetas.4.ingredientes.11", "texto": "김 1장" },
  { "ruta": "recetas.4.pasos.0", "texto": "달걀을 6분 30초 삶아 얼음물에 식힌 뒤 껍질을 벗겨요." },
  { "ruta": "recetas.4.pasos.1", "texto": "냄비에 참기름을 두르고 삼겹살 또는 닭고기를 노릇하게 볶은 뒤, 마늘과 생강을 넣어 1분간 볶아요." },
  { "ruta": "recetas.4.pasos.2", "texto": "육수를 붓고 약불로 15분간 끓인 뒤 불에서 내려요." },
  { "ruta": "recetas.4.pasos.3", "texto": "미소 된장을 국물 한 국자로 풀어 간장과 함께 다시 넣어요. 다시 끓이지 않도록 해요." },
  { "ruta": "recetas.4.pasos.4", "texto": "면은 따로 봉지 설명대로 삶아 물기를 잘 빼요." },
  { "ruta": "recetas.4.pasos.5", "texto": "그릇에 담아요: 면, 육수, 고기, 옥수수콘, 반으로 자른 달걀, 쪽파, 김." },
  { "ruta": "recetas.5.nombre", "texto": "카페 카운터 바나나 브레드" },
  { "ruta": "recetas.5.carpeta", "texto": "디저트" },
  { "ruta": "recetas.5.ingredientes.0", "texto": "잘 익은 바나나(껍질 벗긴 것 350g) 3개" },
  { "ruta": "recetas.5.ingredientes.1", "texto": "달걀 2개" },
  { "ruta": "recetas.5.ingredientes.2", "texto": "황설탕 80g" },
  { "ruta": "recetas.5.ingredientes.3", "texto": "해바라기씨유 60ml" },
  { "ruta": "recetas.5.ingredientes.4", "texto": "밀가루 220g" },
  { "ruta": "recetas.5.ingredientes.5", "texto": "베이킹파우더 1작은술" },
  { "ruta": "recetas.5.ingredientes.6", "texto": "베이킹소다 1/2작은술" },
  { "ruta": "recetas.5.ingredientes.7", "texto": "시나몬 1작은술" },
  { "ruta": "recetas.5.ingredientes.8", "texto": "소금 1/2작은술" },
  { "ruta": "recetas.5.ingredientes.9", "texto": "다진 호두 60g" },
  { "ruta": "recetas.5.pasos.0", "texto": "오븐을 175°C로 예열하고 22cm 파운드케이크 틀에 유산지를 깔아요." },
  { "ruta": "recetas.5.pasos.1", "texto": "바나나를 포크로 으깨 약간 덩어리가 남게 만들어요." },
  { "ruta": "recetas.5.pasos.2", "texto": "달걀에 설탕과 기름을 넣고 섞은 뒤 바나나를 넣어요." },
  { "ruta": "recetas.5.pasos.3", "texto": "다른 볼에 밀가루, 베이킹파우더, 베이킹소다, 시나몬, 소금을 섞어요." },
  { "ruta": "recetas.5.pasos.4", "texto": "주걱으로 마른 재료와 젖은 재료를 과하게 섞지 않게 합치고 호두를 넣어요." },
  { "ruta": "recetas.5.pasos.5", "texto": "틀에 부어 50~55분간 구워요. 꼬치로 찔러봐서 깨끗하게 나오면 완성이에요." },
  { "ruta": "recetas.5.pasos.6", "texto": "틀에서 꺼내 식힘망 위에서 식혀요. 열 조각으로 잘라 종이에 싸면 3일간 보관돼요." },
  { "ruta": "recetas.6.nombre", "texto": "붉은 렌틸콩 수프" },
  { "ruta": "recetas.6.ingredientes.0", "texto": "붉은 렌틸콩 250g" },
  { "ruta": "recetas.6.ingredientes.1", "texto": "양파(다지기) 1개" },
  { "ruta": "recetas.6.ingredientes.2", "texto": "당근(깍둑썰기) 2개" },
  { "ruta": "recetas.6.ingredientes.3", "texto": "마늘 2쪽" },
  { "ruta": "recetas.6.ingredientes.4", "texto": "커민 가루 1작은술" },
  { "ruta": "recetas.6.ingredientes.5", "texto": "강황 가루 1작은술" },
  { "ruta": "recetas.6.ingredientes.6", "texto": "채소육수 1리터" },
  { "ruta": "recetas.6.ingredientes.7", "texto": "올리브오일 2큰술" },
  { "ruta": "recetas.6.ingredientes.8", "texto": "코코넛밀크 100ml" },
  { "ruta": "recetas.6.ingredientes.9", "texto": "레몬 1개" },
  { "ruta": "recetas.6.ingredientes.10", "texto": "소금과 후추" },
  { "ruta": "recetas.6.pasos.0", "texto": "양파와 당근을 오일에 소금 한 꼬집과 함께 8분간 볶아 부드럽게 해요." },
  { "ruta": "recetas.6.pasos.1", "texto": "다진 마늘, 커민, 강황을 넣고 1분간 볶아요." },
  { "ruta": "recetas.6.pasos.2", "texto": "렌틸콩을 헹궈 육수와 함께 넣고 끓여요." },
  { "ruta": "recetas.6.pasos.3", "texto": "중약불에서 20분간, 가끔 저으면서 끓여요." },
  { "ruta": "recetas.6.pasos.4", "texto": "믹서로 곱게 갈고 코코넛밀크와 레몬 반 개 즙을 넣어 간을 맞춰요." },
  { "ruta": "recetas.6.pasos.5", "texto": "용기에 나눠 담아요. 1인분씩 나누면 냉동 보관이 잘 돼요." },
  { "ruta": "recetas.7.nombre", "texto": "시금치 곁들인 데리야키 연어" },
  { "ruta": "recetas.7.carpeta", "texto": "일본에서" },
  { "ruta": "recetas.7.ingredientes.0", "texto": "연어살(150g) 2조각" },
  { "ruta": "recetas.7.ingredientes.1", "texto": "간장 3큰술" },
  { "ruta": "recetas.7.ingredientes.2", "texto": "미림 2큰술" },
  { "ruta": "recetas.7.ingredientes.3", "texto": "설탕 1큰술" },
  { "ruta": "recetas.7.ingredientes.4", "texto": "간 생강 1작은술" },
  { "ruta": "recetas.7.ingredientes.5", "texto": "전분 1작은술" },
  { "ruta": "recetas.7.ingredientes.6", "texto": "식용유 1큰술" },
  { "ruta": "recetas.7.ingredientes.7", "texto": "단립종 쌀(생것) 150g" },
  { "ruta": "recetas.7.ingredientes.8", "texto": "신선한 시금치 200g" },
  { "ruta": "recetas.7.ingredientes.9", "texto": "참깨 1작은술" },
  { "ruta": "recetas.7.pasos.0", "texto": "봉지 설명대로 밥을 짓기 시작해요." },
  { "ruta": "recetas.7.pasos.1", "texto": "간장, 미림, 설탕, 생강, 전분을 컵에 섞어요." },
  { "ruta": "recetas.7.pasos.2", "texto": "연어를 물기 없이 닦고 껍질 쪽부터 기름 두른 팬에 4분간 구워요." },
  { "ruta": "recetas.7.pasos.3", "texto": "뒤집어서 2분 더 굽고 소스를 부어요. 걸쭉해질 때까지 2분간 끓이며 숟가락으로 생선에 끼얹어요." },
  { "ruta": "recetas.7.pasos.4", "texto": "같은 팬의 빈 자리에서 시금치를 소금 한 꼬집과 함께 2분간 볶아요." },
  { "ruta": "recetas.7.pasos.5", "texto": "밥 위에 올리고 소스를 끼얹은 뒤 참깨를 뿌려요." },
  { "ruta": "recetas.8.nombre", "texto": "훈제 파프리카 렌틸콩 타코" },
  { "ruta": "recetas.8.ingredientes.0", "texto": "삶아서 물기 뺀 브라운 렌틸콩 400g" },
  { "ruta": "recetas.8.ingredientes.1", "texto": "양파(다지기) 1개" },
  { "ruta": "recetas.8.ingredientes.2", "texto": "빨간 파프리카(깍둑썰기) 1개" },
  { "ruta": "recetas.8.ingredientes.3", "texto": "마늘 2쪽" },
  { "ruta": "recetas.8.ingredientes.4", "texto": "커민 1작은술" },
  { "ruta": "recetas.8.ingredientes.5", "texto": "훈제 파프리카 가루 1작은술" },
  { "ruta": "recetas.8.ingredientes.6", "texto": "다진 토마토 통조림 200g" },
  { "ruta": "recetas.8.ingredientes.7", "texto": "올리브오일 2큰술" },
  { "ruta": "recetas.8.ingredientes.8", "texto": "옥수수 토르티야 8장" },
  { "ruta": "recetas.8.ingredientes.9", "texto": "아보카도 1개" },
  { "ruta": "recetas.8.ingredientes.10", "texto": "라임 1개" },
  { "ruta": "recetas.8.ingredientes.11", "texto": "신선한 고수" },
  { "ruta": "recetas.8.ingredientes.12", "texto": "플레인 요거트 100g" },
  { "ruta": "recetas.8.ingredientes.13", "texto": "소금" },
  { "ruta": "recetas.8.pasos.0", "texto": "양파와 빨간 파프리카를 오일에 넣고 8분간 볶아요." },
  { "ruta": "recetas.8.pasos.1", "texto": "마늘, 커민, 훈제 파프리카 가루를 넣고 1분간 볶아요." },
  { "ruta": "recetas.8.pasos.2", "texto": "토마토와 렌틸콩을 넣고 숟가락으로 살짝 으깨며 10분간 끓여 걸쭉하게 만들어요." },
  { "ruta": "recetas.8.pasos.3", "texto": "간을 하고 라임 반 개 즙을 넣어요." },
  { "ruta": "recetas.8.pasos.4", "texto": "토르티야를 기름 없는 팬에서 한 면당 30초씩 데워요." },
  { "ruta": "recetas.8.pasos.5", "texto": "렌틸콩, 슬라이스한 아보카도, 요거트, 고수를 채워요. 1인당 두 개예요." },
  { "ruta": "recetas.9.nombre", "texto": "회복 스무디" },
  { "ruta": "recetas.9.carpeta", "texto": "러너" },
  { "ruta": "recetas.9.ingredientes.0", "texto": "냉동 바나나(슬라이스) 1개" },
  { "ruta": "recetas.9.ingredientes.1", "texto": "우유 200ml" },
  { "ruta": "recetas.9.ingredientes.2", "texto": "플레인 그릭 요거트 150g" },
  { "ruta": "recetas.9.ingredientes.3", "texto": "냉동 베리 100g" },
  { "ruta": "recetas.9.ingredientes.4", "texto": "땅콩버터 1큰술(16g)" },
  { "ruta": "recetas.9.ingredientes.5", "texto": "무가당 코코아 가루 1작은술" },
  { "ruta": "recetas.9.ingredientes.6", "texto": "소금 한 꼬집" },
  { "ruta": "recetas.9.pasos.0", "texto": "믹서에 재료를 모두 넣어요, 액체류부터 먼저요." },
  { "ruta": "recetas.9.pasos.1", "texto": "45초간 갈아서 부드럽게 만들어요. 너무 되면 우유를 조금 더 넣어요." },
  { "ruta": "recetas.9.pasos.2", "texto": "장거리 러닝 후 30분 안에, 설거지를 줄이려고 믹서 컵에서 바로 마셔요." },
  { "ruta": "dietas.0.nombre", "texto": "마라톤 주간" },
  { "ruta": "dietas.0.descripcion", "texto": "경기 전 7일 동안. 월요일부터 목요일까지는 평소처럼 먹어요(일요일에 미리 만든 닭가슴살 볼, 가벼운 조깅 전에는 오트밀). 금요일과 토요일은 탄수화물을 늘리고 섬유질과 지방을 줄여요. 전날 밤에는 토마토 파스타를 먹고 새로운 시도는 하지 않아요. 스무디는 결승선을 넘은 후 30분을 위해 아껴두고, 목요일에 구워둔 바나나 브레드 한 조각을 곁들여요." },
  { "ruta": "dietas.0.recetas.0", "texto": "러너의 오버나이트 오트밀" },
  { "ruta": "dietas.0.recetas.1", "texto": "경기 전날 밤의 탄수화물 충전 파스타" },
  { "ruta": "dietas.0.recetas.2", "texto": "일주일치 닭가슴살 볼" },
  { "ruta": "dietas.0.recetas.3", "texto": "회복 스무디" },
  { "ruta": "dietas.0.recetas.4", "texto": "카페 카운터 바나나 브레드" },
  { "ruta": "dietas.1.nombre", "texto": "일본 여행 후, 가볍게" },
  { "ruta": "dietas.1.descripcion", "texto": "3주 동안 라멘, 편의점 음식, 가츠카레를 먹었더니 몸이 무거워지고 냉장고는 텅 비었어요. 콩류와 채소가 많이 들어간 가벼운 저녁을 2주간 먹고, 일주일에 한 번은 제대로 된 생선 요리를 먹어요. 아침은 전날 밤 미리 준비해서 7시 근무 전에 허둥대지 않게 해요. 일본에 대한 작은 오마주지만, 집에서 적당한 양으로 만들어요." },
  { "ruta": "dietas.1.recetas.0", "texto": "붉은 렌틸콩 수프" },
  { "ruta": "dietas.1.recetas.1", "texto": "훈제 파프리카 렌틸콩 타코" },
