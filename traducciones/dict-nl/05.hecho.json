[
  {
    "clave": "corazon.gato.noche.1",
    "texto": "Rustige nacht. Verpest het niet 🐾"
  },
  {
    "clave": "corazon.gato.rutina.0",
    "texto": "Hé, “{r}” is om {h}. Ik verroer geen poot 🐾"
  },
  {
    "clave": "corazon.gato.rutina.1",
    "texto": "“{r}” komt eraan ({h}). Jij kan het; ik hou toezicht 🐱"
  },
  {
    "clave": "corazon.gato.generica.0",
    "texto": "Alles onder controle. Ik heb het gecheckt tijdens mijn dutje 🐾"
  },
  {
    "clave": "corazon.gato.generica.1",
    "texto": "Hmm. Het huis staat er nog. Graag gedaan 🐱"
  },
  {
    "clave": "corazon.perro.manana.0",
    "texto": "Goedemorgen! Vandaag ruikt naar een geweldige dag! 🐶"
  },
  {
    "clave": "corazon.perro.manana.1",
    "texto": "Het is ochtend! Kom op, kom op, kom op! 🦴"
  },
  {
    "clave": "corazon.perro.tarde.0",
    "texto": "De perfecte middag om dingen voor elkaar te krijgen! Woef! 🐶"
  },
  {
    "clave": "corazon.perro.tarde.1",
    "texto": "Nog steeds hier, ik zie alles! 🎉"
  },
  {
    "clave": "corazon.perro.noche.0",
    "texto": "Wat een geweldige dag hadden we! Toch? Toch? 🐶"
  },
  {
    "clave": "corazon.perro.noche.1",
    "texto": "Rustige nacht… ik hou de wacht! 🦴"
  },
  {
    "clave": "corazon.perro.rutina.0",
    "texto": "“{r}” om {h}! Dat kun je! 🎉"
  },
  {
    "clave": "corazon.perro.rutina.1",
    "texto": "Vergeet “{r}” om {h} niet! Woef! 🐶"
  },
  {
    "clave": "corazon.perro.generica.0",
    "texto": "Ik hou van dit huis! 🐶"
  },
  {
    "clave": "corazon.perro.generica.1",
    "texto": "Roep me als je iets nodig hebt! Wat dan ook! 🦴"
  },
  {
    "clave": "corazon.buho.manana.0",
    "texto": "Dageraad. Ideaal om de dag rustig te plannen. 🦉"
  },
  {
    "clave": "corazon.buho.manana.1",
    "texto": "Een geordende ochtend levert dubbel op."
  },
  {
    "clave": "corazon.buho.tarde.0",
    "texto": "Middag: een goed moment om de voortgang te bekijken. 🦉"
  },
  {
    "clave": "corazon.buho.tarde.1",
    "texto": "De middag verloopt zoals gepland."
  },
  {
    "clave": "corazon.buho.noche.0",
    "texto": "De nacht valt. Ik stel voor de dag af te sluiten met een notitie. 🦉"
  },
  {
    "clave": "corazon.buho.noche.1",
    "texto": "De nacht nodigt uit tot bezinning."
  },
  {
    "clave": "corazon.buho.rutina.0",
    "texto": "Tijdige melding: “{r}” om {h}. 🦉"
  },
  {
    "clave": "corazon.buho.rutina.1",
    "texto": "Je planning vermeldt “{r}” om {h}."
  },
  {
    "clave": "corazon.buho.generica.0",
    "texto": "Ik observeer en noteer. Alles in orde. 🦉"
  },
  {
    "clave": "corazon.buho.generica.1",
    "texto": "Kennis stapelt zich dag na dag op."
  },
  {
    "clave": "corazon.robot.manana.0",
    "texto": "☀ DAGCYCLUS GESTART. SYSTEMEN OP 100%. 🤖"
  },
  {
    "clave": "corazon.robot.manana.1",
    "texto": "GOEDEMORGEN. BATTERIJ VOL. ✓"
  },
  {
    "clave": "corazon.robot.tarde.0",
    "texto": "MIDDAGSCAN VOLTOOID. GEEN AFWIJKINGEN. ✓"
  },
  {
    "clave": "corazon.robot.tarde.1",
    "texto": "PRODUCTIVITEIT BINNEN PARAMETERS. 🤖"
  },
  {
    "clave": "corazon.robot.noche.0",
    "texto": "NACHTMODUS ACTIEF. BEWAKING BEZIG. 🤖"
  },
  {
    "clave": "corazon.robot.noche.1",
    "texto": "AANBEVELING: MENS-EENHEID OPLADEN (SLAPEN). ✓"
  },
  {
    "clave": "corazon.robot.rutina.0",
    "texto": "HERINNERING: “{r}” GEPLAND OM {h}. ✓"
  },
  {
    "clave": "corazon.robot.rutina.1",
    "texto": "WAARSCHUWING: “{r}” OM {h}. 🤖"
  },
  {
    "clave": "corazon.robot.generica.0",
    "texto": "ALLE SYSTEMEN NOMINAAL. 🤖"
  },
  {
    "clave": "corazon.robot.generica.1",
    "texto": "WACHTEN OP INSTRUCTIES. NIET DRINGEND. ✓"
  },
