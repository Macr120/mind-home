    "ruta": "hitos.0.nota",
    "texto": "Gehalt aus dem Café, alle zwei Wochen, die Grundlage meines ganzen Monats."
  },
  {
    "ruta": "hitos.1.nota",
    "texto": "Studiengebühren für Physik, Teilzeit, aber es fühlt sich an wie Vollzeit."
  },
  {
    "ruta": "hitos.2.nota",
    "texto": "Miete fürs Zimmer, immer das Erste, das ich zurücklege."
  },
  {
    "ruta": "hitos.3.nota",
    "texto": "Internet und Strom, ohne die läuft keine Hausaufgabe."
  },
  {
    "ruta": "hitos.4.nota",
    "texto": "Handytarif, das Minimum, das noch Karten lädt."
  },
  {
    "ruta": "hitos.5.nota",
    "texto": "Streaming: mein eigenes Science-Fiction-Kino zu Hause."
  },
  {
    "ruta": "hitos.6.nota",
    "texto": "Autoversicherung, eine langweilige Zahlung, für die ich mir eines Tages dankbar sein werde."
  },
  {
    "ruta": "hitos.7.nota",
    "texto": "Meine ersten richtigen Laufschuhe; jetzt gibt es keine Ausrede mehr."
  },
  {
    "ruta": "hitos.8.nota",
    "texto": "Anmeldung zum 5-Kilometer-Lauf: meine erste Startnummer überhaupt."
  },
  {
    "ruta": "hitos.9.nota",
    "texto": "Anmeldung zum 10-Kilometer-Lauf, diesmal ohne lange zu zögern."
  },
  {
    "ruta": "hitos.10.nota",
    "texto": "Halbmarathon bezahlt; das Knie hat endlich mitgespielt."
  },
  {
    "ruta": "hitos.11.nota",
    "texto": "Zweiundvierzig Kilometer bezahlt. Kein Zurück mehr."
  },
  {
    "ruta": "hitos.12.nota",
    "texto": "Der neue Reisepass hat Japan vom Traum zum Plan gemacht."
  },
  {
    "ruta": "hitos.13.nota",
    "texto": "Reiserucksack, ich bin damit voll beladen durch die ganze Wohnung gelaufen."
  },
  {
    "ruta": "hitos.14.nota",
    "texto": "Ich habe den Flug gebucht, und meine Hände haben gezittert: Es ist echt."
  },
  {
    "ruta": "hitos.15.nota",
    "texto": "JR Pass besorgt, drei Wochen Zugfahrten auf meinen Namen."
  },
  {
    "ruta": "hitos.16.nota",
    "texto": "Unterkünfte bezahlt: Tokio, Hakone, Kyoto, Osaka, Hiroshima."
  },
  {
    "ruta": "hitos.17.nota",
    "texto": "Ich gebe die Ersparnisse eines ganzen Jahres aus, Euro für verdienten Euro."
  },
  {
    "ruta": "hitos.18.nota",
    "texto": "Das Auto ist kaputtgegangen und hat mein ganzes Polster mitgenommen."
  },
  {
    "ruta": "hitos.19.nota",
    "texto": "Physiotherapie fürs Knie: teuer, aber die Alternative war aufzugeben."
  },
  {
    "ruta": "hitos.20.nota",
    "texto": "Neue Reifen, die alten haben mir langsam Angst gemacht."
  },
  {
    "ruta": "hitos.21.nota",
    "texto": "Große Inspektion fürs Auto, die Wartung, die ich mir wirklich ausgesucht habe."
  },
  {
    "ruta": "hitos.22.nota",
    "texto": "Autopapierkram, der Preis dafür, eine geliebte Rostlaube zu haben."
  },
  {
    "ruta": "hitos.23.nota",
    "texto": "Weihnachtsgeld vom Café: direkt in den Notfallfonds."
  },
  {
    "ruta": "hitos.24.nota",
    "texto": "Geschenke für meine Familie, nachdem ich ihnen Klavier vorgespielt habe."
  },
  {
