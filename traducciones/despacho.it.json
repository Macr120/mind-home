  { "ruta": "hitos.0.nota", "texto": "Stipendio quindicinale del bar, la base di tutto il mese." },
  { "ruta": "hitos.1.nota", "texto": "Retta di Fisica, part time ma si sente a tempo pieno." },
  { "ruta": "hitos.2.nota", "texto": "Affitto della stanza, sempre la prima cosa che metto da parte." },
  { "ruta": "hitos.3.nota", "texto": "Internet e luce, senza quelli niente compiti." },
  { "ruta": "hitos.4.nota", "texto": "Piano telefonico, il minimo che regge le mappe." },
  { "ruta": "hitos.5.nota", "texto": "Streaming: il mio cinema di fantascienza a domicilio." },
  { "ruta": "hitos.6.nota", "texto": "Assicurazione della macchina, pagamento noioso che un giorno ringrazierò." },
  { "ruta": "hitos.7.nota", "texto": "Le mie prime vere scarpe da corsa; ormai niente più scuse." },
  { "ruta": "hitos.8.nota", "texto": "Iscrizione alla 5K: il mio primo pettorale nella vita." },
  { "ruta": "hitos.9.nota", "texto": "Iscrizione alla 10K, stavolta con meno esitazioni." },
  { "ruta": "hitos.10.nota", "texto": "Mezza maratona pagata; il ginocchio ha finalmente risposto bene." },
  { "ruta": "hitos.11.nota", "texto": "Quarantadue chilometri pagati. Non si torna indietro." },
  { "ruta": "hitos.12.nota", "texto": "Rinnovare il passaporto ha trasformato il Giappone da sogno a progetto." },
  { "ruta": "hitos.13.nota", "texto": "Zaino da viaggio, l'ho provato carico per tutta la casa." },
  { "ruta": "hitos.14.nota", "texto": "Ho comprato il volo e mi tremavano le mani: è reale." },
  { "ruta": "hitos.15.nota", "texto": "JR Pass pronto, tre settimane di treni a mio nome." },
  { "ruta": "hitos.16.nota", "texto": "Alloggi pagati: Tokyo, Hakone, Kyoto, Osaka, Hiroshima." },
  { "ruta": "hitos.17.nota", "texto": "Sto spendendo il risparmio di un anno, peso su peso guadagnato." },
  { "ruta": "hitos.18.nota", "texto": "La macchina è morta e si è portata via tutto il mio cuscinetto." },
  { "ruta": "hitos.19.nota", "texto": "Fisioterapia per il ginocchio: caro, ma l'alternativa era arrendermi." },
  { "ruta": "hitos.20.nota", "texto": "Gomme nuove perché le vecchie ormai facevano paura." },
  { "ruta": "hitos.21.nota", "texto": "Tagliando importante della macchina, la manutenzione che ho scelto io." },
  { "ruta": "hitos.22.nota", "texto": "Pratiche della macchina, il prezzo di amare un rottame a cui tengo." },
  { "ruta": "hitos.23.nota", "texto": "Tredicesima del bar: dritta al fondo di emergenza." },
  { "ruta": "hitos.24.nota", "texto": "Regali per la mia famiglia, dopo aver suonato il piano per loro." },
  { "ruta": "hitos.25.nota", "texto": "Vaccini di Laika; lei non capisce di budget." },
