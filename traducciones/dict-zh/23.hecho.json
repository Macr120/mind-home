 {
  "clave": "tut.app-computo--formulario.titulo",
  "texto": "公式手册"
 },
 {
  "clave": "tut.app-computo--formulario.resumen",
  "texto": "公式手册是你自己的公式本。数学、物理和化学的公式已经预先加载，但它们并不是独立的目录：都是你的公式，可以像自己写的一样编辑、移动或删除。"
 },
 {
  "clave": "tut.app-computo--calculadora.titulo",
  "texto": "计算与制图"
 },
 {
  "clave": "tut.app-computo--calculadora.resumen",
  "texto": "一台带历史记录的科学计算器，配有八种模式，用于处理不只是一次性运算的情况——其中包括四种类型的绘图功能——还有一个尽可能给出精确解的方程求解器。"
 },
 {
  "clave": "tut.app-computo--hojas.titulo",
  "texto": "电子表格"
 },
 {
  "clave": "tut.app-computo--hojas.resumen",
  "texto": "支持A1单元格引用和公式（=SUMA(B2:B15)）的电子表格。可导出为保留公式的Excel文件，或通过打印导出为PDF。"
 },
