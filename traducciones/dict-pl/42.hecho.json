[
  { "clave": "tut.app-entretenimiento--archivo.resumen", "texto": "Archiwum zapisuje to, co oglądasz, czytasz i w co grasz: każda pozycja ma swój status, gwiazdki i twoją recenzję. Grupuj według daty w folderach roku i miesiąca albo według gatunku." },
  { "clave": "tut.app-entretenimiento--programas.titulo", "texto": "Programy do obejrzenia" },
  { "clave": "tut.app-entretenimiento--programas.resumen", "texto": "Program to lista tytułów według tematu lub gatunku zamieniona w cele: odhaczasz to, co skończysz, a jeśli chcesz, ustawiasz im daty, żeby zobaczyć je w kalendarzu." },
  { "clave": "tut.app-entretenimiento--juegos.titulo", "texto": "Cyfrowy stół" },
  { "clave": "tut.app-entretenimiento--juegos.resumen", "texto": "Ponad dwadzieścia gier planszowych i zręcznościowych, pogrupowanych według rodziny i filtrowanych według liczby graczy: grasz w nie od razu, bez wychodzenia z domu." },
  { "clave": "tut.app-diario--habito.titulo", "texto": "Nawyk czytania gazety" },
  { "clave": "tut.app-diario--habito.resumen", "texto": "Gazeta jest ulotna: każdego dnia przynosi nagłówki według kategorii i ciekawostki „tego dnia w historii”, a o północy się odnawia. To, co zostaje, to twoja regularność — czytanie liczy się jako wpis dnia." },
  { "clave": "tut.app-diario--reparto.titulo", "texto": "Dostawa do ciebie" },
  { "clave": "tut.app-diario--reparto.resumen", "texto": "Możesz zaplanować, które sekcje dostarcza ci każdy asystent na czacie: o stałej godzinie albo w niespodziewanym momencie dnia." },
