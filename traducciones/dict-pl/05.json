  {
    "clave": "corazon.gato.noche.1",
    "en": "Quiet night. Don’t ruin it 🐾"
  },
  {
    "clave": "corazon.gato.rutina.0",
    "en": "Hey, “{r}” is at {h}. I’m not moving 🐾"
  },
  {
    "clave": "corazon.gato.rutina.1",
    "en": "“{r}” is coming up ({h}). You got this; I’ll supervise 🐱"
  },
  {
    "clave": "corazon.gato.generica.0",
    "en": "All under control. I checked while napping 🐾"
  },
  {
    "clave": "corazon.gato.generica.1",
    "en": "Hmm. The house still stands. You’re welcome 🐱"
  },
  {
    "clave": "corazon.perro.manana.0",
    "en": "Good morning! Today smells like a great day! 🐶"
  },
  {
    "clave": "corazon.perro.manana.1",
    "en": "It’s morning! Let’s go go go! 🦴"
  },
  {
    "clave": "corazon.perro.tarde.0",
    "en": "The perfect afternoon to get things done! Woof! 🐶"
  },
  {
    "clave": "corazon.perro.tarde.1",
    "en": "Still here, watching everything! 🎉"
  },
  {
    "clave": "corazon.perro.noche.0",
    "en": "What a great day we had! Right? Right? 🐶"
  },
  {
    "clave": "corazon.perro.noche.1",
    "en": "Quiet night… I’ll keep watch! 🦴"
  },
  {
    "clave": "corazon.perro.rutina.0",
    "en": "“{r}” at {h}! You can do it! 🎉"
  },
  {
    "clave": "corazon.perro.rutina.1",
    "en": "Don’t forget “{r}” at {h}! Woof! 🐶"
  },
  {
    "clave": "corazon.perro.generica.0",
    "en": "I love this house! 🐶"
  },
  {
    "clave": "corazon.perro.generica.1",
    "en": "Call me if you need anything! Anything! 🦴"
  },
  {
    "clave": "corazon.buho.manana.0",
    "en": "Dawn. Ideal for planning the day calmly. 🦉"
  },
  {
    "clave": "corazon.buho.manana.1",
    "en": "A tidy morning yields double."
  },
  {
    "clave": "corazon.buho.tarde.0",
    "en": "Midday: a good moment to review progress. 🦉"
  },
  {
    "clave": "corazon.buho.tarde.1",
    "en": "The afternoon proceeds as planned."
  },
  {
    "clave": "corazon.buho.noche.0",
    "en": "Night falls. I suggest closing the day with a note. 🦉"
  },
  {
    "clave": "corazon.buho.noche.1",
    "en": "Night invites reflection."
  },
  {
    "clave": "corazon.buho.rutina.0",
    "en": "Timely notice: “{r}” at {h}. 🦉"
  },
  {
    "clave": "corazon.buho.rutina.1",
    "en": "Your schedule lists “{r}” at {h}."
  },
  {
    "clave": "corazon.buho.generica.0",
    "en": "I observe and take note. All in order. 🦉"
  },
  {
    "clave": "corazon.buho.generica.1",
    "en": "Knowledge builds up day by day."
  },
