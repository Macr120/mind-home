  { "clave": "ejercicio.ejDesc.press-banca", "texto": "Leżąc na ławce, opuść sztangę do klatki piersiowej i wypchnij ją w górę do pełnego wyprostu rąk." },
  { "clave": "ejercicio.ejDesc.press-inclinado", "texto": "Na ławce skośnej wyciskaj sztangę lub hantle, aby mocniej zaangażować górną część klatki." },
  { "clave": "ejercicio.ejDesc.press-con-mancuernas", "texto": "Leżąc, wyciskaj dwie hantle w górę — zakres ruchu jest większy niż ze sztangą." },
  { "clave": "ejercicio.ejDesc.aperturas-con-mancuernas", "texto": "Leżąc, rozkładaj ramiona łukiem na boki i złącz je z powrotem, lekko ugiąwszy łokcie." },
  { "clave": "ejercicio.ejDesc.cruce-en-polea", "texto": "Stojąc między górnymi wyciągami, zbliżaj dłonie przed sobą, napinając klatkę piersiową." },
  { "clave": "ejercicio.ejDesc.fondos-en-paralelas", "texto": "Zawieszony na poręczach, opuszczaj się, uginając łokcie i pochylając tułów do przodu, po czym wypchnij się z powrotem w górę." },
  { "clave": "ejercicio.ejDesc.flexiones", "texto": "Twarzą w dół opuszczaj klatkę piersiową do podłogi, trzymając ciało prosto, po czym wypchnij się z powrotem." },
  { "clave": "ejercicio.ejDesc.dominadas", "texto": "Wisząc na drążku, podciągaj się, aż broda znajdzie się nad drążkiem." },
  { "clave": "ejercicio.ejDesc.jalon-al-pecho", "texto": "Siedząc przy górnym wyciągu, ściągaj drążek do klatki, opuszczając łokcie w dół." },
  { "clave": "ejercicio.ejDesc.remo-con-barra", "texto": "W opadzie tułowia z prostymi plecami ciągnij sztangę do brzucha, napinając mięśnie pleców." },
  { "clave": "ejercicio.ejDesc.remo-con-mancuerna", "texto": "Opierając się o ławkę, ciągnij hantlę w bok, nie skręcając tułowia." },
  { "clave": "ejercicio.ejDesc.remo-en-polea-baja", "texto": "Siedząc, ciągnij uchwyt do brzucha, trzymając plecy wyprostowane." },
  { "clave": "ejercicio.ejDesc.pull-over", "texto": "Leżąc, opuszczaj hantlę za głowę, a następnie wracaj z nią nad klatkę piersiową." },
  { "clave": "ejercicio.ejDesc.face-pull", "texto": "Przy wyciągu na wysokości twarzy ciągnij linę do czoła, rozchylając łokcie na boki." },
  { "clave": "ejercicio.ejDesc.hiperextensiones", "texto": "Na ławce opuszczaj tułów i unoś go z powrotem, prostując odcinek lędźwiowy." },
  { "clave": "ejercicio.ejDesc.press-militar", "texto": "Stojąc, wyciskaj sztangę od barków w górę nad głowę." },
  { "clave": "ejercicio.ejDesc.press-arnold", "texto": "Siedząc, wyciskaj hantle nad głowę, obracając dłonie od siebie na zewnątrz." },
  { "clave": "ejercicio.ejDesc.elevaciones-laterales", "texto": "Stojąc, unoś hantle bokiem do wysokości barków." },
  { "clave": "ejercicio.ejDesc.elevaciones-frontales", "texto": "Stojąc, unoś hantlę przed sobą do wysokości oczu." },
  { "clave": "ejercicio.ejDesc.pajaros", "texto": "W opadzie tułowia rozkładaj ramiona na boki, angażując tylny akton barku." },
  { "clave": "ejercicio.ejDesc.encogimientos", "texto": "Stojąc z obciążeniem, unoś barki w kierunku uszu i opuszczaj je z kontrolą." },
  { "clave": "ejercicio.ejDesc.curl-con-barra", "texto": "Stojąc, uginaj łokcie, unosząc sztangę w górę bez bujania tułowiem." },
  { "clave": "ejercicio.ejDesc.curl-con-mancuernas", "texto": "Stojąc lub siedząc, unoś hantle, uginając łokcie, na przemian lub jednocześnie." }
