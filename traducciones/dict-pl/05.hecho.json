[
  { "clave": "corazon.gato.noche.1", "texto": "Cicha noc. Nie zepsuj jej 🐾" },
  { "clave": "corazon.gato.rutina.0", "texto": "Hej, „{r}” jest o {h}. Nigdzie się nie ruszam 🐾" },
  { "clave": "corazon.gato.rutina.1", "texto": "„{r}” zbliża się ({h}). Dasz radę, ja dopilnuję 🐱" },
  { "clave": "corazon.gato.generica.0", "texto": "Wszystko pod kontrolą. Sprawdziłem podczas drzemki 🐾" },
  { "clave": "corazon.gato.generica.1", "texto": "Hm. Dom wciąż stoi. Nie ma za co 🐱" },
  { "clave": "corazon.perro.manana.0", "texto": "Dzień dobry! Dziś pachnie świetnym dniem! 🐶" },
  { "clave": "corazon.perro.manana.1", "texto": "Jest rano! Do dzieła, do dzieła! 🦴" },
  { "clave": "corazon.perro.tarde.0", "texto": "Idealne popołudnie, żeby coś załatwić! Hau! 🐶" },
  { "clave": "corazon.perro.tarde.1", "texto": "Wciąż tu jestem, pilnuję wszystkiego! 🎉" },
  { "clave": "corazon.perro.noche.0", "texto": "Ale mieliśmy dziś dzień! Prawda? Prawda? 🐶" },
  { "clave": "corazon.perro.noche.1", "texto": "Cicha noc… Będę czuwać! 🦴" },
  { "clave": "corazon.perro.rutina.0", "texto": "„{r}” o {h}! Dasz radę! 🎉" },
  { "clave": "corazon.perro.rutina.1", "texto": "Nie zapomnij o „{r}” o {h}! Hau! 🐶" },
  { "clave": "corazon.perro.generica.0", "texto": "Kocham ten dom! 🐶" },
  { "clave": "corazon.perro.generica.1", "texto": "Zawołaj mnie, gdy czegoś potrzebujesz! Czegokolwiek! 🦴" },
  { "clave": "corazon.buho.manana.0", "texto": "Świt. Idealny moment, by spokojnie zaplanować dzień. 🦉" },
  { "clave": "corazon.buho.manana.1", "texto": "Uporządkowany poranek podwójnie się opłaca." },
  { "clave": "corazon.buho.tarde.0", "texto": "Południe: dobry moment, by sprawdzić postępy. 🦉" },
  { "clave": "corazon.buho.tarde.1", "texto": "Popołudnie przebiega zgodnie z planem." },
  { "clave": "corazon.buho.noche.0", "texto": "Zapada noc. Proponuję zamknąć dzień notatką. 🦉" },
  { "clave": "corazon.buho.noche.1", "texto": "Noc zaprasza do refleksji." },
  { "clave": "corazon.buho.rutina.0", "texto": "Terminowe przypomnienie: „{r}” o {h}. 🦉" },
  { "clave": "corazon.buho.rutina.1", "texto": "Twój harmonogram wskazuje „{r}” o {h}." },
  { "clave": "corazon.buho.generica.0", "texto": "Obserwuję i notuję. Wszystko w porządku. 🦉" },
  { "clave": "corazon.buho.generica.1", "texto": "Wiedza gromadzi się dzień po dniu." },
  { "clave": "corazon.robot.manana.0", "texto": "☀ CYKL DNIA URUCHOMIONY. SYSTEMY NA 100%. 🤖" },
  { "clave": "corazon.robot.manana.1", "texto": "DZIEŃ DOBRY. BATERIA PEŁNA. ✓" },
  { "clave": "corazon.robot.tarde.0", "texto": "SKANOWANIE POPOŁUDNIOWE ZAKOŃCZONE. BRAK ANOMALII. ✓" },
  { "clave": "corazon.robot.tarde.1", "texto": "PRODUKTYWNOŚĆ W NORMIE. 🤖" },
  { "clave": "corazon.robot.noche.0", "texto": "TRYB NOCNY AKTYWNY. TRWA CZUWANIE. 🤖" },
  { "clave": "corazon.robot.noche.1", "texto": "ZALECENIE: DOŁADUJ JEDNOSTKĘ LUDZKĄ (SEN). ✓" },
  { "clave": "corazon.robot.rutina.0", "texto": "PRZYPOMNIENIE: „{r}” ZAPLANOWANO NA {h}. ✓" },
