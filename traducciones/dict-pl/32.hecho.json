  { "clave": "mascota.mago.capturado.0", "texto": "✨ Gotowe. Wpisałem zapis do {c}." },
  { "clave": "mascota.mago.capturado.1", "texto": "Niech tak się stanie: zapisałem to dokładnie w {c} ✨" },
  { "clave": "mascota.mago.clasificado.0", "texto": "📜 Schowałem twój zwój w dzienniku: {c}." },
  { "clave": "mascota.mago.clasificado.1", "texto": "Zostawiłem go odpoczywać w {c}." },
  { "clave": "mascota.mago.sinClasificar.0", "texto": "Zachowałem to, lecz nie wiem, do której komnaty należy… pomożesz mi? 🔮" },
  { "clave": "mascota.mago.sinClasificar.1", "texto": "Na razie niesklasyfikowane. Do którego pokoju mam to zanieść?" },
  { "clave": "mascota.mago.agregar.0", "texto": "🪄 Zmaterializowałem {c} w twoim domu." },
  { "clave": "mascota.mago.agregar.1", "texto": "{c} pojawia się na mapie za sprawą magii ✨" },
  { "clave": "mascota.mago.quitar.0", "texto": "🪄 {c} znika z mapy." },
  { "clave": "mascota.mago.quitar.1", "texto": "Usunąłem {c} z twojego domu." },
  { "clave": "mascota.mago.objeto.0", "texto": "🪄 Wyczarowałem twój {o} w {c}. ✨" },
  { "clave": "mascota.mago.objeto.1", "texto": "Niech twój {o} się zjawi… gotowe, w {c}!" },
  { "clave": "mascota.mago.recordado.0", "texto": "🧠 Wyryłem to w moim grymuarze. Nie zapomnę ✨" },
  { "clave": "mascota.mago.recordado.1", "texto": "Zapamiętane. Moja arkaniczna pamięć jest wieczna 🔮" },
  { "clave": "mascota.gato.capturado.0", "texto": "Mru, no dobra. Wrzuciłem to do {c}, chyba 🐾" },
  { "clave": "mascota.gato.capturado.1", "texto": "Zrobione, zapisałem w {c}. Nie musisz dziękować." },
  { "clave": "mascota.gato.clasificado.0", "texto": "Zostawiłem to w dzienniku {c}. Tam zostanie 🐱" },
  { "clave": "mascota.gato.clasificado.1", "texto": "Zanotowane w {c}, i tyle." },
  { "clave": "mascota.gato.sinClasificar.0", "texto": "Nie mam pojęcia, gdzie to pasuje. Zostawiłem bez klasyfikacji 🐾" },
  { "clave": "mascota.gato.sinClasificar.1", "texto": "Pfff, do którego pokoju to należy? Ty mi powiedz." },
  { "clave": "mascota.gato.agregar.0", "texto": "Dobra, postawiłem {c} na mapie. I tak się nudziłem 🐱" },
  { "clave": "mascota.gato.agregar.1", "texto": "Dodałem {c}. Gratulacje, chyba." },
  { "clave": "mascota.gato.quitar.0", "texto": "Usunąłem {c}. Jedna rzecz mniej do sprzątania 🐾" },
  { "clave": "mascota.gato.quitar.1", "texto": "{c}, zniknęło. Gotowe." },
  { "clave": "mascota.gato.objeto.0", "texto": "Proszę, twój {o}, w {c}. Tylko nie zepsuj 🐾" },
  { "clave": "mascota.gato.objeto.1", "texto": "Postawiłem twój {o} w {c}. Teraz daj mi się wyspać 🐱" },
  { "clave": "mascota.gato.recordado.0", "texto": "No dobra, zapamiętam to. Mam dobrą pamięć, chcesz wierz, chcesz nie 🐱" },
  { "clave": "mascota.gato.recordado.1", "texto": "Zanotowane w pamięci. Nie licz, że to powtórzę 🐾" },
  { "clave": "mascota.perro.capturado.0", "texto": "Hau! Zapisałem to w {c}! 🐶" },
  { "clave": "mascota.perro.capturado.1", "texto": "Zrobione! Zapisane w {c}! 🦴" },
