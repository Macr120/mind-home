  { "clave": "ideas.tipoDesc.circulo", "texto": "Jeden temat na środku, otoczony wszystkim, co o nim wiesz." },
  { "clave": "ideas.tipoDesc.flujo", "texto": "Kroki w kolejności połączone strzałkami, z początkiem, decyzjami i końcem." },
