  { "clave": "ideas.tipoDesc.linea", "texto": "Kamienie milowe w kolejności na linii, od pierwszego do ostatniego." },
  { "clave": "ideas.tipoDesc.ciclo", "texto": "Etapy, które powtarzają się w kole i zaczynają od nowa." },
  { "clave": "ideas.tipoDesc.piramide", "texto": "Ułożone poziomy: to, co podtrzymuje resztę, na dole, szczyt na górze." },
  { "clave": "ideas.tipoDesc.fuerzas", "texto": "To, co napędza zmianę, przeciwko temu, co ją hamuje, wraz z ich siłą." },
  { "clave": "ideas.tipoDesc.eisenhower", "texto": "Pilne kontra ważne: co robisz teraz, co planujesz, a co odpuszczasz." },
  { "clave": "ideas.tipoDesc.decision", "texto": "Każda opcja i to, dokąd prowadzi, gałąź po gałęzi." },
  { "clave": "ideas.tipoDesc.tier", "texto": "Wiersze od S do D, by uszeregować cokolwiek według poziomu." },
  { "clave": "ideas.tipo.matriz", "texto": "Macierz decyzyjna" },
  { "clave": "ideas.tipoDesc.matriz", "texto": "Kilka opcji ocenianych według kryteriów, na których naprawdę ci zależy." },
  { "clave": "ideas.guia.matriz", "texto": "Każde kryterium waży tyle, ile ci zależy (1-5), a każda opcja jest oceniana w nim od 1 do 5. Suma mnoży ocenę przez wagę, więc nic nie wygrywa tylko dlatego, że błyszczy w czymś, co jest ci obojętne." },
