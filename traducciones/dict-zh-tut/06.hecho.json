[
  {
    "clave": "tut.app-metas--esencial.3.texto",
    "texto": "计划是日程的草稿：它把一个目标拆成带日期的若干阶段。还是提议时你可以随意修改；等它说服了你，接受之后，这些阶段就会变成真正的子目标。"
  },
  {
    "clave": "tut.app-metas--esencial.4.titulo",
    "texto": "日程"
