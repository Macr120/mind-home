 {
  "clave": "tut.app-computo--formulario.titulo",
  "texto": "सूत्र पुस्तिका"
 },
 {
  "clave": "tut.app-computo--formulario.resumen",
  "texto": "सूत्र पुस्तिका आपकी है। इसमें गणित, भौतिकी और रसायन विज्ञान पहले से भरे हैं, लेकिन ये अलग कैटलॉग नहीं हैं: ये आपके अपने सूत्र हैं, इन्हें वैसे ही एडिट, मूव या डिलीट किया जा सकता है जैसे ख़ुद लिखे सूत्रों को।"
 },
 {
  "clave": "tut.app-computo--calculadora.titulo",
  "texto": "गणना और चार्ट"
 },
 {
  "clave": "tut.app-computo--calculadora.resumen",
  "texto": "इतिहास वाला एक वैज्ञानिक कैलकुलेटर, आठ मोड उन सबके लिए जो एक बार का हिसाब नहीं है — उनमें चार तरह के ग्राफ़ बनाने वाला मोड भी शामिल है — और एक इक्वेशन सॉल्वर जो जब संभव हो तो सटीक मूल देता है।"
 },
 {
