 },
 {
  "clave": "ideas.guia.matriz",
  "texto": "हर मानदंड का वज़न इस पर निर्भर करता है कि वह आपके लिए कितना मायने रखता है (1-5), और हर विकल्प को उस पर 1 से 5 तक आंका जाता है। कुल स्कोर, स्कोर को वज़न से गुणा करके निकलता है, इसलिए कोई भी सिर्फ़ उस चीज़ में अच्छा होकर नहीं जीतता जिसकी आपको परवाह नहीं।"
 },
