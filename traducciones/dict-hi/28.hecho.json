 {
  "clave": "constructor.cuarto.hintExpandir",
  "texto": "कमरा बड़ा करने के लिए + दबाएं और छोटा करने के लिए −। एक-सेल वाले कमरे में − उसे मिटा देता है।"
 },
 {
  "clave": "constructor.cuarto.hintMover",
  "texto": "कमरा खिसकाने के लिए खींचें, या बनाने के लिए नीचे बाईं ओर से कोई आकार चुनें। कमरे बड़े करने, छोटे करने या मिटाने के लिए «बड़ा करें» इस्तेमाल करें।"
 },
 {
  "clave": "constructor.cuarto.hintSotano",
  "texto": "बेसमेंट: कमरे ज़मीन के नीचे एक दीवार जितनी गहराई तक खोदे जाते हैं (पूल या बंकर)। पानी से भरने के लिए कोई एक चुनें।"
 },
 {
  "clave": "constructor.cuarto.hintPincel",
  "texto": "किसी खाली सेल पर टैप करके उस आकार का कमरा बनाएं। घुमाने के लिए उसी सेल पर फिर टैप करें और आख़िर में मिटाने के लिए भी। किसी कमरे की सेल पर टैप करके उसका आकार बदलें। महीन ग्रिड (ऊपर दाईं ओर) से ¼ सेल के कोने काटे जाते हैं।"
 },
 {
  "clave": "constructor.cuarto.hintPincelFino",
  "texto": "महीन ग्रिड: कमरे के किसी चतुर्थांश पर टैप करके वह कोना काटें (त्रिकोण या वृत्त); घुमाने के लिए फिर टैप करें और आख़िर में कट हटाने के लिए भी। खाली सेल पर यह उस महीन कोने वाला कमरा बना देता है।"
 },
