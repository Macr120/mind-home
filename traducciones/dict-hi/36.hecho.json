  { "clave": "sisifo.comoFunciona", "texto": "यह कैसे काम करता है" },
  { "clave": "sisifo.ayuda1", "texto": "आपके ऐप्स में गतिविधि वाला हर दिन एक सीढ़ी ऊपर ले जाता है। चोटी 365 दिनों पर है।" },
  { "clave": "sisifo.ayuda2", "texto": "हर 7 सीढ़ियों पर आपको एक बैज मिलता है (कुल 52), और हफ़्तों का हर चरण आपका रैंक बढ़ाता है (कुल 12)।" },
  { "clave": "sisifo.ayuda3", "texto": "अगर आप एक दिन चूक जाते हैं, तो महीने में आपके पास 2 छूट के दिन हैं: कोई बात नहीं। अगर ये ख़त्म हो जाएं, तो पत्थर मौजूदा रैंक की शुरुआत में वापस चला जाता है।" },
  { "clave": "sisifo.ayuda4", "texto": "चोटी पर पहुंचने पर आपको एक स्थायी सितारा मिलता है और आप फिर से नीचे से शुरू करते हैं।" },
  { "clave": "sisifo.frase", "texto": "सिसिफ़स को ख़ुश समझना ही होगा।" },
