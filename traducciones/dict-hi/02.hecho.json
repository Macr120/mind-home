    "clave": "ejercicio.ejDesc.press-banca",
    "texto": "बेंच पर लेटकर बार को छाती तक नीचे लाएं और कोहनियाँ सीधी होने तक ऊपर धकेलें।"
  },
  {
    "clave": "ejercicio.ejDesc.press-inclinado",
    "texto": "इंक्लाइन बेंच पर बार या डम्बल को ऊपर धकेलें ताकि ऊपरी छाती पर ज़ोर पड़े।"
  },
  {
    "clave": "ejercicio.ejDesc.press-con-mancuernas",
    "texto": "लेटकर दोनों डम्बल ऊपर धकेलें; बारबेल से ज़्यादा गति की सीमा मिलती है।"
  },
  {
    "clave": "ejercicio.ejDesc.aperturas-con-mancuernas",
    "texto": "लेटकर बाहों को चाप की तरह खोलें और कोहनियाँ हल्की मुड़ी रखते हुए वापस पास लाएं।"
  },
  {
    "clave": "ejercicio.ejDesc.cruce-en-polea",
    "texto": "दो ऊँची पुली के बीच खड़े होकर हाथों को सामने मिलाएं और छाती को कसें।"
  },
  {
    "clave": "ejercicio.ejDesc.fondos-en-paralelas",
    "texto": "पैरेलल बार पर लटककर, धड़ को आगे झुकाते हुए कोहनियाँ मोड़कर नीचे जाएं, फिर वापस ऊपर धकेलें।"
  },
  {
    "clave": "ejercicio.ejDesc.flexiones",
    "texto": "मुँह के बल लेटकर शरीर सीधा रखते हुए छाती को फ़र्श तक नीचे लाएं, फिर वापस ऊपर धकेलें।"
  },
  {
    "clave": "ejercicio.ejDesc.dominadas",
    "texto": "बार पर लटककर शरीर को तब तक ऊपर खींचें जब तक ठुड्डी बार से ऊपर न निकल जाए।"
  },
  {
    "clave": "ejercicio.ejDesc.jalon-al-pecho",
    "texto": "ऊँची पुली पर बैठकर बार को छाती तक खींचें, कोहनियों को नीचे की ओर धकेलते हुए।"
  },
  {
    "clave": "ejercicio.ejDesc.remo-con-barra",
    "texto": "पीठ सीधी रखते हुए झुकें और बार को पेट तक खींचें, पीठ की मांसपेशियों को कसते हुए।"
  },
  {
    "clave": "ejercicio.ejDesc.remo-con-mancuerna",
    "texto": "बेंच पर सहारा लेकर डम्बल को शरीर की ओर खींचें, बिना धड़ मरोड़े।"
  },
  {
    "clave": "ejercicio.ejDesc.remo-en-polea-baja",
    "texto": "बैठकर हैंडल को पेट तक खींचें, पीठ सीधी रखते हुए।"
  },
  {
    "clave": "ejercicio.ejDesc.pull-over",
    "texto": "लेटकर डम्बल को सिर के पीछे नीचे लाएं, फिर वापस छाती के ऊपर लाएं।"
  },
  {
    "clave": "ejercicio.ejDesc.face-pull",
    "texto": "चेहरे की ऊँचाई वाली पुली पर, रस्सी को माथे की ओर खींचें और कोहनियों को बाहर फैलाएं।"
  },
  {
    "clave": "ejercicio.ejDesc.hiperextensiones",
    "texto": "बेंच पर धड़ को नीचे लाएं और वापस ऊपर उठाएं, पीठ के निचले हिस्से को खींचते हुए।"
  },
  {
    "clave": "ejercicio.ejDesc.press-militar",
    "texto": "खड़े होकर बार को कंधों से सिर के ऊपर तक धकेलें।"
  },
  {
    "clave": "ejercicio.ejDesc.press-arnold",
    "texto": "बैठकर डम्बल को सिर के ऊपर धकेलें और साथ ही हथेलियों को अंदर से बाहर की ओर घुमाएं।"
  },
  {
    "clave": "ejercicio.ejDesc.elevaciones-laterales",
    "texto": "खड़े होकर डम्बल को बाजू की ओर कंधे की ऊँचाई तक उठाएं।"
  },
  {
    "clave": "ejercicio.ejDesc.elevaciones-frontales",
    "texto": "खड़े होकर डम्बल को सामने की ओर आँखों की ऊँचाई तक उठाएं।"
  },
  {
    "clave": "ejercicio.ejDesc.pajaros",
    "texto": "झुककर बाहों को बाजू की ओर खोलें ताकि कंधे का पिछला हिस्सा सक्रिय हो।"
  },
  {
    "clave": "ejercicio.ejDesc.encogimientos",
    "texto": "वज़न के साथ खड़े होकर कंधों को कानों की ओर उठाएं और नियंत्रण के साथ नीचे लाएं।"
  },
  {
    "clave": "ejercicio.ejDesc.curl-con-barra",
    "texto": "खड़े होकर बिना धड़ हिलाए कोहनियाँ मोड़कर बार को ऊपर उठाएं।"
  },
  {
    "clave": "ejercicio.ejDesc.curl-con-mancuernas",
    "texto": "खड़े या बैठे हुए, कोहनियाँ मोड़कर डम्बल को बारी-बारी या साथ में ऊपर उठाएं।"
  }
