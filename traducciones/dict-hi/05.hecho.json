[
 {
  "clave": "corazon.gato.noche.1",
  "texto": "शांत रात है। इसे खराब मत करना 🐾"
 },
 {
  "clave": "corazon.gato.rutina.0",
  "texto": "अरे, \"{r}\" {h} बजे है। मैं यहीं हूं 🐾"
 },
 {
  "clave": "corazon.gato.rutina.1",
  "texto": "\"{r}\" आने वाला है ({h})। आप कर लेंगे; मेरी नज़र रहेगी 🐱"
 },
 {
  "clave": "corazon.gato.generica.0",
  "texto": "सब कुछ नियंत्रण में है। झपकी के दौरान जांच हो चुकी है 🐾"
 },
 {
  "clave": "corazon.gato.generica.1",
  "texto": "हम्म। घर अभी भी खड़ा है। कोई बात नहीं 🐱"
 },
 {
  "clave": "corazon.perro.manana.0",
  "texto": "सुप्रभात! आज शानदार दिन जैसी खुशबू आ रही है! 🐶"
 },
 {
  "clave": "corazon.perro.manana.1",
  "texto": "सुबह हो गई! चलो चलो चलो! 🦴"
 },
 {
  "clave": "corazon.perro.tarde.0",
  "texto": "काम निपटाने के लिए एकदम सही दोपहर है! भौं! 🐶"
 },
 {
  "clave": "corazon.perro.tarde.1",
  "texto": "अभी भी यहीं हूं, सब पर नज़र है! 🎉"
 },
 {
  "clave": "corazon.perro.noche.0",
  "texto": "क्या दिन था! है ना? है ना? 🐶"
 },
 {
  "clave": "corazon.perro.noche.1",
  "texto": "शांत रात… मैं पहरे पर हूं! 🦴"
 },
 {
  "clave": "corazon.perro.rutina.0",
  "texto": "\"{r}\" {h} बजे! आप कर सकते हैं! 🎉"
 },
 {
  "clave": "corazon.perro.rutina.1",
  "texto": "\"{r}\" {h} बजे मत भूलिए! भौं! 🐶"
 },
 {
  "clave": "corazon.perro.generica.0",
  "texto": "मुझे यह घर बहुत पसंद है! 🐶"
 },
 {
  "clave": "corazon.perro.generica.1",
  "texto": "कुछ भी चाहिए तो बुला लीजिए! कुछ भी! 🦴"
 },
 {
  "clave": "corazon.buho.manana.0",
  "texto": "भोर। दिन की शांति से योजना बनाने का सही समय। 🦉"
 },
 {
  "clave": "corazon.buho.manana.1",
  "texto": "व्यवस्थित सुबह दोगुना फल देती है।"
 },
 {
  "clave": "corazon.buho.tarde.0",
  "texto": "दोपहर: प्रगति की समीक्षा का अच्छा समय। 🦉"
 },
 {
  "clave": "corazon.buho.tarde.1",
  "texto": "दोपहर योजना के अनुसार आगे बढ़ रही है।"
 },
 {
  "clave": "corazon.buho.noche.0",
  "texto": "रात हो रही है। सुझाव है कि दिन को एक नोट के साथ समाप्त करें। 🦉"
 },
 {
  "clave": "corazon.buho.noche.1",
  "texto": "रात मनन के लिए न्योता देती है।"
 },
 {
  "clave": "corazon.buho.rutina.0",
  "texto": "समय पर सूचना: \"{r}\" {h} बजे। 🦉"
 },
 {
  "clave": "corazon.buho.rutina.1",
  "texto": "आपकी समय-सारणी में \"{r}\" {h} बजे दर्ज है।"
 },
 {
  "clave": "corazon.buho.generica.0",
  "texto": "अवलोकन जारी है। नोट लिए जा रहे हैं। सब ठीक है। 🦉"
 },
 {
  "clave": "corazon.buho.generica.1",
  "texto": "ज्ञान दिन-ब-दिन बढ़ता जाता है।"
 },
 {
  "clave": "corazon.robot.manana.0",
  "texto": "☀ दिन-चक्र शुरू। सिस्टम 100% पर। 🤖"
 },
 {
  "clave": "corazon.robot.manana.1",
  "texto": "सुप्रभात। बैटरी पूरी तरह चार्ज। ✓"
 },
 {
  "clave": "corazon.robot.tarde.0",
  "texto": "दोपहर स्कैन पूर्ण। कोई गड़बड़ी नहीं। ✓"
 },
 {
  "clave": "corazon.robot.tarde.1",
  "texto": "उत्पादकता तय सीमा में। 🤖"
 },
 {
  "clave": "corazon.robot.noche.0",
  "texto": "नाइट मोड सक्रिय। निगरानी जारी। 🤖"
 },
 {
  "clave": "corazon.robot.noche.1",
  "texto": "सिफ़ारिश: मानव इकाई को रिचार्ज करें (नींद)। ✓"
 },
 {
  "clave": "corazon.robot.rutina.0",
  "texto": "अनुस्मारक: \"{r}\" {h} बजे नियत। ✓"
 },
 {
  "clave": "corazon.robot.rutina.1",
  "texto": "चेतावनी: \"{r}\" {h} बजे। 🤖"
 },
 {
  "clave": "corazon.robot.generica.0",
  "texto": "सभी सिस्टम सामान्य। 🤖"
 },
 {
  "clave": "corazon.robot.generica.1",
  "texto": "निर्देशों की प्रतीक्षा। जल्दी नहीं। ✓"
 },
