[
  {"clave":"corazon.gato.noche.1","texto":"Ruhige Nacht. Verdirb sie nicht 🐾"},
  {"clave":"corazon.gato.rutina.0","texto":"Hey, „{r}“ ist um {h}. Ich beweg mich nicht 🐾"},
  {"clave":"corazon.gato.rutina.1","texto":"„{r}“ steht bald an ({h}). Du schaffst das, ich behalte alles im Blick 🐱"},
  {"clave":"corazon.gato.generica.0","texto":"Alles unter Kontrolle. Ich hab's beim Nickerchen geprüft 🐾"},
  {"clave":"corazon.gato.generica.1","texto":"Hmm. Das Haus steht noch. Gern geschehen 🐱"},
  {"clave":"corazon.perro.manana.0","texto":"Guten Morgen! Heute riecht nach einem großartigen Tag! 🐶"},
  {"clave":"corazon.perro.manana.1","texto":"Es ist Morgen! Auf geht's, los, los! 🦴"},
  {"clave":"corazon.perro.tarde.0","texto":"Der perfekte Nachmittag, um Dinge zu erledigen! Wuff! 🐶"},
  {"clave":"corazon.perro.tarde.1","texto":"Immer noch hier, ich behalte alles im Auge! 🎉"},
  {"clave":"corazon.perro.noche.0","texto":"Was für ein toller Tag! Oder? Oder? 🐶"},
  {"clave":"corazon.perro.noche.1","texto":"Ruhige Nacht … ich halte Wache! 🦴"},
  {"clave":"corazon.perro.rutina.0","texto":"„{r}“ um {h}! Du schaffst das! 🎉"},
  {"clave":"corazon.perro.rutina.1","texto":"Vergiss „{r}“ um {h} nicht! Wuff! 🐶"},
  {"clave":"corazon.perro.generica.0","texto":"Ich liebe dieses Haus! 🐶"},
  {"clave":"corazon.perro.generica.1","texto":"Ruf mich, wenn du irgendetwas brauchst! Irgendetwas! 🦴"},
  {"clave":"corazon.buho.manana.0","texto":"Morgendämmerung. Ideal, um den Tag in Ruhe zu planen. 🦉"},
  {"clave":"corazon.buho.manana.1","texto":"Ein geordneter Morgen bringt doppelten Ertrag."},
  {"clave":"corazon.buho.tarde.0","texto":"Mittag: ein guter Moment, um den Fortschritt zu prüfen. 🦉"},
  {"clave":"corazon.buho.tarde.1","texto":"Der Nachmittag verläuft wie geplant."},
  {"clave":"corazon.buho.noche.0","texto":"Die Nacht bricht an. Ich empfehle, den Tag mit einer Notiz abzuschließen. 🦉"},
  {"clave":"corazon.buho.noche.1","texto":"Die Nacht lädt zur Reflexion ein."},
  {"clave":"corazon.buho.rutina.0","texto":"Rechtzeitiger Hinweis: „{r}“ um {h}. 🦉"},
  {"clave":"corazon.buho.rutina.1","texto":"Dein Zeitplan verzeichnet „{r}“ um {h}."},
  {"clave":"corazon.buho.generica.0","texto":"Ich beobachte und notiere. Alles in Ordnung. 🦉"},
  {"clave":"corazon.buho.generica.1","texto":"Wissen wächst Tag für Tag."},
  {"clave":"corazon.robot.manana.0","texto":"☀ TAGESZYKLUS GESTARTET. SYSTEME BEI 100 %. 🤖"},
