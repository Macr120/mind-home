  {
    "clave": "ejercicio.ejDesc.press-con-mancuernas",
    "texto": "Drücke im Liegen zwei Kurzhanteln mit größerem Bewegungsradius als bei der Langhantel nach oben."
  },
  {
    "clave": "ejercicio.ejDesc.aperturas-con-mancuernas",
    "texto": "Öffne im Liegen die Arme bogenförmig und führe sie mit leicht gebeugten Ellbogen wieder zusammen."
  },
  {
    "clave": "ejercicio.ejDesc.cruce-en-polea",
    "texto": "Stehe zwischen den hohen Kabelzügen und führe die Hände vor dem Körper zusammen, während du die Brust anspannst."
  },
  {
    "clave": "ejercicio.ejDesc.fondos-en-paralelas",
    "texto": "Hänge dich an den Barren, senke dich mit vorgebeugtem Oberkörper durch Beugen der Ellbogen ab und drücke dich wieder hoch."
  },
  {
    "clave": "ejercicio.ejDesc.flexiones",
    "texto": "Senke dich in Bauchlage mit geradem Körper zum Boden ab und drücke dich wieder hoch."
  },
  {
    "clave": "ejercicio.ejDesc.dominadas",
    "texto": "Ziehe dich hängend an der Stange hoch, bis dein Kinn über die Stange kommt."
  },
  {
    "clave": "ejercicio.ejDesc.jalon-al-pecho",
    "texto": "Ziehe sitzend am hohen Kabelzug die Stange zur Brust, indem du die Ellbogen nach unten drückst."
  },
  {
    "clave": "ejercicio.ejDesc.remo-con-barra",
    "texto": "Ziehe vorgebeugt mit geradem Rücken die Stange zum Bauch und spanne dabei den Rücken an."
  },
  {
    "clave": "ejercicio.ejDesc.remo-con-mancuerna",
    "texto": "Stütze dich auf der Bank ab und ziehe eine Kurzhantel seitlich heran, ohne den Oberkörper zu verdrehen."
  },
  {
    "clave": "ejercicio.ejDesc.remo-en-polea-baja",
    "texto": "Ziehe im Sitzen den Griff zum Bauch, während du den Rücken aufrecht hältst."
  },
  {
    "clave": "ejercicio.ejDesc.pull-over",
    "texto": "Senke im Liegen eine Kurzhantel hinter den Kopf ab und führe sie wieder über die Brust zurück."
  },
  {
    "clave": "ejercicio.ejDesc.face-pull",
    "texto": "Ziehe am kopfhohen Kabelzug das Seil zur Stirn und spreize dabei die Ellbogen nach außen."
  },
  {
    "clave": "ejercicio.ejDesc.hiperextensiones",
    "texto": "Senke auf der Bank den Oberkörper ab und richte ihn wieder auf, um den unteren Rücken zu strecken."
  },
  {
    "clave": "ejercicio.ejDesc.press-militar",
    "texto": "Drücke im Stehen die Stange von den Schultern über den Kopf."
  },
  {
    "clave": "ejercicio.ejDesc.press-arnold",
    "texto": "Drücke im Sitzen die Kurzhanteln über den Kopf und drehe dabei die Handflächen von innen nach außen."
  },
  {
    "clave": "ejercicio.ejDesc.elevaciones-laterales",
    "texto": "Hebe im Stehen die Kurzhanteln seitlich bis auf Schulterhöhe an."
  },
