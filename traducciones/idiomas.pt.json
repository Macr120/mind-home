  { "ruta": "temas.0.titulo", "texto": "Vocabulário de cafeteria" },
  { "ruta": "temas.0.descripcion", "texto": "Tudo o que falo no meu turno: pedidos, leites vegetais, esperas e desculpas gentis." },
