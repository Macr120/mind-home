[
  { "ruta": "recetas.0.nombre", "texto": "रात भर भिगोए ओट्स" },
  { "ruta": "recetas.0.carpeta", "texto": "धावक" },
  { "ruta": "recetas.0.ingredientes.0", "texto": "60 g ओट्स" },
  { "ruta": "recetas.0.ingredientes.1", "texto": "150 ml दूध (या ओट मिल्क)" },
  { "ruta": "recetas.0.ingredientes.2", "texto": "100 g सादा ग्रीक दही" },
  { "ruta": "recetas.0.ingredientes.3", "texto": "1 बड़ा चम्मच चिया बीज (12 g)" },
  { "ruta": "recetas.0.ingredientes.4", "texto": "1 पका केला" },
  { "ruta": "recetas.0.ingredientes.5", "texto": "1 छोटा चम्मच शहद" },
  { "ruta": "recetas.0.ingredientes.6", "texto": "1 चुटकी दालचीनी" },
  { "ruta": "recetas.0.ingredientes.7", "texto": "1 चुटकी नमक" },
  { "ruta": "recetas.0.pasos.0", "texto": "एक कांच के जार में ओट्स, चिया बीज, दालचीनी और नमक मिलाएं।" },
  { "ruta": "recetas.0.pasos.1", "texto": "दूध और दही डालकर तब तक मिलाएं जब तक कोई सूखी गुठली न बचे।" },
  { "ruta": "recetas.0.pasos.2", "texto": "आधे केले को कांटे से मैश करके मिला दें; बाकी आधा फ़्रिज में रख दें।" },
  { "ruta": "recetas.0.pasos.3", "texto": "ढककर 6 से 10 घंटे फ़्रिज में रख दें।" },
  { "ruta": "recetas.0.pasos.4", "texto": "सुबह बचे हुए कटे केले और शहद से सजाएं। दौड़ने से 90 मिनट पहले खाएं।" },
  { "ruta": "recetas.1.nombre", "texto": "रात पहले का कार्ब-लोडिंग पास्ता" },
  { "ruta": "recetas.1.carpeta", "texto": "धावक" },
  { "ruta": "recetas.1.ingredientes.0", "texto": "200 g स्पेगेटी" },
  { "ruta": "recetas.1.ingredientes.1", "texto": "400 g पिसे हुए टमाटर" },
  { "ruta": "recetas.1.ingredientes.2", "texto": "2 लहसुन की कलियां" },
  { "ruta": "recetas.1.ingredientes.3", "texto": "2 बड़े चम्मच जैतून का तेल" },
  { "ruta": "recetas.1.ingredientes.4", "texto": "1 छोटा चम्मच सूखी ओरिगैनो" },
  { "ruta": "recetas.1.ingredientes.5", "texto": "1 छोटा चम्मच चीनी" },
  { "ruta": "recetas.1.ingredientes.6", "texto": "40 g कद्दूकस किया परमेज़न" },
  { "ruta": "recetas.1.ingredientes.7", "texto": "6 ताज़ी बेसिल पत्तियां" },
  { "ruta": "recetas.1.ingredientes.8", "texto": "नमक" },
  { "ruta": "recetas.1.pasos.0", "texto": "एक बड़े बर्तन में खूब सारा नमकीन पानी उबाल लें।" },
  { "ruta": "recetas.1.pasos.1", "texto": "इस बीच पतला कटा लहसुन तेल में धीमी-मध्यम आंच पर 2 मिनट हल्का सुनहरा होने तक भूनें, जले नहीं इसका ध्यान रखें।" },
  { "ruta": "recetas.1.pasos.2", "texto": "टमाटर, ओरिगैनो, चीनी और एक चुटकी नमक डालें; धीमी आंच पर 15 मिनट पकाएं।" },
  { "ruta": "recetas.1.pasos.3", "texto": "पास्ता पैकेट पर बताए समय से एक मिनट कम पकाएं और उबाल वाला आधा गिलास पानी बचा लें।" },
  { "ruta": "recetas.1.pasos.4", "texto": "पास्ता को सॉस में बचे हुए पानी की थोड़ी मात्रा के साथ 1 मिनट भूनें।" },
  { "ruta": "recetas.1.pasos.5", "texto": "परमेज़न और बेसिल के साथ परोसें। हल्का, बिना तीखा डिनर — कल रेस है।" },
  { "ruta": "recetas.2.nombre", "texto": "पूरे हफ़्ते के लिए चिकन बाउल" },
  { "ruta": "recetas.2.ingredientes.0", "texto": "600 g चिकन ब्रेस्ट" },
  { "ruta": "recetas.2.ingredientes.1", "texto": "300 g ब्राउन राइस (कच्चा)" },
  { "ruta": "recetas.2.ingredientes.2", "texto": "400 g शकरकंद, क्यूब में कटा" },
  { "ruta": "recetas.2.ingredientes.3", "texto": "400 g ब्रोकली के फूल" },
  { "ruta": "recetas.2.ingredientes.4", "texto": "3 बड़े चम्मच जैतून का तेल" },
  { "ruta": "recetas.2.ingredientes.5", "texto": "1 छोटा चम्मच मीठी पैप्रिका" },
  { "ruta": "recetas.2.ingredientes.6", "texto": "1 छोटा चम्मच पिसा जीरा" },
  { "ruta": "recetas.2.ingredientes.7", "texto": "200 g सादा ग्रीक दही" },
  { "ruta": "recetas.2.ingredientes.8", "texto": "1 नींबू" },
  { "ruta": "recetas.2.ingredientes.9", "texto": "नमक और काली मिर्च" },
  { "ruta": "recetas.2.pasos.0", "texto": "ओवन को 200 °C पर गरम करें।" },
  { "ruta": "recetas.2.pasos.1", "texto": "शकरकंद को 1 बड़ा चम्मच तेल, नमक और काली मिर्च के साथ मिलाकर 25 मिनट बेक करें।" },
  { "ruta": "recetas.2.pasos.2", "texto": "चिकन में नमक-मिर्च लगाएं, पैप्रिका, जीरा और 1 बड़ा चम्मच तेल से मलें और तवे पर हर तरफ़ 6 मिनट सेकें। 5 मिनट रखा रहने दें, फिर पतली स्ट्रिप्स में काटें।" },
  { "ruta": "recetas.2.pasos.3", "texto": "ब्राउन राइस को नमकीन पानी में 25 मिनट पकाएं और पानी निथार लें।" },
  { "ruta": "recetas.2.pasos.4", "texto": "ब्रोकली को 5 मिनट भाप में पकाएं: गुरुवार तक टिके रहने के लिए इसे थोड़ा कुरकुरा ही रहने दें।" },
  { "ruta": "recetas.2.pasos.5", "texto": "दही को आधे नींबू के रस, नमक और बचे हुए तेल के साथ फेंटें।" },
  { "ruta": "recetas.2.pasos.6", "texto": "सब कुछ चार डिब्बों में बांटें, सॉस अलग रखें। फ़्रिज में चार दिन तक ठीक रहता है।" },
  { "ruta": "recetas.3.nombre", "texto": "घर पर बना जापानी करी" },
  { "ruta": "recetas.3.carpeta", "texto": "जापान से" },
  { "ruta": "recetas.3.ingredientes.0", "texto": "500 g चिकन थाई, क्यूब में कटी" },
  { "ruta": "recetas.3.ingredientes.1", "texto": "2 प्याज़, पतले कटे" },
  { "ruta": "recetas.3.ingredientes.2", "texto": "2 गाजर, मोटे टुकड़ों में कटी" },
  { "ruta": "recetas.3.ingredientes.3", "texto": "400 g आलू, क्यूब में कटा" },
  { "ruta": "recetas.3.ingredientes.4", "texto": "40 g मक्खन" },
  { "ruta": "recetas.3.ingredientes.5", "texto": "40 g मैदा" },
  { "ruta": "recetas.3.ingredientes.6", "texto": "2 बड़े चम्मच करी पाउडर" },
  { "ruta": "recetas.3.ingredientes.7", "texto": "1 छोटा चम्मच गरम मसाला" },
  { "ruta": "recetas.3.ingredientes.8", "texto": "1 बड़ा चम्मच सोया सॉस" },
  { "ruta": "recetas.3.ingredientes.9", "texto": "1 छोटा चम्मच शहद" },
  { "ruta": "recetas.3.ingredientes.10", "texto": "700 ml चिकन स्टॉक" },
  { "ruta": "recetas.3.ingredientes.11", "texto": "1 बड़ा चम्मच तेल" },
  { "ruta": "recetas.3.ingredientes.12", "texto": "300 g छोटे दाने वाला चावल (कच्चा)" },
  { "ruta": "recetas.3.pasos.0", "texto": "रू बनाएं: मक्खन पिघलाएं, मैदा डालें और धीमी आंच पर 5 मिनट चलाएं जब तक हल्के भूरे रंग का न हो जाए। करी पाउडर और गरम मसाला डालकर 1 मिनट चलाएं और आंच से उतार लें।" },
  { "ruta": "recetas.3.pasos.1", "texto": "एक बर्तन में चिकन को तेल में सुनहरा भूनें और निकाल लें।" },
  { "ruta": "recetas.3.pasos.2", "texto": "प्याज़ को 8 मिनट सुनहरा होने तक पकाएं; गाजर और आलू डालकर 2 मिनट चलाएं।" },
  { "ruta": "recetas.3.pasos.3", "texto": "चिकन वापस डालें, स्टॉक से ढकें और मध्यम आंच पर 20 मिनट पकाएं।" },
  { "ruta": "recetas.3.pasos.4", "texto": "रू को एक कड़छी गरम स्टॉक में घोलकर बर्तन में डालें। गाढ़ा और चमकदार होने तक 5 मिनट और चलाते हुए पकाएं।" },
  { "ruta": "recetas.3.pasos.5", "texto": "सोया सॉस और शहद डालें, नमक चख लें और ताज़े पके चावल पर परोसें।" },
  { "ruta": "recetas.4.nombre", "texto": "झटपट मिसो रामेन" },
  { "ruta": "recetas.4.carpeta", "texto": "जापान से" },
  { "ruta": "recetas.4.ingredientes.0", "texto": "200 g सूखे रामेन नूडल्स" },
  { "ruta": "recetas.4.ingredientes.1", "texto": "900 ml चिकन स्टॉक" },
  { "ruta": "recetas.4.ingredientes.2", "texto": "2 बड़े चम्मच मिसो पेस्ट" },
  { "ruta": "recetas.4.ingredientes.3", "texto": "1 बड़ा चम्मच सोया सॉस" },
  { "ruta": "recetas.4.ingredientes.4", "texto": "1 छोटा चम्मच तिल का तेल" },
  { "ruta": "recetas.4.ingredientes.5", "texto": "2 लहसुन की कलियां, कुटी हुई" },
  { "ruta": "recetas.4.ingredientes.6", "texto": "10 g कद्दूकस किया अदरक" },
  { "ruta": "recetas.4.ingredientes.7", "texto": "200 g पोर्क बेली या चिकन, पतली स्ट्रिप्स में कटा" },
  { "ruta": "recetas.4.ingredientes.8", "texto": "2 अंडे" },
  { "ruta": "recetas.4.ingredientes.9", "texto": "100 g स्वीट कॉर्न" },
  { "ruta": "recetas.4.ingredientes.10", "texto": "2 हरे प्याज़, कटे हुए" },
  { "ruta": "recetas.4.ingredientes.11", "texto": "1 नोरी शीट" },
  { "ruta": "recetas.4.pasos.0", "texto": "अंडों को 6 मिनट 30 सेकंड उबालें, बर्फ़ वाले पानी में ठंडा करें और छील लें।" },
  { "ruta": "recetas.4.pasos.1", "texto": "पोर्क बेली या चिकन को तिल के तेल में एक बर्तन में भूनें; लहसुन और अदरक डालकर 1 मिनट चलाएं।" },
  { "ruta": "recetas.4.pasos.2", "texto": "स्टॉक डालें और धीमी आंच पर 15 मिनट पकाएं, फिर आंच से उतार लें।" },
  { "ruta": "recetas.4.pasos.3", "texto": "मिसो को एक कड़छी स्टॉक में घोलें और सोया सॉस के साथ वापस बर्तन में डालें। दोबारा उबाल न आने दें।" },
  { "ruta": "recetas.4.pasos.4", "texto": "नूडल्स को अलग से पैकेट के अनुसार पकाएं और अच्छी तरह पानी निथार लें।" },
  { "ruta": "recetas.4.pasos.5", "texto": "बाउल तैयार करें: नूडल्स, स्टॉक, मांस, कॉर्न, आधा कटा अंडा, हरा प्याज़ और नोरी।" },
  { "ruta": "recetas.5.nombre", "texto": "कैफ़े जैसी बनाना ब्रेड" },
  { "ruta": "recetas.5.carpeta", "texto": "मीठा" },
  { "ruta": "recetas.5.ingredientes.0", "texto": "3 बहुत पके केले (350 g छिले हुए)" },
  { "ruta": "recetas.5.ingredientes.1", "texto": "2 अंडे" },
  { "ruta": "recetas.5.ingredientes.2", "texto": "80 g ब्राउन शुगर" },
  { "ruta": "recetas.5.ingredientes.3", "texto": "60 ml सूरजमुखी तेल" },
  { "ruta": "recetas.5.ingredientes.4", "texto": "220 g गेहूं का आटा" },
  { "ruta": "recetas.5.ingredientes.5", "texto": "1 छोटा चम्मच बेकिंग पाउडर" },
  { "ruta": "recetas.5.ingredientes.6", "texto": "1/2 छोटा चम्मच बेकिंग सोडा" },
  { "ruta": "recetas.5.ingredientes.7", "texto": "1 छोटा चम्मच दालचीनी" },
  { "ruta": "recetas.5.ingredientes.8", "texto": "1/2 छोटा चम्मच नमक" },
  { "ruta": "recetas.5.ingredientes.9", "texto": "60 g कटे अखरोट" },
  { "ruta": "recetas.5.pasos.0", "texto": "ओवन को 175 °C पर गरम करें और 22 cm के लोफ़ टिन में बेकिंग पेपर बिछाएं।" },
  { "ruta": "recetas.5.pasos.1", "texto": "केलों को कांटे से मैश करें, थोड़े टुकड़े रहने दें।" },
  { "ruta": "recetas.5.pasos.2", "texto": "अंडों को चीनी और तेल के साथ फेंटें, फिर केले का मैश मिलाएं।" },
  { "ruta": "recetas.5.pasos.3", "texto": "एक अलग बाउल में आटा, बेकिंग पाउडर, बेकिंग सोडा, दालचीनी और नमक मिलाएं।" },
  { "ruta": "recetas.5.pasos.4", "texto": "सूखी और गीली सामग्री को स्पैचुला से हल्के हाथ से मिलाएं, ज़्यादा न फेंटें, फिर अखरोट डालें।" },
  { "ruta": "recetas.5.pasos.5", "texto": "टिन में डालें और 50-55 मिनट बेक करें, जब तक टूथपिक साफ़ न निकले।" },
  { "ruta": "recetas.5.pasos.6", "texto": "टिन से निकालकर रैक पर ठंडा करें। दस स्लाइस में काटा हुआ, कागज़ में लपेटकर तीन दिन तक ठीक रहता है।" },
  { "ruta": "recetas.6.nombre", "texto": "लाल मसूर का सूप" },
  { "ruta": "recetas.6.ingredientes.0", "texto": "250 g लाल मसूर दाल" },
  { "ruta": "recetas.6.ingredientes.1", "texto": "1 प्याज़, कटा हुआ" },
  { "ruta": "recetas.6.ingredientes.2", "texto": "2 गाजर, क्यूब में कटी" },
  { "ruta": "recetas.6.ingredientes.3", "texto": "2 लहसुन की कलियां" },
  { "ruta": "recetas.6.ingredientes.4", "texto": "1 छोटा चम्मच पिसा जीरा" },
  { "ruta": "recetas.6.ingredientes.5", "texto": "1 छोटा चम्मच हल्दी" },
  { "ruta": "recetas.6.ingredientes.6", "texto": "1 लीटर वेजिटेबल स्टॉक" },
  { "ruta": "recetas.6.ingredientes.7", "texto": "2 बड़े चम्मच जैतून का तेल" },
  { "ruta": "recetas.6.ingredientes.8", "texto": "100 ml नारियल का दूध" },
  { "ruta": "recetas.6.ingredientes.9", "texto": "1 नींबू" },
  { "ruta": "recetas.6.ingredientes.10", "texto": "नमक और काली मिर्च" },
  { "ruta": "recetas.6.pasos.0", "texto": "प्याज़ और गाजर को तेल में एक चुटकी नमक के साथ 8 मिनट नरम करें।" },
  { "ruta": "recetas.6.pasos.1", "texto": "कटा हुआ लहसुन, जीरा और हल्दी डालकर 1 मिनट चलाएं।" },
  { "ruta": "recetas.6.pasos.2", "texto": "दाल धोकर स्टॉक के साथ डालें और उबाल आने दें।" },
  { "ruta": "recetas.6.pasos.3", "texto": "बीच-बीच में चलाते हुए मध्यम-धीमी आंच पर 20 मिनट पकाएं।" },
  { "ruta": "recetas.6.pasos.4", "texto": "ब्लेंडर से चिकना होने तक पीसें, नारियल का दूध और आधे नींबू का रस मिलाएं और नमक चख लें।" },
  { "ruta": "recetas.6.pasos.5", "texto": "डिब्बों में बांट लें; यह एक-एक हिस्से में अच्छी तरह जम जाता है।" },
  { "ruta": "recetas.7.nombre", "texto": "पालक के साथ तेरियाकी सैल्मन" },
  { "ruta": "recetas.7.carpeta", "texto": "जापान से" },
  { "ruta": "recetas.7.ingredientes.0", "texto": "2 सैल्मन फ़िलेट, 150 g प्रत्येक" },
  { "ruta": "recetas.7.ingredientes.1", "texto": "3 बड़े चम्मच सोया सॉस" },
  { "ruta": "recetas.7.ingredientes.2", "texto": "2 बड़े चम्मच मिरिन" },
  { "ruta": "recetas.7.ingredientes.3", "texto": "1 बड़ा चम्मच चीनी" },
  { "ruta": "recetas.7.ingredientes.4", "texto": "1 छोटा चम्मच कद्दूकस किया अदरक" },
  { "ruta": "recetas.7.ingredientes.5", "texto": "1 छोटा चम्मच कॉर्नफ्लोर" },
  { "ruta": "recetas.7.ingredientes.6", "texto": "1 बड़ा चम्मच तेल" },
  { "ruta": "recetas.7.ingredientes.7", "texto": "150 g छोटे दाने वाला चावल (कच्चा)" },
  { "ruta": "recetas.7.ingredientes.8", "texto": "200 g ताज़ा पालक" },
  { "ruta": "recetas.7.ingredientes.9", "texto": "1 छोटा चम्मच तिल" },
  { "ruta": "recetas.7.pasos.0", "texto": "चावल को पैकेट के अनुसार पकने के लिए रख दें।" },
  { "ruta": "recetas.7.pasos.1", "texto": "एक गिलास में सोया सॉस, मिरिन, चीनी, अदरक और कॉर्नफ्लोर मिलाएं।" },
  { "ruta": "recetas.7.pasos.2", "texto": "सैल्मन को अच्छी तरह सुखाएं और तेल में स्किन साइड नीचे रखकर 4 मिनट सेकें।" },
  { "ruta": "recetas.7.pasos.3", "texto": "पलटें, 2 मिनट और पकाएं और सॉस डालें; गाढ़ा होने तक 2 मिनट पकाएं और चम्मच से मछली पर सॉस डालते रहें।" },
  { "ruta": "recetas.7.pasos.4", "texto": "उसी तवे पर पालक को मछली से अलग एक चुटकी नमक के साथ 2 मिनट भूनें।" },
  { "ruta": "recetas.7.pasos.5", "texto": "चावल पर परोसें, ऊपर से सॉस और तिल डालें।" },
  { "ruta": "recetas.8.nombre", "texto": "स्मोकी दाल टैको" },
  { "ruta": "recetas.8.ingredientes.0", "texto": "400 g पकी हुई ब्राउन दाल, पानी निथारी हुई" },
  { "ruta": "recetas.8.ingredientes.1", "texto": "1 प्याज़, कटा हुआ" },
  { "ruta": "recetas.8.ingredientes.2", "texto": "1 लाल शिमला मिर्च, क्यूब में कटी" },
  { "ruta": "recetas.8.ingredientes.3", "texto": "2 लहसुन की कलियां" },
  { "ruta": "recetas.8.ingredientes.4", "texto": "1 छोटा चम्मच जीरा" },
  { "ruta": "recetas.8.ingredientes.5", "texto": "1 छोटा चम्मच स्मोक्ड पैप्रिका" },
  { "ruta": "recetas.8.ingredientes.6", "texto": "200 g पिसे हुए टमाटर" },
  { "ruta": "recetas.8.ingredientes.7", "texto": "2 बड़े चम्मच जैतून का तेल" },
  { "ruta": "recetas.8.ingredientes.8", "texto": "8 कॉर्न टॉर्टिला" },
  { "ruta": "recetas.8.ingredientes.9", "texto": "1 एवोकाडो" },
  { "ruta": "recetas.8.ingredientes.10", "texto": "1 नींबू" },
  { "ruta": "recetas.8.ingredientes.11", "texto": "ताज़ा धनिया" },
  { "ruta": "recetas.8.ingredientes.12", "texto": "100 g सादा दही" },
  { "ruta": "recetas.8.ingredientes.13", "texto": "नमक" },
  { "ruta": "recetas.8.pasos.0", "texto": "प्याज़ और शिमला मिर्च को तेल में 8 मिनट भूनें।" },
  { "ruta": "recetas.8.pasos.1", "texto": "लहसुन, जीरा और स्मोक्ड पैप्रिका डालकर 1 मिनट चलाएं।" },
  { "ruta": "recetas.8.pasos.2", "texto": "टमाटर और दाल डालें और 10 मिनट पकाएं, चम्मच से हल्का मैश करते हुए ताकि मिश्रण बंध जाए।" },
  { "ruta": "recetas.8.pasos.3", "texto": "नमक डालें और आधे नींबू का रस मिलाएं।" },
  { "ruta": "recetas.8.pasos.4", "texto": "टॉर्टिला को सूखे तवे पर हर तरफ़ 30 सेकंड गरम करें।" },
  { "ruta": "recetas.8.pasos.5", "texto": "दाल, कटा एवोकाडो, दही और धनिया भरें। एक व्यक्ति के लिए दो टैको।" },
  { "ruta": "recetas.9.nombre", "texto": "रिकवरी स्मूदी" },
  { "ruta": "recetas.9.carpeta", "texto": "धावक" },
  { "ruta": "recetas.9.ingredientes.0", "texto": "1 जमा हुआ केला, कटा हुआ" },
  { "ruta": "recetas.9.ingredientes.1", "texto": "200 ml दूध" },
  { "ruta": "recetas.9.ingredientes.2", "texto": "150 g सादा ग्रीक दही" },
  { "ruta": "recetas.9.ingredientes.3", "texto": "100 g जमे हुए बेरीज़" },
  { "ruta": "recetas.9.ingredientes.4", "texto": "1 बड़ा चम्मच पीनट बटर (16 g)" },
  { "ruta": "recetas.9.ingredientes.5", "texto": "1 छोटा चम्मच बिना मीठा कोको पाउडर" },
  { "ruta": "recetas.9.ingredientes.6", "texto": "1 चुटकी नमक" },
  { "ruta": "recetas.9.pasos.0", "texto": "सब कुछ ब्लेंडर में डालें, पहले तरल चीज़ें।" },
  { "ruta": "recetas.9.pasos.1", "texto": "45 सेकंड तक क्रीमी होने तक ब्लेंड करें; अगर ज़्यादा गाढ़ा लगे तो थोड़ा दूध मिलाएं।" },
  { "ruta": "recetas.9.pasos.2", "texto": "लंबी दौड़ के 30 मिनट के भीतर पी लें, सीधे ब्लेंडर के जार से ताकि बर्तन कम धोने पड़ें।" },
  { "ruta": "dietas.0.nombre", "texto": "मैराथन वाला हफ़्ता" },
  { "ruta": "dietas.0.descripcion", "texto": "दौड़ से पहले के सात दिन। सोमवार से गुरुवार तक हमेशा जैसा खाना — रविवार के बैच वाला चिकन बाउल, हल्की दौड़ों से पहले ओट्स; शुक्रवार-शनिवार को कार्ब्स ज़्यादा और फ़ाइबर-फैट कम। रेस से एक रात पहले टमाटर वाला पास्ता, कोई नया प्रयोग नहीं। फिनिश लाइन के आधे घंटे बाद रिकवरी स्मूदी, साथ में गुरुवार को बनी बनाना ब्रेड का एक टुकड़ा।" },
  { "ruta": "dietas.0.recetas.0", "texto": "रात भर भिगोए ओट्स" },
  { "ruta": "dietas.0.recetas.1", "texto": "रात पहले का कार्ब-लोडिंग पास्ता" },
  { "ruta": "dietas.0.recetas.2", "texto": "पूरे हफ़्ते के लिए चिकन बाउल" },
  { "ruta": "dietas.0.recetas.3", "texto": "रिकवरी स्मूदी" },
  { "ruta": "dietas.0.recetas.4", "texto": "कैफ़े जैसी बनाना ब्रेड" },
  { "ruta": "dietas.1.nombre", "texto": "जापान से लौटकर, हल्का-फुल्का" },
  { "ruta": "dietas.1.descripcion", "texto": "तीन हफ़्तों तक रामेन, कॉनबिनी खाना और कात्सु करी खाने से शरीर भारी हो गया और फ़्रिज खाली हो गया। अब दो हफ़्ते हल्के डिनर के — खूब सारी दालें और सब्ज़ियां, हफ़्ते में एक बार अच्छी मछली, और सुबह सात बजे की शिफ़्ट से पहले जल्दबाज़ी न करनी पड़े इसलिए नाश्ता एक रात पहले से तैयार। जापान को हल्का-सा सलाम, मगर बना घर पर और मात्रा नपी-तुली।" },
  { "ruta": "dietas.1.recetas.0", "texto": "लाल मसूर का सूप" },
  { "ruta": "dietas.1.recetas.1", "texto": "स्मोकी दाल टैको" },
