  {
    "ruta": "gratitudes.38.item1",
    "texto": "Yüzmek acıtmıyor"
  },
  {
    "ruta": "gratitudes.38.item2",
    "texto": "Japonca’da tarihleri söylemeyi öğrendim"
  },
  {
    "ruta": "gratitudes.39.item1",
    "texto": "Merdivenlerden topallamadan indim"
