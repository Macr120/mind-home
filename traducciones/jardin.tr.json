  {
    "ruta": "gratitudes.34.item2",
    "texto": "Dizimi kullanmadan piyano çalabiliyorum"
  },
  {
    "ruta": "gratitudes.34.item3",
    "texto": "Laika yanımdan hiç ayrılmadı"
  },
  {
    "ruta": "gratitudes.35.item1",
    "texto": "Buz ve kanepe de bir plan sayılır"
  },
  {
    "ruta": "gratitudes.35.item2",
    "texto": "Aylardır yarım kalan bir kitabı bitirdim"
  },
  {
    "ruta": "gratitudes.36.item1",
    "texto": "Nuri daha az ayakta durayım diye vardiyalarımı değiştirdi"
