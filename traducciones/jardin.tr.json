[
  {
    "ruta": "notasSesion.0.nota",
    "texto": "On dakika ve kafam bir saniye bile durmadı. Yine aynı huzursuzlukla kalktım ama en azından oturdum."
  },
  {
    "ruta": "notasSesion.1.nota",
    "texto": "Kafeyi açmadan önce dört-yedi-sekiz. Nabzım fırlamış halde gelmediğimde kahveleri daha iyi hazırlıyorum."
  },
  {
    "ruta": "notasSesion.2.nota",
    "texto": "Üç seansı art arda üçüncü hafta tamamladım. Bugün dikkatimin dağıldığı o anı fark ettim ve kendimi azarlamadan geri döndüm."
  },
  {
    "ruta": "notasSesion.3.nota",
    "texto": "5K’den önceki gece. Beni tam olarak sakinleştirmedi ama birde değil, on birde uyudum."
  },
  {
    "ruta": "notasSesion.4.nota",
    "texto": "Otobüs durağında, trafik gürültüsünün ortasında nefes aldım. Yine de işe yaradı, zaten şüphem oydu."
  },
  {
    "ruta": "notasSesion.5.nota",
    "texto": "İlk kez yirmi dakika. Son beş dakika tam bir sabırsızlıktı ama yine de dayandım."
  },
  {
    "ruta": "notasSesion.6.nota",
    "texto": "Laboratuvardan sonra kısa bir seans. Yorgunlukla kaygının aynı şey olmadığını hatırlamama yaradı."
  },
  {
    "ruta": "notasSesion.7.nota",
    "texto": "Dizim yeter dediğinden beri ilk seans. Bütün süre boyunca elimde çöken koşu planını düşündüm."
  },
  {
    "ruta": "notasSesion.8.nota",
    "texto": "Bugün sadece öfkeye bakabildim. Gitmedi ama dünkünden daha küçüldü."
  },
  {
    "ruta": "notasSesion.9.nota",
    "texto": "Tamirhaneden gelen aramadan sonra. Fiyat teklifini tekrar açmadan önce on yavaş nefes."
  },
  {
    "ruta": "notasSesion.10.nota",
    "texto": "Ağlayarak oturdum, ağlamadan bitirdim. Bunun meditasyon sayılıp sayılmadığını bilmiyorum ama bugün işime yaradı."
  },
  {
    "ruta": "notasSesion.11.nota",
    "texto": "Tek bir gün bile aksatmadan iki hafta. Bu ay rutinimde bozulmayan tek şey bu."
  },
  {
    "ruta": "notasSesion.12.nota",
    "texto": "Fizyoterapiden hemen sonra on dakika. Diz artık kafamın tamamını kaplamıyor."
  },
  {
    "ruta": "notasSesion.13.nota",
    "texto": "Açmadan önce arka odada dört-yedi-sekiz. Haftalardır ilk kez aceleye kapılmadan tezgâha çıktım."
  },
  {
    "ruta": "notasSesion.14.nota",
    "texto": "Uçuştan önceki son hafta. Yolculuk gerginliğini düzene sokmaya çalışmadan izlemek için oturdum."
  },
  {
    "ruta": "notasSesion.15.nota",
    "texto": "Arka planda trenlerin gürültüsüyle Ueno’da bir bankta. Üç dakika ve omuzlarım gevşedi."
  },
  {
    "ruta": "notasSesion.16.nota",
    "texto": "Kyoto’da tatami üzerinde yirmi dakika, zamanlayıcı yok. Bitmesini istemedim."
  },
  {
    "ruta": "notasSesion.17.nota",
    "texto": "Bir aylık aradan sonra kendi minderimde ilk seans. Yastık Laika kokuyordu."
  },
  {
    "ruta": "notasSesion.18.nota",
    "texto": "Mekanik ara sınavından önce beş dakika. Notları bir kez daha okumaktan daha işe yarıyor."
  },
  {
    "ruta": "notasSesion.19.nota",
    "texto": "Uzun pazar seansı. Yarı maraton aklıma geldi, ona baktım ve geçip gitmesine izin verdim."
  },
  {
    "ruta": "notasSesion.20.nota",
    "texto": "Start kutusunda iki dakika, burnumdan nefes alarak. Nabzım start pistolinden önce düştü."
  },
  {
    "ruta": "notasSesion.21.nota",
    "texto": "Yoğun kilometre haftası: sekizinci dakikada uyuyakaldım. Yine de sayıyorum."
  },
  {
    "ruta": "notasSesion.22.nota",
    "texto": "Termal battaniyeyle banyo zemininde oturmuş, yavaşça nefes alıyordum. Beden paramparça, kafa tertemiz."
  },
  {
    "ruta": "notasSesion.23.nota",
    "texto": "Bunu yapmaya başlayalı bir yıl oldu. Yirmi dakika ve özel bir şey olmadı, ki artık bu bile bana yeterli geliyor."
  },
  {
    "ruta": "gratitudes.0.item1",
    "texto": "İkinci el klavye artık neredeyse hiç akort kaymıyor"
  },
  {
    "ruta": "gratitudes.0.item2",
    "texto": "Laika metronomun sesine alıştı"
  },
  {
    "ruta": "gratitudes.0.item3",
    "texto": "Üç gün yetecek mercimek pişirdim"
  },
  {
    "ruta": "gratitudes.1.item1",
    "texto": "Yirmi dakika durmadan koştum"
  },
  {
    "ruta": "gratitudes.1.item2",
    "texto": "Cumartesi bahşişleri iyi çaya yetti"
  },
  {
    "ruta": "gratitudes.2.item1",
    "texto": "Terazi 74 kg gösterdi ve artık bakmaktan korkmuyorum"
  },
  {
    "ruta": "gratitudes.2.item2",
    "texto": "Uyumadan önce otuz İngilizce kartın hepsini tekrar ettim"
  },
  {
    "ruta": "gratitudes.2.item3",
    "texto": "Vardiya bitince sıcak duş"
  },
  {
    "ruta": "gratitudes.3.item1",
    "texto": "Nuri laboratuvara yetişebilmem için yarım saat beni kolladı"
  },
  {
    "ruta": "gratitudes.3.item2",
    "texto": "Koşu ayakkabıları artık sürtmüyor"
  },
  {
    "ruta": "gratitudes.3.item3",
    "texto": "Sabah altıda açık gökyüzü"
  },
  {
    "ruta": "gratitudes.4.item1",
    "texto": "Kafeyi açmadan önce on dakika meditasyon"
  },
  {
    "ruta": "gratitudes.4.item2",
    "texto": "Annem alay etmeden piyanoyu sordu"
  },
  {
    "ruta": "gratitudes.5.item1",
    "texto": "Mekanik ara sınavını geçtim"
  },
  {
    "ruta": "gratitudes.5.item2",
    "texto": "Laika notlarımın üzerinde uyudu"
  },
  {
    "ruta": "gratitudes.5.item3",
    "texto": "Vardiyadan bir gün önceki bedava ekmek"
  },
  {
    "ruta": "gratitudes.6.item1",
    "texto": "Hafif yağmurda koşmak hoşuma gitti"
  },
  {
    "ruta": "gratitudes.6.item2",
    "texto": "Bütçe bu on beş günde tuttu"
  },
  {
    "ruta": "gratitudes.6.item3",
    "texto": "Tuşlara bakmadan do majör gam"
  },
  {
    "ruta": "gratitudes.7.item1",
    "texto": "Bugün vardiyalar arasında hiçbir şey atıştırmadım"
  },
  {
    "ruta": "gratitudes.7.item2",
    "texto": "Neredeyse tamamını anladığım İngilizce bir podcast buldum"
  },
  {
    "ruta": "gratitudes.8.item1",
    "texto": "Bisiklet bu hafta kırk kilometreye dayandı"
  },
  {
    "ruta": "gratitudes.8.item2",
    "texto": "Alex ile telefona bakmadan yemek"
  },
  {
    "ruta": "gratitudes.8.item3",
    "texto": "Köşedeki dükkândan oolong çayı"
  },
  {
    "ruta": "gratitudes.9.item1",
    "texto": "Yedi saat kesintisiz uyudum"
  },
  {
    "ruta": "gratitudes.9.item2",
    "texto": "İki elle ilk şarkı, yavaş ama baştan sona"
  },
  {
    "ruta": "gratitudes.9.item3",
    "texto": "Kapıda beni bekleyen Laika"
  },
  {
    "ruta": "gratitudes.10.item1",
    "texto": "Üç haftadır koşu planına uyuyorum"
  },
  {
    "ruta": "gratitudes.10.item2",
    "texto": "Tokyo uçak biletleri sandığımdan ucuz"
  },
  {
    "ruta": "gratitudes.11.item1",
    "texto": "Rita, koşu günü olan pazar vardiyamı değiştirdi"
  },
  {
    "ruta": "gratitudes.11.item2",
    "texto": "İki hafif günden sonra dinlenmiş bacaklar"
  },
  {
    "ruta": "gratitudes.11.item3",
    "texto": "Gece on birde sıcak çorba"
  },
  {
    "ruta": "gratitudes.12.item1",
    "texto": "5K’yi 29:40’ta bitirdim"
  },
  {
    "ruta": "gratitudes.12.item2",
    "texto": "Alex bitiş çizgisinde saçma bir pankartla belirdi"
  },
  {
    "ruta": "gratitudes.12.item3",
    "texto": "Ucuz ama yine de saklayacağım bir madalya"
  },
  {
    "ruta": "gratitudes.13.item1",
    "texto": "Japonya işini kâğıda döktüm, artık geri dönüş yok"
  },
  {
    "ruta": "gratitudes.13.item2",
    "texto": "Yolculuk için ayrı bir tasarruf hesabı açtım"
  },
  {
    "ruta": "gratitudes.13.item3",
    "texto": "On hiragana tanıyorum"
  },
  {
    "ruta": "gratitudes.14.item1",
    "texto": "Sakin bir vardiya ve gayet iyi bahşişler"
  },
  {
    "ruta": "gratitudes.14.item2",
    "texto": "Laboratuvar raporu iyi yorumlarla geri döndü"
  },
  {
    "ruta": "gratitudes.15.item1",
    "texto": "İşten sonra koşmak artık beni bitirmiyor"
  },
  {
    "ruta": "gratitudes.15.item2",
    "texto": "Kyoto’nun ulaşımı hakkında net bir rehber buldum"
  },
  {
    "ruta": "gratitudes.15.item3",
    "texto": "Laika ve öğleden sonra güneşi aynı köşede"
  },
  {
    "ruta": "gratitudes.16.item1",
    "texto": "Japonya fonuna 2.700 ₺ daha"
  },
  {
    "ruta": "gratitudes.16.item2",
    "texto": "Artık takılmadan sumimasen diyorum"
  },
  {
    "ruta": "gratitudes.16.item3",
    "texto": "Etiyopya kahvesinden bedava tadım"
  },
  {
    "ruta": "gratitudes.17.item1",
    "texto": "Bir kilo verdim, dramsız"
  },
  {
    "ruta": "gratitudes.17.item2",
    "texto": "İki el ve pedal aynı anda"
  },
  {
    "ruta": "gratitudes.18.item1",
    "texto": "Dokuz kilometre koştum ve sonunda nefesim yetti"
  },
  {
    "ruta": "gratitudes.18.item2",
    "texto": "Gazozu maden suyuyla değiştirdim ve hâlâ hayattayım"
  },
  {
    "ruta": "gratitudes.18.item3",
    "texto": "Bisiklet 540 ₺’ye tamir edildi"
  },
  {
    "ruta": "gratitudes.19.item1",
    "texto": "Piyanoda ilk parçamı baştan sona bitirdim"
  },
  {
    "ruta": "gratitudes.19.item2",
    "texto": "Onu Laika’ya çaldım, mevcut tek dinleyiciydi"
  },
  {
    "ruta": "gratitudes.20.item1",
    "texto": "10K’yi tamamladım, yavaş ama tamam"
  },
  {
    "ruta": "gratitudes.20.item2",
    "texto": "Dizlerim altmış dakikaya dayandı"
  },
  {
    "ruta": "gratitudes.20.item3",
    "texto": "Suçluluk duymadan kocaman kahvaltı"
  },
  {
    "ruta": "gratitudes.21.item2",
    "texto": "Çalışma grubu kavgasız organize oldu"
  },
  {
    "ruta": "gratitudes.21.item3",
    "texto": "Tripodu denemek için temiz bir gece"
  },
  {
    "ruta": "gratitudes.22.item1",
    "texto": "Ayın ilk düzgün fotoğrafı"
  },
  {
    "ruta": "gratitudes.22.item2",
    "texto": "Sabahın ikisinde zencefilli çay"
  },
  {
    "ruta": "gratitudes.23.item1",
    "texto": "Sevdiğim müzikle geçen bir cuma vardiyası"
  },
  {
    "ruta": "gratitudes.23.item2",
    "texto": "Japonya tasarrufu %30’a ulaştı"
  },
  {
    "ruta": "gratitudes.23.item3",
    "texto": "Bir müşteri sütü buharla köpürtme numarasını gösterdi"
  },
  {
    "ruta": "gratitudes.24.item1",
    "texto": "Altyazısız bir bölümü baştan sona İngilizce anladım"
  },
  {
    "ruta": "gratitudes.24.item2",
    "texto": "Pazar günü Alex ile koşu"
  },
  {
    "ruta": "gratitudes.24.item3",
    "texto": "Laika yine ayaklarımın ucunda uyudu"
  },
  {
    "ruta": "gratitudes.25.item1",
    "texto": "Suçluluk duymadan bir dinlenme günü"
  },
  {
    "ruta": "gratitudes.25.item2",
    "texto": "Salı günü ucuz seansta bilim kurgu"
  },
  {
    "ruta": "gratitudes.25.item3",
    "texto": "Koşu kıyafetleri zamanında kurudu"
  },
  {
    "ruta": "gratitudes.26.item1",
    "texto": "Plana eklenen yeni on iki kilometre"
  },
  {
    "ruta": "gratitudes.26.item2",
    "texto": "Sonu gelmez kuyruklar olmadan pasaport yenilendi"
  },
  {
    "ruta": "gratitudes.27.item1",
    "texto": "Tasarruf %50’ye ulaştı"
  },
  {
    "ruta": "gratitudes.27.item2",
    "texto": "Bu hafta şüphe uyandıracak kadar iyi bahşişler"
  },
  {
    "ruta": "gratitudes.27.item3",
    "texto": "Ara sınavdan önce üç dakikalık nefes egzersizi"
  },
  {
    "ruta": "gratitudes.28.item1",
    "texto": "71 kg oldum, kotlarım artık bol geliyor"
  },
  {
    "ruta": "gratitudes.28.item2",
    "texto": "Epey daha zor yeni bir parçaya başladım"
  },
  {
    "ruta": "gratitudes.28.item3",
    "texto": "Kız kardeşimle akşam yemeği"
  },
  {
    "ruta": "gratitudes.29.item1",
    "texto": "Laboratuvar raporunu zamanında teslim ettim"
  },
  {
    "ruta": "gratitudes.29.item2",
    "texto": "15K takvimde ve artık beni korkutmuyor"
  },
  {
    "ruta": "gratitudes.30.item1",
    "texto": "Araba ilk seferde çalıştı"
  },
  {
    "ruta": "gratitudes.30.item2",
    "texto": "Vardiyadan önce gün doğumunda koşu"
  },
  {
    "ruta": "gratitudes.30.item3",
