  },
  {
    "ruta": "gratitudes.31.item3",
    "texto": "Laika bir güve yakaladı ve gururlandı"
  },
  {
    "ruta": "gratitudes.32.item1",
    "texto": "On dört kilometreye dayandım"
  },
  {
    "ruta": "gratitudes.32.item2",
    "texto": "Ailem yolculuk boyunca Laika’ya bakmayı teklif etti"
  },
  {
    "ruta": "gratitudes.33.item1",
    "texto": "Bütün maaş yolculuk fonuna gitti"
  },
  {
    "ruta": "gratitudes.33.item2",
    "texto": "Saate bakmadan on dakika meditasyon"
  },
  {
    "ruta": "gratitudes.33.item3",
    "texto": "Ot gibi kokan yeni bir yeşil çay"
