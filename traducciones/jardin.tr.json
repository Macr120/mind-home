  {
    "ruta": "gratitudes.45.item2",
    "texto": "Sakin bir vardiya ve gayet iyi bahşişler"
  },
  {
    "ruta": "gratitudes.45.item3",
    "texto": "Laika pencerede bekliyor"
  },
  {
    "ruta": "gratitudes.46.item1",
