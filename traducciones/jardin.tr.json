  {
    "ruta": "gratitudes.39.item2",
    "texto": "Annem tam gerektiği anda aradı"
  },
  {
    "ruta": "gratitudes.39.item3",
    "texto": "Vardiyanın ortasında bedava kahve"
  },
  {
    "ruta": "gratitudes.40.item1",
    "texto": "Araba yeniden yola çıktı ve korktuğumdan az tuttu"
