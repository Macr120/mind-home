[
  {
    "clave": "room.idiomas.desc",
    "texto": "Apprends des langues : tuteur IA, vocabulaire à répétition espacée, programme par niveau et exercices."
  },
  {
    "clave": "room.calendario.desc",
    "texto": "Ton calendrier : événements et routines par jour, semaine et mois."
  },
  {
    "clave": "room.caminos.desc",
    "texto": "Trace des circuits de course, des rails de train et des montagnes russes sur le plan."
  },
  {
    "clave": "room.canchas.desc",
    "texto": "Place des terrains de foot, tennis, basket et baseball sur le plan."
  },
  {
    "clave": "room.huerto.desc",
    "texto": "Prépare des parcelles, sème des cultures, arrose-les et récolte en temps réel."
  },
  {
    "clave": "room.granja.desc",
    "texto": "Élève poules, cochons, chèvres, moutons, vaches et chevaux, et cultive leur nourriture dans le même éditeur."
  },
  {
    "clave": "room.ideas.desc",
    "texto": "Ton journal d’idées et remue-méninges, dix formats de carte conceptuelle sur une toile libre (carte mentale, arbre, chronologie, cycle, pyramide, Venn…) et huit diagrammes pour décider (avantages et inconvénients, champ de forces, SWOT, Eisenhower, arbre de décision, tier list, matrice de décision pondérée et Ishikawa), à la main ou avec l’IA."
  },
  {
    "clave": "room.computo.desc",
    "texto": "Salle de calcul : une calculatrice scientifique avec son formulaire accroché (Mathématiques, Physique et Chimie incluses et modifiables) et huit modes — un traceur avec quatre types (2D, polaire, paramétrique et surface 3D), binaire et hexadécimal, matrices, systèmes d’équations, conversion d’unités, pourboire et règle de trois ; et des feuilles de calcul qui s’exportent en Excel et PDF."
  },
