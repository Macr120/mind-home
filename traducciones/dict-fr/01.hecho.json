[
  { "clave": "corazon.gato.noche.1", "texto": "Nuit calme. Ne la gâche pas 🐾" },
  { "clave": "corazon.gato.rutina.0", "texto": "Hé, « {r} » c’est à {h}. Je ne bouge pas 🐾" },
  { "clave": "corazon.gato.rutina.1", "texto": "« {r} » approche ({h}). Tu vas y arriver ; je supervise 🐱" },
  { "clave": "corazon.gato.generica.0", "texto": "Tout est sous contrôle. J’ai vérifié entre deux siestes 🐾" },
  { "clave": "corazon.gato.generica.1", "texto": "Hmm. La maison tient toujours debout. De rien 🐱" },
  { "clave": "corazon.perro.manana.0", "texto": "Bonjour ! Aujourd’hui sent la journée géniale ! 🐶" },
  { "clave": "corazon.perro.manana.1", "texto": "C’est le matin ! On y va, on y va, on y va ! 🦴" },
  { "clave": "corazon.perro.tarde.0", "texto": "L’après-midi parfait pour tout accomplir ! Ouaf ! 🐶" },
  { "clave": "corazon.perro.tarde.1", "texto": "Toujours là, à tout surveiller ! 🎉" },
  { "clave": "corazon.perro.noche.0", "texto": "Quelle super journée on a passée ! Hein ? Hein ? 🐶" },
  { "clave": "corazon.perro.noche.1", "texto": "Nuit tranquille… je monte la garde ! 🦴" },
  { "clave": "corazon.perro.rutina.0", "texto": "« {r} » à {h} ! Tu peux le faire ! 🎉" },
  { "clave": "corazon.perro.rutina.1", "texto": "N’oublie pas « {r} » à {h} ! Ouaf ! 🐶" },
  { "clave": "corazon.perro.generica.0", "texto": "J’adore cette maison ! 🐶" },
  { "clave": "corazon.perro.generica.1", "texto": "Appelle-moi si tu as besoin de quoi que ce soit ! N’importe quoi ! 🦴" },
  { "clave": "corazon.buho.manana.0", "texto": "Aube. Idéal pour planifier la journée calmement. 🦉" },
  { "clave": "corazon.buho.manana.1", "texto": "Une matinée bien organisée rapporte double." },
  { "clave": "corazon.buho.tarde.0", "texto": "Midi : un bon moment pour faire le point. 🦉" },
  { "clave": "corazon.buho.tarde.1", "texto": "L’après-midi se déroule comme prévu." },
  { "clave": "corazon.buho.noche.0", "texto": "La nuit tombe. Je te suggère de clore la journée par une note. 🦉" },
  { "clave": "corazon.buho.noche.1", "texto": "La nuit invite à la réflexion." },
  { "clave": "corazon.buho.rutina.0", "texto": "Avis opportun : « {r} » à {h}. 🦉" },
  { "clave": "corazon.buho.rutina.1", "texto": "Ton emploi du temps indique « {r} » à {h}." },
  { "clave": "corazon.buho.generica.0", "texto": "J’observe et je prends note. Tout est en ordre. 🦉" },
  { "clave": "corazon.buho.generica.1", "texto": "Le savoir s’accumule jour après jour." },
  { "clave": "corazon.robot.manana.0", "texto": "☀ CYCLE JOURNALIER DÉMARRÉ. SYSTÈMES À 100 %. 🤖" },
  { "clave": "corazon.robot.manana.1", "texto": "BONJOUR. BATTERIE PLEINE. ✓" },
  { "clave": "corazon.robot.tarde.0", "texto": "SCAN DE L’APRÈS-MIDI TERMINÉ. AUCUNE ANOMALIE. ✓" },
  { "clave": "corazon.robot.tarde.1", "texto": "PRODUCTIVITÉ CONFORME AUX PARAMÈTRES. 🤖" },
  { "clave": "corazon.robot.noche.0", "texto": "MODE NUIT ACTIF. SURVEILLANCE EN COURS. 🤖" },
  { "clave": "corazon.robot.noche.1", "texto": "RECOMMANDATION : RECHARGER L’UNITÉ HUMAINE (SOMMEIL). ✓" },
  { "clave": "corazon.robot.rutina.0", "texto": "RAPPEL : « {r} » PRÉVU À {h}. ✓" },
  { "clave": "corazon.robot.rutina.1", "texto": "ALERTE : « {r} » À {h}. 🤖" },
  { "clave": "corazon.robot.generica.0", "texto": "TOUS LES SYSTÈMES SONT NOMINAUX. 🤖" },
  { "clave": "corazon.robot.generica.1", "texto": "EN ATTENTE D’INSTRUCTIONS. PAS URGENT. ✓" },
  { "clave": "chat.config.activoMapa", "texto": "L’assistant actif est toujours sur le plan" },
