[
  {
    "clave": "room.idiomas.desc",
    "en": "Learn languages: AI tutor, spaced-repetition vocabulary, level syllabus and exercises."
  },
  {
    "clave": "room.calendario.desc",
    "en": "Your calendar: events and routines by day, week and month."
  },
  {
    "clave": "room.caminos.desc",
    "en": "Lay out race tracks, train rails and roller coasters on the map."
  },
  {
    "clave": "room.canchas.desc",
    "en": "Place soccer, tennis, basketball and baseball courts on the map."
  },
  {
    "clave": "room.huerto.desc",
    "en": "Prepare plots, sow crops, water them and harvest in real time."
  },
  {
    "clave": "room.granja.desc",
    "en": "Raise hens, pigs, goats, sheep, cows and horses, and grow their food in the same editor."
  },
  {
    "clave": "room.ideas.desc",
    "en": "Your idea journal and brainstorms, ten concept-map formats on a free canvas (mind map, tree, timeline, cycle, pyramid, Venn…) and eight diagrams to decide with (pros and cons, force field, SWOT, Eisenhower, decision tree, tier list, weighted decision matrix and Ishikawa), by hand or with AI."
  },
  {
    "clave": "room.computo.desc",
    "en": "Computing room: a scientific calculator with your formula book hanging off it (Mathematics, Physics and Chemistry included and editable) and eight modes — a plotter with four types (2D, polar, parametric and 3D surface), binary and hexadecimal, matrices, systems of equations, unit conversion, tip and rule of three; and spreadsheets that export to Excel and PDF."
  },
