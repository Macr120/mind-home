[
  { "ruta": "recetas.0.nombre", "texto": "前日仕込みのオーバーナイトオーツ" },
  { "ruta": "recetas.0.carpeta", "texto": "ランナー" },
  { "ruta": "recetas.0.ingredientes.0", "texto": "オートミール 60g" },
  { "ruta": "recetas.0.ingredientes.1", "texto": "牛乳 150ml(またはオーツミルク)" },
  { "ruta": "recetas.0.ingredientes.2", "texto": "プレーンギリシャヨーグルト 100g" },
  { "ruta": "recetas.0.ingredientes.3", "texto": "チアシード 大さじ1(12g)" },
  { "ruta": "recetas.0.ingredientes.4", "texto": "熟したバナナ 1本" },
  { "ruta": "recetas.0.ingredientes.5", "texto": "はちみつ 小さじ1" },
  { "ruta": "recetas.0.ingredientes.6", "texto": "シナモン ひとつまみ" },
  { "ruta": "recetas.0.ingredientes.7", "texto": "塩 ひとつまみ" },
  { "ruta": "recetas.0.pasos.0", "texto": "保存容器にオートミール、チアシード、シナモン、塩を入れて混ぜる。" },
  { "ruta": "recetas.0.pasos.1", "texto": "牛乳とヨーグルトを加え、粉っぽさがなくなるまで混ぜる。" },
  { "ruta": "recetas.0.pasos.2", "texto": "バナナ半分をフォークでつぶして混ぜ込む。残り半分は冷蔵庫で保存する。" },
  { "ruta": "recetas.0.pasos.3", "texto": "ふたをして冷蔵庫で6〜10時間置く。" },
  { "ruta": "recetas.0.pasos.4", "texto": "翌朝、残りのバナナを輪切りにしてのせ、はちみつをかける。走り出す90分前に食べる。" },
  { "ruta": "recetas.1.nombre", "texto": "前日のカーボローディングパスタ" },
  { "ruta": "recetas.1.carpeta", "texto": "ランナー" },
  { "ruta": "recetas.1.ingredientes.0", "texto": "スパゲッティ 200g" },
  { "ruta": "recetas.1.ingredientes.1", "texto": "カットトマト缶 400g" },
  { "ruta": "recetas.1.ingredientes.2", "texto": "にんにく 2かけ" },
  { "ruta": "recetas.1.ingredientes.3", "texto": "オリーブオイル 大さじ2" },
  { "ruta": "recetas.1.ingredientes.4", "texto": "乾燥オレガノ 小さじ1" },
  { "ruta": "recetas.1.ingredientes.5", "texto": "砂糖 小さじ1" },
  { "ruta": "recetas.1.ingredientes.6", "texto": "パルメザンチーズ(すりおろし) 40g" },
  { "ruta": "recetas.1.ingredientes.7", "texto": "生バジルの葉 6枚" },
  { "ruta": "recetas.1.ingredientes.8", "texto": "塩" },
  { "ruta": "recetas.1.pasos.0", "texto": "大きめの鍋にたっぷりの湯を沸かし、塩を加える。" },
  { "ruta": "recetas.1.pasos.1", "texto": "その間に、にんにくを薄切りにしてオイルで中弱火で2分ほど焦がさないように色づける。" },
  { "ruta": "recetas.1.pasos.2", "texto": "トマト、オレガノ、砂糖、塩ひとつまみを加え、弱火で15分煮る。" },
  { "ruta": "recetas.1.pasos.3", "texto": "パスタは袋の表示時間より1分短めにゆで、ゆで汁をおたま半分ほど取っておく。" },
  { "ruta": "recetas.1.pasos.4", "texto": "パスタをソースに加え、取っておいたゆで汁を少し加えて1分あえる。" },
  { "ruta": "recetas.1.pasos.5", "texto": "パルメザンチーズとバジルを添えて盛り付ける。脂質控えめで辛みなしの軽い夕食。明日はレースだから。" },
  { "ruta": "recetas.2.nombre", "texto": "一週間分の鶏肉ボウル" },
  { "ruta": "recetas.2.ingredientes.0", "texto": "鶏むね肉 600g" },
  { "ruta": "recetas.2.ingredientes.1", "texto": "玄米(生) 300g" },
  { "ruta": "recetas.2.ingredientes.2", "texto": "さつまいも(角切り) 400g" },
  { "ruta": "recetas.2.ingredientes.3", "texto": "ブロッコリー(小房) 400g" },
  { "ruta": "recetas.2.ingredientes.4", "texto": "オリーブオイル 大さじ3" },
  { "ruta": "recetas.2.ingredientes.5", "texto": "パプリカパウダー 小さじ1" },
  { "ruta": "recetas.2.ingredientes.6", "texto": "クミンパウダー 小さじ1" },
  { "ruta": "recetas.2.ingredientes.7", "texto": "プレーンギリシャヨーグルト 200g" },
  { "ruta": "recetas.2.ingredientes.8", "texto": "レモン 1個" },
  { "ruta": "recetas.2.ingredientes.9", "texto": "塩とこしょう" },
  { "ruta": "recetas.2.pasos.0", "texto": "オーブンを200℃に予熱する。" },
  { "ruta": "recetas.2.pasos.1", "texto": "さつまいもにオリーブオイル大さじ1、塩、こしょうを絡め、25分焼く。" },
  { "ruta": "recetas.2.pasos.2", "texto": "鶏肉に塩こしょうし、パプリカパウダー、クミン、オリーブオイル大さじ1をもみ込み、フライパンで片面6分ずつ焼く。5分休ませてから細切りにする。" },
  { "ruta": "recetas.2.pasos.3", "texto": "玄米を塩を入れた湯で25分ゆで、水気を切る。" },
  { "ruta": "recetas.2.pasos.4", "texto": "ブロッコリーを5分だけ蒸す。木曜日まで持たせるため、しっかり歯ごたえを残す。" },
  { "ruta": "recetas.2.pasos.5", "texto": "ヨーグルトにレモン半分の果汁、塩、残りのオリーブオイル大さじ1を混ぜる。" },
  { "ruta": "recetas.2.pasos.6", "texto": "すべてを4つの容器に分け、ソースは別容器にする。冷蔵庫で4日間もつ。" },
  { "ruta": "recetas.3.nombre", "texto": "おうちで作る鶏肉のモレ" },
  { "ruta": "recetas.3.carpeta", "texto": "メキシコから" },
  { "ruta": "recetas.3.ingredientes.0", "texto": "鶏もも肉(角切り) 500g" },
  { "ruta": "recetas.3.ingredientes.1", "texto": "玉ねぎ(薄切り) 1個" },
  { "ruta": "recetas.3.ingredientes.2", "texto": "にんにく 3かけ" },
  { "ruta": "recetas.3.ingredientes.3", "texto": "乾燥アンチョチリ 4本(なければパプリカパウダー 大さじ2)" },
  { "ruta": "recetas.3.ingredientes.4", "texto": "アーモンド(素焼き) 40g" },
  { "ruta": "recetas.3.ingredientes.5", "texto": "白ごま 大さじ2" },
  { "ruta": "recetas.3.ingredientes.6", "texto": "レーズン 30g" },
  { "ruta": "recetas.3.ingredientes.7", "texto": "ビターチョコレート(カカオ70%) 30g" },
  { "ruta": "recetas.3.ingredientes.8", "texto": "カットトマト缶 200g" },
  { "ruta": "recetas.3.ingredientes.9", "texto": "シナモン 小さじ1/2" },
  { "ruta": "recetas.3.ingredientes.10", "texto": "鶏がらスープ 700ml" },
  { "ruta": "recetas.3.ingredientes.11", "texto": "油 大さじ2" },
  { "ruta": "recetas.3.ingredientes.12", "texto": "米(生) 300g" },
  { "ruta": "recetas.3.pasos.0", "texto": "アンチョチリのヘタと種を取り、フライパンで両面20秒ずつ乾煎りしてから、熱湯に20分ひたして戻す。" },
  { "ruta": "recetas.3.pasos.1", "texto": "鍋に油大さじ1を熱し、鶏肉を焼き色がつくまで炒めて取り出す。" },
  { "ruta": "recetas.3.pasos.2", "texto": "残りの油で玉ねぎとにんにくを8分炒め、アーモンドと白ごまを加えて香りが立つまで2分炒める。" },
  { "ruta": "recetas.3.pasos.3", "texto": "炒めた材料に戻したチリ、トマト、レーズン、シナモン、スープ200mlを合わせ、ミキサーでなめらかなソースにする。" },
  { "ruta": "recetas.3.pasos.4", "texto": "ソースを鍋に戻し、残りのスープを加えて弱火で20分、時々混ぜながら煮る。鶏肉を戻してさらに10分煮る。" },
  { "ruta": "recetas.3.pasos.5", "texto": "チョコレートを割り入れて溶かし、塩加減を見て、炊きたてのご飯にかけて盛り付ける。" },
  { "ruta": "recetas.4.nombre", "texto": "時短ポソレ・ロホ" },
  { "ruta": "recetas.4.carpeta", "texto": "メキシコから" },
  { "ruta": "recetas.4.ingredientes.0", "texto": "ホミニー缶 400g(白とうもろこしの水煮。なければコーン缶)" },
  { "ruta": "recetas.4.ingredientes.1", "texto": "鶏がらスープ 900ml" },
  { "ruta": "recetas.4.ingredientes.2", "texto": "乾燥グアヒージョチリ 3本(なければパプリカパウダー 大さじ1)" },
  { "ruta": "recetas.4.ingredientes.3", "texto": "乾燥オレガノ 小さじ1" },
  { "ruta": "recetas.4.ingredientes.4", "texto": "油 小さじ1" },
  { "ruta": "recetas.4.ingredientes.5", "texto": "にんにく(みじん切り) 2かけ" },
  { "ruta": "recetas.4.ingredientes.6", "texto": "玉ねぎ(みじん切り) 1/2個" },
  { "ruta": "recetas.4.ingredientes.7", "texto": "豚肩ロースまたは鶏もも肉(細切り) 200g" },
  { "ruta": "recetas.4.ingredientes.8", "texto": "キャベツ(せん切り) 150g" },
  { "ruta": "recetas.4.ingredientes.9", "texto": "大根(薄いいちょう切り) 100g" },
  { "ruta": "recetas.4.ingredientes.10", "texto": "ライム 1個" },
  { "ruta": "recetas.4.ingredientes.11", "texto": "トルティーヤチップス 1袋" },
  { "ruta": "recetas.4.pasos.0", "texto": "グアヒージョチリのヘタと種を取り、熱湯に15分ひたして戻す。" },
  { "ruta": "recetas.4.pasos.1", "texto": "鍋に油を熱し、豚肩ロースまたは鶏もも肉を焼き色がつくまで炒め、にんにくと玉ねぎを加えて1分炒める。" },
  { "ruta": "recetas.4.pasos.2", "texto": "スープを注ぎ、弱火で15分煮て火から下ろす。" },
  { "ruta": "recetas.4.pasos.3", "texto": "戻したチリをおたま1杯のスープと一緒にミキサーにかけ、こしながら鍋に戻し、オレガノを加える。再び煮立たせないこと。" },
  { "ruta": "recetas.4.pasos.4", "texto": "ホミニーは水気を切って加え、5分ほど温める。" },
  { "ruta": "recetas.4.pasos.5", "texto": "深皿に盛る:スープと肉、せん切りキャベツ、大根、ライム、トルティーヤチップスは食卓で好きなだけのせる。" },
  { "ruta": "recetas.5.nombre", "texto": "カフェ仕込みのバナナブレッド" },
  { "ruta": "recetas.5.carpeta", "texto": "甘いもの" },
  { "ruta": "recetas.5.ingredientes.0", "texto": "よく熟したバナナ(皮をむいて350g) 3本" },
  { "ruta": "recetas.5.ingredientes.1", "texto": "卵 2個" },
  { "ruta": "recetas.5.ingredientes.2", "texto": "きび砂糖 80g" },
  { "ruta": "recetas.5.ingredientes.3", "texto": "ひまわり油 60ml" },
  { "ruta": "recetas.5.ingredientes.4", "texto": "小麦粉 220g" },
  { "ruta": "recetas.5.ingredientes.5", "texto": "ベーキングパウダー 小さじ1" },
  { "ruta": "recetas.5.ingredientes.6", "texto": "重曹 小さじ1/2" },
  { "ruta": "recetas.5.ingredientes.7", "texto": "シナモン 小さじ1" },
  { "ruta": "recetas.5.ingredientes.8", "texto": "塩 小さじ1/2" },
  { "ruta": "recetas.5.ingredientes.9", "texto": "くるみ(刻んだもの) 60g" },
  { "ruta": "recetas.5.pasos.0", "texto": "オーブンを175℃に予熱し、22cmのパウンド型に紙を敷く。" },
  { "ruta": "recetas.5.pasos.1", "texto": "バナナをフォークでつぶし、粒が少し残るくらいのペーストにする。" },
  { "ruta": "recetas.5.pasos.2", "texto": "卵と砂糖、油を混ぜ、バナナを加える。" },
  { "ruta": "recetas.5.pasos.3", "texto": "別のボウルで小麦粉、ベーキングパウダー、重曹、シナモン、塩を混ぜる。" },
  { "ruta": "recetas.5.pasos.4", "texto": "粉類と液体を練りすぎないようゴムべらで合わせ、くるみを加える。" },
  { "ruta": "recetas.5.pasos.5", "texto": "型に流し入れ、竹串がきれいに出るまで50〜55分焼く。" },
  { "ruta": "recetas.5.pasos.6", "texto": "型から出して網の上で冷ます。10切れに切り分け、紙に包めば3日もつ。" },
  { "ruta": "recetas.6.nombre", "texto": "赤レンズ豆のポタージュ" },
  { "ruta": "recetas.6.ingredientes.0", "texto": "赤レンズ豆 250g" },
  { "ruta": "recetas.6.ingredientes.1", "texto": "玉ねぎ(みじん切り) 1個" },
  { "ruta": "recetas.6.ingredientes.2", "texto": "にんじん(角切り) 2本" },
  { "ruta": "recetas.6.ingredientes.3", "texto": "にんにく 2かけ" },
  { "ruta": "recetas.6.ingredientes.4", "texto": "クミンパウダー 小さじ1" },
  { "ruta": "recetas.6.ingredientes.5", "texto": "ターメリック 小さじ1" },
  { "ruta": "recetas.6.ingredientes.6", "texto": "野菜だし 1リットル" },
  { "ruta": "recetas.6.ingredientes.7", "texto": "オリーブオイル 大さじ2" },
  { "ruta": "recetas.6.ingredientes.8", "texto": "ココナッツミルク 100ml" },
  { "ruta": "recetas.6.ingredientes.9", "texto": "レモン 1個" },
  { "ruta": "recetas.6.ingredientes.10", "texto": "塩とこしょう" },
  { "ruta": "recetas.6.pasos.0", "texto": "玉ねぎとにんじんをオイルで塩ひとつまみとともに8分炒める。" },
  { "ruta": "recetas.6.pasos.1", "texto": "にんにくのみじん切り、クミン、ターメリックを加えて1分炒める。" },
  { "ruta": "recetas.6.pasos.2", "texto": "レンズ豆を洗ってだしと一緒に加え、煮立たせる。" },
  { "ruta": "recetas.6.pasos.3", "texto": "中弱火で20分、時々混ぜながら煮る。" },
  { "ruta": "recetas.6.pasos.4", "texto": "ミキサーでなめらかにし、ココナッツミルクとレモン半分の果汁を加え、塩加減を調える。" },
  { "ruta": "recetas.6.pasos.5", "texto": "容器に分けて保存する。小分けにすると冷凍しやすい。" },
  { "ruta": "recetas.7.nombre", "texto": "ほうれん草添え鮭のベラクルス風" },
  { "ruta": "recetas.7.carpeta", "texto": "メキシコから" },
  { "ruta": "recetas.7.ingredientes.0", "texto": "鮭の切り身(150g) 2切れ" },
  { "ruta": "recetas.7.ingredientes.1", "texto": "カットトマト缶 200g" },
  { "ruta": "recetas.7.ingredientes.2", "texto": "玉ねぎ(薄切り) 1/2個" },
  { "ruta": "recetas.7.ingredientes.3", "texto": "にんにく 2かけ" },
  { "ruta": "recetas.7.ingredientes.4", "texto": "グリーンオリーブ(種なし) 8個" },
  { "ruta": "recetas.7.ingredientes.5", "texto": "ケッパー 大さじ1" },
  { "ruta": "recetas.7.ingredientes.6", "texto": "オリーブオイル 大さじ2" },
  { "ruta": "recetas.7.ingredientes.7", "texto": "米(生) 150g" },
  { "ruta": "recetas.7.ingredientes.8", "texto": "ほうれん草 200g" },
  { "ruta": "recetas.7.ingredientes.9", "texto": "ライム 1個" },
  { "ruta": "recetas.7.pasos.0", "texto": "パッケージの表示どおりにご飯を炊き始める。" },
  { "ruta": "recetas.7.pasos.1", "texto": "玉ねぎを薄切り、にんにくをみじん切りにし、オリーブは半分に切る。" },
  { "ruta": "recetas.7.pasos.2", "texto": "鮭の水気をしっかり拭き、オリーブオイル大さじ1を引いたフライパンで皮目から4分焼いて取り出す。" },
  { "ruta": "recetas.7.pasos.3", "texto": "同じフライパンに残りのオイルを足して玉ねぎとにんにくを5分炒め、トマト、オリーブ、ケッパーを加えて10分煮る。鮭を戻し、ソースをかけながら弱火で5分煮る。" },
  { "ruta": "recetas.7.pasos.4", "texto": "別のフライパンでほうれん草を塩ひとつまみとともに2分炒める。" },
  { "ruta": "recetas.7.pasos.5", "texto": "ご飯の上に盛り、ソースをかけてライムを搾る。" },
  { "ruta": "recetas.8.nombre", "texto": "スモークパプリカのレンズ豆タコス" },
  { "ruta": "recetas.8.ingredientes.0", "texto": "茶色レンズ豆(水煮・水気切り) 400g" },
  { "ruta": "recetas.8.ingredientes.1", "texto": "玉ねぎ(みじん切り) 1個" },
  { "ruta": "recetas.8.ingredientes.2", "texto": "赤パプリカ(角切り) 1個" },
  { "ruta": "recetas.8.ingredientes.3", "texto": "にんにく 2かけ" },
  { "ruta": "recetas.8.ingredientes.4", "texto": "クミン 小さじ1" },
  { "ruta": "recetas.8.ingredientes.5", "texto": "スモークパプリカパウダー 小さじ1" },
  { "ruta": "recetas.8.ingredientes.6", "texto": "カットトマト缶 200g" },
  { "ruta": "recetas.8.ingredientes.7", "texto": "オリーブオイル 大さじ2" },
  { "ruta": "recetas.8.ingredientes.8", "texto": "コーントルティーヤ 8枚" },
  { "ruta": "recetas.8.ingredientes.9", "texto": "アボカド 1個" },
  { "ruta": "recetas.8.ingredientes.10", "texto": "ライム 1個" },
  { "ruta": "recetas.8.ingredientes.11", "texto": "生パクチー" },
  { "ruta": "recetas.8.ingredientes.12", "texto": "プレーンヨーグルト 100g" },
  { "ruta": "recetas.8.ingredientes.13", "texto": "塩" },
  { "ruta": "recetas.8.pasos.0", "texto": "玉ねぎと赤パプリカをオイルで8分炒める。" },
  { "ruta": "recetas.8.pasos.1", "texto": "にんにく、クミン、スモークパプリカを加えて1分炒める。" },
  { "ruta": "recetas.8.pasos.2", "texto": "トマトとレンズ豆を加え、スプーンで少しつぶしながらまとまるまで10分煮る。" },
  { "ruta": "recetas.8.pasos.3", "texto": "塩で味を調え、ライム半分の果汁を加える。" },
  { "ruta": "recetas.8.pasos.4", "texto": "トルティーヤを油をひかないフライパンで片面30秒ずつ温める。" },
  { "ruta": "recetas.8.pasos.5", "texto": "レンズ豆、薄切りにしたアボカド、ヨーグルト、パクチーを詰める。ひとり2個。" },
  { "ruta": "recetas.9.nombre", "texto": "リカバリースムージー" },
  { "ruta": "recetas.9.carpeta", "texto": "ランナー" },
