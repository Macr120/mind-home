[
  { "ruta": "plantillas.0.notas.0", "texto": "이번 주 장보기" },
  { "ruta": "plantillas.0.notas.1", "texto": "홀빈 원두" },
  { "ruta": "plantillas.0.notas.2", "texto": "계란과 또르띠야" },
  { "ruta": "plantillas.0.notas.3", "texto": "시장에서 산 과일" },
  { "ruta": "plantillas.0.notas.4", "texto": "퇴근 후 타코" },
  { "ruta": "plantillas.0.notas.5", "texto": "벌크로 파는 잎차" },
  { "ruta": "plantillas.0.notas.6", "texto": "오트밀과 바나나" },
  { "ruta": "plantillas.0.notas.7", "texto": "오늘의 정식" },
  { "ruta": "plantillas.0.notas.8", "texto": "모퉁이 빵집 빵" },
  { "ruta": "plantillas.0.notas.9", "texto": "참치 통조림과 밥" },
  { "ruta": "plantillas.1.notas.0", "texto": "지하철 카드 충전" },
  { "ruta": "plantillas.1.notas.1", "texto": "자동차 기름값" },
  { "ruta": "plantillas.1.notas.2", "texto": "자전거 튜브" },
  { "ruta": "plantillas.1.notas.3", "texto": "체인과 라이트" },
  { "ruta": "plantillas.1.notas.4", "texto": "캠퍼스 주차비" },
  { "ruta": "plantillas.1.notas.5", "texto": "실험실 가는 버스비" },
  { "ruta": "plantillas.1.notas.6", "texto": "체인 오일" },
  { "ruta": "plantillas.1.notas.7", "texto": "집에 가는 길 통행료" },
  { "ruta": "plantillas.2.notas.0", "texto": "비누와 세제" },
  { "ruta": "plantillas.2.notas.1", "texto": "라이카 고양이 모래" },
  { "ruta": "plantillas.2.notas.2", "texto": "라이카 고양이 사료" },
  { "ruta": "plantillas.2.notas.3", "texto": "거실 전구" },
  { "ruta": "plantillas.2.notas.4", "texto": "양동이와 대걸레" },
  { "ruta": "plantillas.2.notas.5", "texto": "집에서 쓰는 가스비" },
  { "ruta": "plantillas.2.notas.6", "texto": "주방 수도꼭지 수리" },
  { "ruta": "plantillas.2.notas.7", "texto": "새 드립 커피메이커" },
  { "ruta": "plantillas.3.notas.0", "texto": "영화표" },
  { "ruta": "plantillas.3.notas.1", "texto": "큰 스크린으로 보는 SF 영화" },
  { "ruta": "plantillas.3.notas.2", "texto": "누리아와 커피" },
  { "ruta": "plantillas.3.notas.3", "texto": "악보" },
  { "ruta": "plantillas.3.notas.4", "texto": "천문관 입장료" },
  { "ruta": "plantillas.3.notas.5", "texto": "중고책" },
  { "ruta": "plantillas.3.notas.6", "texto": "중간고사 끝나고 마신 맥주" },
  { "ruta": "plantillas.3.notas.7", "texto": "천문대로 떠난 밤나들이" },
  { "ruta": "plantillas.4.notas.0", "texto": "일반 진료" },
  { "ruta": "plantillas.4.notas.1", "texto": "무릎 보호대" },
  { "ruta": "plantillas.4.notas.2", "texto": "레이스용 전해질 음료" },
  { "ruta": "plantillas.4.notas.3", "texto": "단백질 파우더" },
  { "ruta": "plantillas.4.notas.4", "texto": "소염 젤" },
  { "ruta": "plantillas.4.notas.5", "texto": "압박 양말" },
  { "ruta": "plantillas.4.notas.6", "texto": "혈액 검사" },
  { "ruta": "plantillas.4.notas.7", "texto": "운동화 깔창" },
  { "ruta": "plantillas.5.notas.0", "texto": "실험용 노트" },
  { "ruta": "plantillas.5.notas.1", "texto": "새 계산기" },
  { "ruta": "plantillas.5.notas.2", "texto": "레이스 기념 티셔츠" },
  { "ruta": "plantillas.5.notas.3", "texto": "저렴한 이어폰" },
  { "ruta": "plantillas.5.notas.4", "texto": "겨울용 후드티" },
  { "ruta": "plantillas.5.notas.5", "texto": "여분 충전기" },
  { "ruta": "plantillas.5.notas.6", "texto": "카메라용 케이블" },
  { "ruta": "plantillas.5.notas.7", "texto": "헬스장 수건" },
  { "ruta": "plantillas.6.notas.0", "texto": "논문 자료 복사비" },
  { "ruta": "plantillas.6.notas.1", "texto": "이발" },
  { "ruta": "plantillas.6.notas.2", "texto": "동전 세탁소" },
  { "ruta": "plantillas.6.notas.3", "texto": "포스터 인쇄비" },
  { "ruta": "plantillas.6.notas.4", "texto": "음악 스트리밍 구독료" },
  { "ruta": "plantillas.6.notas.5", "texto": "휴대폰 화면 수리" },
  { "ruta": "plantillas.6.notas.6", "texto": "온라인 수수료" },
  { "ruta": "plantillas.6.notas.7", "texto": "프린터 잉크" },
  { "ruta": "plantillas.7.notas.0", "texto": "이번 근무 팁" },
  { "ruta": "plantillas.7.notas.1", "texto": "바빴던 금요일" },
  { "ruta": "plantillas.7.notas.2", "texto": "꽉 찬 주말" },
  { "ruta": "plantillas.7.notas.3", "texto": "다 같이 나누는 팁 통" },
  { "ruta": "plantillas.7.notas.4", "texto": "한산했던 근무" },
  { "ruta": "plantillas.7.notas.5", "texto": "아침 단골손님들" },
  { "ruta": "plantillas.7.notas.6", "texto": "카페 대관 행사" },
  { "ruta": "plantillas.7.notas.7", "texto": "한산한 월요일" },
  { "ruta": "hitos.0.nota", "texto": "카페에서 격주로 받는 월급, 한 달의 기반이에요." },
  { "ruta": "hitos.1.nota", "texto": "물리학 등록금, 파트타임 학생이지만 마음은 풀타임이에요." },
  { "ruta": "hitos.2.nota", "texto": "방 월세, 늘 제일 먼저 떼어두는 돈이에요." },
  { "ruta": "hitos.3.nota", "texto": "인터넷과 전기 요금, 이게 없으면 과제도 못 해요." },
  { "ruta": "hitos.4.nota", "texto": "휴대폰 요금제, 지도 앱이 겨우 돌아가는 최소 사양이에요." },
  { "ruta": "hitos.5.nota", "texto": "스트리밍 구독, 집에서 즐기는 나만의 SF 영화관이에요." },
  { "ruta": "hitos.6.nota", "texto": "자동차 보험, 지루한 지출이지만 언젠가 고마워할 거예요." },
  { "ruta": "hitos.7.nota", "texto": "처음 장만한 제대로 된 러닝화, 이제 핑계는 없어요." },
  { "ruta": "hitos.8.nota", "texto": "5km 대회 참가비, 인생 첫 배번이에요." },
  { "ruta": "hitos.9.nota", "texto": "10km 대회 참가비, 이번엔 덜 망설였어요." },
  { "ruta": "hitos.10.nota", "texto": "하프 마라톤 참가비 결제, 무릎이 잘 버텨줬어요." },
  { "ruta": "hitos.11.nota", "texto": "42km 참가비 결제 완료. 이제 돌이킬 수 없어요." },
  { "ruta": "hitos.12.nota", "texto": "여권을 갱신하니 일본이 더 이상 꿈이 아니게 됐어요." },
  { "ruta": "hitos.13.nota", "texto": "여행용 배낭, 짐을 채워 집 안을 한 바퀴 돌며 시험해봤어요." },
  { "ruta": "hitos.14.nota", "texto": "항공권을 사고 손이 떨렸어요. 진짜예요." },
  { "ruta": "hitos.15.nota", "texto": "JR 패스 준비 완료, 3주간의 기차 여행에 제 이름이 새겨져 있어요." },
  { "ruta": "hitos.16.nota", "texto": "숙박비 결제 완료: 도쿄, 하코네, 교토, 오사카, 히로시마." },
  { "ruta": "hitos.17.nota", "texto": "일 년 동안 모은 돈을, 번 만큼 한 푼 한 푼 쓰고 있어요." },
  { "ruta": "hitos.18.nota", "texto": "자동차가 고장 나면서 모아둔 여유 자금도 함께 사라졌어요." },
  { "ruta": "hitos.19.nota", "texto": "무릎 물리치료, 비쌌지만 포기하는 것보단 나았어요." },
  { "ruta": "hitos.20.nota", "texto": "새 타이어로 교체했어요, 낡은 타이어가 이미 불안했거든요." },
  { "ruta": "hitos.21.nota", "texto": "자동차 정기 점검, 이번엔 제가 직접 선택한 정비예요." },
  { "ruta": "hitos.22.nota", "texto": "자동차 서류와 세금, 정든 낡은 차를 갖고 있는 대가예요." },
  { "ruta": "hitos.23.nota", "texto": "카페 연말 보너스, 곧장 비상금으로 넣었어요." },
  { "ruta": "hitos.24.nota", "texto": "가족을 위한 선물, 피아노를 쳐드린 다음이에요." },
  { "ruta": "hitos.25.nota", "texto": "라이카 예방접종, 예산 같은 건 얘가 알 바 아니죠." },
  { "ruta": "metas.japon", "texto": "일본, 3주 (달성)" },
  { "ruta": "metas.emergencia", "texto": "비상금: 3개월치" },
  { "ruta": "metas.inversion", "texto": "CETES: 처음으로 수익이 나는 저축" },
  { "ruta": "metas.deuda", "texto": "자동차 고장 부채 (상환 완료)" }
]
