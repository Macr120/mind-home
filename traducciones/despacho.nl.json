  {
    "ruta": "hitos.0.nota",
    "texto": "Salaris uit de koffiebar, om de twee weken, de basis van mijn hele maand."
  },
  {
    "ruta": "hitos.1.nota",
    "texto": "Collegegeld voor Natuurkunde, deeltijd maar het voelt voltijds."
  },
  {
    "ruta": "hitos.2.nota",
    "texto": "Huur voor mijn kamer, altijd het eerste wat ik opzijzet."
  },
  {
    "ruta": "hitos.3.nota",
    "texto": "Internet en stroom, zonder dat lukt geen huiswerk."
  },
  {
    "ruta": "hitos.4.nota",
    "texto": "Telefoonabonnement, het absolute minimum, net genoeg om kaarten te laden."
  },
  {
    "ruta": "hitos.5.nota",
    "texto": "Streaming: mijn eigen sciencefictionbioscoop, thuis op de bank."
  },
  {
    "ruta": "hitos.6.nota",
    "texto": "Autoverzekering, saaie betaling waar ik mezelf ooit dankbaar voor zal zijn."
  },
  {
    "ruta": "hitos.7.nota",
    "texto": "Mijn eerste echte hardloopschoenen; geen excuus meer."
  },
  {
    "ruta": "hitos.8.nota",
    "texto": "Inschrijving voor de 5 km: mijn allereerste startnummer."
  },
  {
    "ruta": "hitos.9.nota",
    "texto": "Inschrijving voor de 10 km, deze keer zonder lang te twijfelen."
  },
  {
    "ruta": "hitos.10.nota",
    "texto": "Halve marathon betaald; mijn knie hield het eindelijk vol."
  },
  {
    "ruta": "hitos.11.nota",
    "texto": "Tweeënveertig kilometer betaald. Geen weg meer terug."
  },
  {
    "ruta": "hitos.12.nota",
    "texto": "Mijn paspoort vernieuwen maakte van Japan geen droom meer, maar een plan."
  },
  {
    "ruta": "hitos.13.nota",
    "texto": "Reisrugzak, ik liep er volgepakt mee door het hele huis."
  },
  {
    "ruta": "hitos.14.nota",
    "texto": "Ik boekte de vlucht en mijn handen trilden: het is echt."
  },
  {
    "ruta": "hitos.15.nota",
    "texto": "JR Pass geregeld, drie weken treinen op mijn naam."
  },
  {
    "ruta": "hitos.16.nota",
    "texto": "Overnachtingen betaald: Tokio, Hakone, Kyoto, Osaka, Hiroshima."
  },
  {
    "ruta": "hitos.17.nota",
    "texto": "Ik geef het spaargeld van een heel jaar uit, cent voor cent verdiend."
  },
  {
    "ruta": "hitos.18.nota",
    "texto": "De auto ging kapot en nam mijn hele buffer mee."
  },
  {
    "ruta": "hitos.19.nota",
    "texto": "Fysiotherapie voor mijn knie: duur, maar het was dat of opgeven."
  },
  {
    "ruta": "hitos.20.nota",
    "texto": "Nieuwe banden, want de oude begonnen me angst aan te jagen."
  },
  {
    "ruta": "hitos.21.nota",
    "texto": "Grote beurt voor de auto, het onderhoud dat ik zelf koos."
  },
  {
    "ruta": "hitos.22.nota",
    "texto": "Papierwerk voor de auto, de prijs van het houden van een geliefde roestbak."
  },
  {
    "ruta": "hitos.23.nota",
    "texto": "Eindejaarsuitkering van de koffiebar: direct naar het noodfonds."
  },
  {
    "ruta": "hitos.24.nota",
    "texto": "Cadeaus voor mijn familie, nadat ik voor ze piano speelde."
  },
  {
    "ruta": "hitos.25.nota",
    "texto": "Vaccinaties voor Laika; zij snapt niets van budgetten."
  },
  {
    "ruta": "metas.japon",
    "texto": "De reis naar Japan, drie weken (voltooid)"
  },
  {
    "ruta": "metas.emergencia",
    "texto": "Noodfonds: drie maanden"
  },
  {
    "ruta": "metas.inversion",
    "texto": "CETES: mijn eerste spaargeld dat iets oplevert"
  },
  {
    "ruta": "metas.deuda",
    "texto": "Schuld van de autopech (afbetaald)"
  }
