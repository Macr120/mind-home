  {
    "clave": "ejercicio.ejDesc.press-banca",
    "texto": "Bench üzerinde sırtüstü yatarak barı göğsüne indir, dirseklerini tam uzatana kadar yukarı it."
  },
  {
    "clave": "ejercicio.ejDesc.press-inclinado",
    "texto": "Eğimli bench üzerinde barı veya dambılları press yaparak üst göğsü çalıştır."
  },
  {
    "clave": "ejercicio.ejDesc.press-con-mancuernas",
    "texto": "Sırtüstü yatarak iki dambılı, bardan daha geniş bir hareket açıklığıyla yukarı it."
  },
  {
    "clave": "ejercicio.ejDesc.aperturas-con-mancuernas",
    "texto": "Sırtüstü yatarak kollarını yay çizerek aç ve dirseklerini hafif bükerek birleştir."
  },
  {
    "clave": "ejercicio.ejDesc.cruce-en-polea",
    "texto": "Yüksek makaralar arasında ayakta durarak göğsünü sıkarak ellerini önde birleştir."
  },
  {
    "clave": "ejercicio.ejDesc.fondos-en-paralelas",
    "texto": "Paralel barda asılı durarak gövdeni öne eğip dirseklerini bükerek in, sonra yukarı it."
  },
  {
    "clave": "ejercicio.ejDesc.flexiones",
    "texto": "Yüzükoyun pozisyonda, vücudunu düz tutarak göğsünü yere indir ve yukarı it."
  },
  {
    "clave": "ejercicio.ejDesc.dominadas",
    "texto": "Bardan asılı durarak çenen barın üstüne çıkana kadar vücudunu yukarı çek."
  },
  {
    "clave": "ejercicio.ejDesc.jalon-al-pecho",
    "texto": "Yüksek makarada otururken dirseklerini aşağı iterek barı göğsüne çek."
  },
  {
    "clave": "ejercicio.ejDesc.remo-con-barra",
    "texto": "Sırtın düz kalacak şekilde öne eğilerek barı sırtını sıkarak karnına çek."
  },
  {
    "clave": "ejercicio.ejDesc.remo-con-mancuerna",
    "texto": "Bench üzerine dayanarak gövdeni döndürmeden dambılı yanına çek."
  },
  {
    "clave": "ejercicio.ejDesc.remo-en-polea-baja",
    "texto": "Otururken sırtını dik tutarak kabzayı karnına çek."
  },
  {
    "clave": "ejercicio.ejDesc.pull-over",
    "texto": "Sırtüstü yatarak dambılı başının arkasına indir, sonra göğsünün üstüne geri getir."
  },
  {
    "clave": "ejercicio.ejDesc.face-pull",
    "texto": "Yüz hizasındaki makarada, dirseklerini dışa açarak ipi alnına doğru çek."
  },
  {
    "clave": "ejercicio.ejDesc.hiperextensiones",
    "texto": "Bench üzerinde belini uzatarak gövdeni indir ve tekrar yukarı kaldır."
  },
  {
    "clave": "ejercicio.ejDesc.press-militar",
    "texto": "Ayakta durarak barı omuzlarından başının üstüne doğru it."
  },
  {
    "clave": "ejercicio.ejDesc.press-arnold",
    "texto": "Otururken avuç içlerini içe bakan pozisyondan dışa çevirerek dambılları başının üstüne it."
  },
  {
    "clave": "ejercicio.ejDesc.elevaciones-laterales",
    "texto": "Ayakta durarak dambılları omuz hizasına kadar yanlara kaldır."
  },
  {
    "clave": "ejercicio.ejDesc.elevaciones-frontales",
    "texto": "Ayakta durarak dambılı göz hizasına kadar öne kaldır."
  },
  {
    "clave": "ejercicio.ejDesc.pajaros",
    "texto": "Öne eğilerek arka omuzu çalıştırmak için kollarını yanlara aç."
  },
  {
    "clave": "ejercicio.ejDesc.encogimientos",
    "texto": "Ağırlıkla ayakta durarak omuzlarını kulaklarına doğru kaldır ve kontrollü indir."
  },
  {
    "clave": "ejercicio.ejDesc.curl-con-barra",
    "texto": "Ayakta durarak gövdeni sallamadan barı yukarı bükerek curl yap."
  },
  {
    "clave": "ejercicio.ejDesc.curl-con-mancuernas",
    "texto": "Ayakta ya da oturarak dirseklerini bükerek dambılları tek tek ya da birlikte yukarı kaldır."
  }
]