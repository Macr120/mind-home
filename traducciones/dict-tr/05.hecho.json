[
  {
    "clave": "corazon.gato.noche.1",
    "texto": "Sessiz bir gece. Bozma 🐾"
  },
  {
    "clave": "corazon.gato.rutina.0",
    "texto": "Hey, «{r}» saat {h}’de. Ben kıpırdamıyorum 🐾"
  },
  {
    "clave": "corazon.gato.rutina.1",
    "texto": "«{r}» yaklaşıyor ({h}). Sen yaparsın, ben gözetlerim 🐱"
  },
  {
    "clave": "corazon.gato.generica.0",
    "texto": "Her şey kontrol altında. Şekerlemede kontrol ettim 🐾"
  },
  {
    "clave": "corazon.gato.generica.1",
    "texto": "Hmm. Ev hâlâ ayakta. Rica ederim 🐱"
  },
  {
    "clave": "corazon.perro.manana.0",
    "texto": "Günaydın! Bugün harika bir gün gibi kokuyor! 🐶"
  },
  {
    "clave": "corazon.perro.manana.1",
    "texto": "Sabah oldu! Hadi hadi hadi! 🦴"
  },
  {
    "clave": "corazon.perro.tarde.0",
    "texto": "İş bitirmek için mükemmel bir öğleden sonra! Hav! 🐶"
  },
  {
    "clave": "corazon.perro.tarde.1",
    "texto": "Hâlâ buradayım, her şeyi izliyorum! 🎉"
  },
  {
    "clave": "corazon.perro.noche.0",
    "texto": "Ne harika bir gün geçirdik! Değil mi? Değil mi? 🐶"
  },
  {
    "clave": "corazon.perro.noche.1",
    "texto": "Sessiz bir gece… Nöbeti ben tutarım! 🦴"
  },
  {
    "clave": "corazon.perro.rutina.0",
    "texto": "«{r}» saat {h}’de! Yaparsın! 🎉"
  },
  {
    "clave": "corazon.perro.rutina.1",
    "texto": "Sakın unutma: «{r}», saat {h}’de! Hav! 🐶"
  },
  {
    "clave": "corazon.perro.generica.0",
    "texto": "Bu evi seviyorum! 🐶"
  },
  {
    "clave": "corazon.perro.generica.1",
    "texto": "Bir şeye ihtiyacın olursa beni çağır! Her şey için! 🦴"
  },
  {
    "clave": "corazon.buho.manana.0",
    "texto": "Şafak. Günü sakince planlamak için ideal. 🦉"
  },
  {
    "clave": "corazon.buho.manana.1",
    "texto": "Düzenli bir sabah iki katı verim getirir."
  },
  {
    "clave": "corazon.buho.tarde.0",
    "texto": "Öğle vakti: ilerlemeyi gözden geçirmek için iyi bir an. 🦉"
  },
  {
    "clave": "corazon.buho.tarde.1",
    "texto": "Öğleden sonra plana göre ilerliyor."
  },
  {
    "clave": "corazon.buho.noche.0",
    "texto": "Gece çöküyor. Günü bir notla kapatmanı öneririm. 🦉"
  },
  {
    "clave": "corazon.buho.noche.1",
    "texto": "Gece, düşünmeye davet eder."
  },
  {
    "clave": "corazon.buho.rutina.0",
    "texto": "Zamanında uyarı: «{r}» saat {h}’de. 🦉"
  },
  {
    "clave": "corazon.buho.rutina.1",
    "texto": "Zaman çizelgende «{r}» saat {h}’de yer alıyor."
  },
  {
    "clave": "corazon.buho.generica.0",
    "texto": "Gözlemliyor ve not ediyorum. Her şey yolunda. 🦉"
  },
  {
    "clave": "corazon.buho.generica.1",
    "texto": "Bilgi gün geçtikçe birikir."
  },
  {
    "clave": "corazon.robot.manana.0",
    "texto": "☀ GÜN DÖNGÜSÜ BAŞLADI. SİSTEMLER %100. 🤖"
  },
  {
    "clave": "corazon.robot.manana.1",
    "texto": "GÜNAYDIN. PİL DOLU. ✓"
  },
  {
    "clave": "corazon.robot.tarde.0",
    "texto": "ÖĞLEDEN SONRA TARAMASI TAMAMLANDI. ANOMALİ YOK. ✓"
  },
  {
    "clave": "corazon.robot.tarde.1",
    "texto": "VERİMLİLİK PARAMETRELER İÇİNDE. 🤖"
  },
  {
    "clave": "corazon.robot.noche.0",
    "texto": "GECE MODU AKTİF. NÖBET SÜRÜYOR. 🤖"
  },
  {
    "clave": "corazon.robot.noche.1",
    "texto": "ÖNERİ: İNSAN BİRİMİNİ ŞARJ ET (UYKU). ✓"
  },
  {
    "clave": "corazon.robot.rutina.0",
    "texto": "HATIRLATMA: «{r}» SAAT {h} İÇİN PLANLANDI. ✓"
  },
  {
    "clave": "corazon.robot.rutina.1",
    "texto": "UYARI: «{r}» SAAT {h}’DE. 🤖"
  },
  {
    "clave": "corazon.robot.generica.0",
    "texto": "TÜM SİSTEMLER NORMAL. 🤖"
  },
  {
    "clave": "corazon.robot.generica.1",
    "texto": "TALİMAT BEKLENİYOR. ACİL DEĞİL. ✓"
  },
