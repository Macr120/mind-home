[
  {
    "clave": "corazon.gato.noche.1",
    "texto": "Notte tranquilla. Non rovinarla 🐾"
  },
  {
    "clave": "corazon.gato.rutina.0",
    "texto": "Ehi, “{r}” è alle {h}. Io non mi muovo 🐾"
  },
  {
    "clave": "corazon.gato.rutina.1",
    "texto": "“{r}” sta per arrivare ({h}). Ce la fai; io supervisiono 🐱"
  },
  {
    "clave": "corazon.gato.generica.0",
    "texto": "Tutto sotto controllo. Ho controllato mentre facevo un pisolino 🐾"
  },
  {
    "clave": "corazon.gato.generica.1",
    "texto": "Hmm. La casa è ancora in piedi. Prego 🐱"
  },
  {
    "clave": "corazon.perro.manana.0",
    "texto": "Buongiorno! Oggi si respira una grande giornata! 🐶"
  },
  {
    "clave": "corazon.perro.manana.1",
    "texto": "È mattina! Andiamo andiamo andiamo! 🦴"
  },
  {
    "clave": "corazon.perro.tarde.0",
    "texto": "Il pomeriggio perfetto per sbrigare le cose! Bau! 🐶"
  },
  {
    "clave": "corazon.perro.tarde.1",
    "texto": "Ancora qui, a guardare tutto! 🎉"
  },
  {
    "clave": "corazon.perro.noche.0",
    "texto": "Che bella giornata abbiamo avuto! Vero? Vero? 🐶"
  },
  {
    "clave": "corazon.perro.noche.1",
    "texto": "Notte tranquilla… io monto la guardia! 🦴"
  },
  {
    "clave": "corazon.perro.rutina.0",
    "texto": "“{r}” alle {h}! Ce la puoi fare! 🎉"
  },
  {
    "clave": "corazon.perro.rutina.1",
    "texto": "Non dimenticare “{r}” alle {h}! Bau! 🐶"
  },
  {
    "clave": "corazon.perro.generica.0",
    "texto": "Amo questa casa! 🐶"
  },
  {
    "clave": "corazon.perro.generica.1",
    "texto": "Chiamami se hai bisogno di qualcosa! Qualsiasi cosa! 🦴"
  },
  {
    "clave": "corazon.buho.manana.0",
    "texto": "Alba. Ideale per pianificare la giornata con calma. 🦉"
  },
  {
    "clave": "corazon.buho.manana.1",
    "texto": "Una mattina ordinata rende il doppio."
  },
  {
    "clave": "corazon.buho.tarde.0",
    "texto": "Mezzogiorno: un buon momento per rivedere i progressi. 🦉"
  },
  {
    "clave": "corazon.buho.tarde.1",
    "texto": "Il pomeriggio procede come previsto."
  },
  {
    "clave": "corazon.buho.noche.0",
    "texto": "Cala la notte. Suggerisco di chiudere la giornata con un appunto. 🦉"
  },
  {
    "clave": "corazon.buho.noche.1",
    "texto": "La notte invita alla riflessione."
  },
  {
    "clave": "corazon.buho.rutina.0",
    "texto": "Avviso puntuale: “{r}” alle {h}. 🦉"
  },
  {
    "clave": "corazon.buho.rutina.1",
    "texto": "Il tuo programma indica “{r}” alle {h}."
  },
  {
    "clave": "corazon.buho.generica.0",
    "texto": "Osservo e prendo nota. Tutto in ordine. 🦉"
  },
  {
    "clave": "corazon.buho.generica.1",
    "texto": "La conoscenza si accumula giorno dopo giorno."
  },
  {
    "clave": "corazon.robot.manana.0",
    "texto": "☀ CICLO GIORNALIERO AVVIATO. SISTEMI AL 100%. 🤖"
  },
  {
    "clave": "corazon.robot.manana.1",
    "texto": "BUONGIORNO. BATTERIA CARICA. ✓"
  },
  {
    "clave": "corazon.robot.tarde.0",
    "texto": "SCANSIONE POMERIDIANA COMPLETATA. NESSUNA ANOMALIA. ✓"
  },
  {
    "clave": "corazon.robot.tarde.1",
    "texto": "PRODUTTIVITÀ NEI PARAMETRI. 🤖"
  },
  {
    "clave": "corazon.robot.noche.0",
    "texto": "MODALITÀ NOTTURNA ATTIVA. SORVEGLIANZA IN CORSO. 🤖"
  },
  {
    "clave": "corazon.robot.noche.1",
    "texto": "RACCOMANDAZIONE: RICARICARE UNITÀ UMANA (DORMIRE). ✓"
  },
  {
    "clave": "corazon.robot.rutina.0",
    "texto": "PROMEMORIA: “{r}” PROGRAMMATO ALLE {h}. ✓"
  },
  {
    "clave": "corazon.robot.rutina.1",
    "texto": "ALLERTA: “{r}” ALLE {h}. 🤖"
  },
  {
    "clave": "corazon.robot.generica.0",
    "texto": "TUTTI I SISTEMI NOMINALI. 🤖"
  },
  {
    "clave": "corazon.robot.generica.1",
    "texto": "IN ATTESA DI ISTRUZIONI. NON URGENTE. ✓"
  },
