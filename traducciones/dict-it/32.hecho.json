  {"clave": "mascota.mago.saludo", "texto": "Sono il tuo architetto arcano. Raccontami cosa hai fatto e lo trascriverò ✨"},
  {"clave": "mascota.gato.saludo", "texto": "Miao. Dimmi le tue cose e vedrò dove metterle 🐾"},
  {"clave": "mascota.perro.saludo", "texto": "Bau! Dimmi cosa hai fatto e lo salvo subito! 🦴"},
  {"clave": "mascota.buho.saludo", "texto": "Saggio e attento. Racconta la tua giornata e la organizzerò."},
  {"clave": "mascota.robot.saludo", "texto": "Sistema pronto. Inserisci un dato da elaborare."},
  {"clave": "mascota.bitacora", "texto": "il diario di bordo"},
  {"clave": "mascota.elObjeto", "texto": "l'oggetto"},
  {"clave": "mascota.mago.capturado.0", "texto": "✨ Fatto. Ho trascritto la voce in {c}."},
  {"clave": "mascota.mago.capturado.1", "texto": "Così sarà: annotato in {c} nei minimi dettagli ✨"},
  {"clave": "mascota.mago.clasificado.0", "texto": "📜 Ho custodito la tua pergamena nel registro di {c}."},
  {"clave": "mascota.mago.clasificado.1", "texto": "L'ho lasciata riposare in {c}."},
  {"clave": "mascota.mago.sinClasificar.0", "texto": "L'ho salvato, ma non so a quale stanza appartenga… mi guidi tu? 🔮"},
  {"clave": "mascota.mago.sinClasificar.1", "texto": "Non classificato per ora. In quale stanza lo porto?"},
  {"clave": "mascota.mago.agregar.0", "texto": "🪄 Ho materializzato {c} nella tua casa."},
  {"clave": "mascota.mago.agregar.1", "texto": "{c} appare sulla mappa, evocato per magia ✨"},
  {"clave": "mascota.mago.quitar.0", "texto": "🪄 {c} svanisce dalla mappa."},
  {"clave": "mascota.mago.quitar.1", "texto": "Ho rimosso {c} dalla tua casa."},
  {"clave": "mascota.mago.objeto.0", "texto": "🪄 Ho evocato il tuo {o} in {c}. ✨"},
  {"clave": "mascota.mago.objeto.1", "texto": "Fai apparire il tuo {o}… fatto, in {c}!"},
  {"clave": "mascota.mago.recordado.0", "texto": "🧠 L'ho inciso nel mio grimorio. Non lo dimenticherò ✨"},
  {"clave": "mascota.mago.recordado.1", "texto": "Memorizzato. La mia memoria arcana è eterna 🔮"},
  {"clave": "mascota.gato.capturado.0", "texto": "Mmm, va bene. L'ho messo in {c}, immagino 🐾"},
  {"clave": "mascota.gato.capturado.1", "texto": "Fatto, l'ho registrato in {c}. Non ringraziarmi."},
  {"clave": "mascota.gato.clasificado.0", "texto": "L'ho lasciato nel registro di {c}. Resta lì 🐱"},
  {"clave": "mascota.gato.clasificado.1", "texto": "Annotato in {c}, tutto qui."},
  {"clave": "mascota.gato.sinClasificar.0", "texto": "Nessuna idea di dove metterlo. L'ho lasciato non classificato 🐾"},
  {"clave": "mascota.gato.sinClasificar.1", "texto": "Pfft, a quale stanza appartiene? Dimmelo tu."},
  {"clave": "mascota.gato.agregar.0", "texto": "Ok, ho messo {c} sulla mappa. Tanto mi annoiavo 🐱"},
  {"clave": "mascota.gato.agregar.1", "texto": "Ho aggiunto {c}. Congratulazioni, immagino."},
  {"clave": "mascota.gato.quitar.0", "texto": "Rimosso {c}. Una cosa in meno da pulire 🐾"},
  {"clave": "mascota.gato.quitar.1", "texto": "{c}, sparito. Fatto."},
  {"clave": "mascota.gato.objeto.0", "texto": "Ecco il tuo {o}, in {c}. Non romperlo 🐾"},
  {"clave": "mascota.gato.objeto.1", "texto": "Ho messo il tuo {o} in {c}. Ora fammi dormire 🐱"},
  {"clave": "mascota.gato.recordado.0", "texto": "Va bene, me lo ricorderò. Ho buona memoria, che tu ci creda o no 🐱"},
  {"clave": "mascota.gato.recordado.1", "texto": "Annotato nella mia memoria. Non aspettarti che lo ripeta 🐾"},
  {"clave": "mascota.perro.capturado.0", "texto": "Bau! L'ho registrato in {c}! 🐶"},
  {"clave": "mascota.perro.capturado.1", "texto": "Tutto fatto! Salvato in {c}! 🦴"},
  {"clave": "mascota.perro.clasificado.0", "texto": "L'ho salvato nel registro di {c}! 🐶"},
  {"clave": "mascota.perro.clasificado.1", "texto": "Annotato in {c}! Altro?"},
  {"clave": "mascota.perro.sinClasificar.0", "texto": "L'ho salvato! Ma non so in quale stanza metterlo… mi aiuti? 🐶"},
  {"clave": "mascota.perro.sinClasificar.1", "texto": "Fatto! In quale stanza lo porto, amico?"},
  {"clave": "mascota.perro.agregar.0", "texto": "BAU! Ho aggiunto {c} alla mappa! 🎉"},
  {"clave": "mascota.perro.agregar.1", "texto": "{c} è già nella tua casa! 🐶"},
  {"clave": "mascota.perro.quitar.0", "texto": "Ho rimosso {c} dalla mappa. Fatto! 🐾"},
  {"clave": "mascota.perro.quitar.1", "texto": "Fatto! {c} non è più sulla mappa."},
  {"clave": "mascota.perro.objeto.0", "texto": "BAU! Ho creato il tuo {o} in {c}! 🎉"},
  {"clave": "mascota.perro.objeto.1", "texto": "Guarda, il tuo {o}! L'ho lasciato in {c} 🐶"},
  {"clave": "mascota.perro.recordado.0", "texto": "Me lo ricorderò PER SEMPRE! 🐶"},
  {"clave": "mascota.perro.recordado.1", "texto": "Bau! Ricordo salvato, non dimenticherò! 🦴"},
  {"clave": "mascota.buho.capturado.0", "texto": "Registrato in {c} con precisione."},
  {"clave": "mascota.buho.capturado.1", "texto": "Annotato ed elaborato in {c}. 🦉"},
