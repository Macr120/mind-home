  {"clave": "mascota.buho.objeto.0", "texto": "Ho collocato il tuo {o} in {c}. 🦉"},
  {"clave": "mascota.buho.objeto.1", "texto": "Il tuo {o} ora è in {c}."},
  {"clave": "mascota.buho.recordado.0", "texto": "Memorizzato con precisione. 🦉"},
  {"clave": "mascota.buho.recordado.1", "texto": "L'ho aggiunto a ciò che so di te."},
  {"clave": "mascota.robot.capturado.0", "texto": "✓ VOCE CREATA IN {c}."},
