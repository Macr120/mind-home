  {"clave": "mascota.buho.clasificado.1", "texto": "L'ho archiviato sotto {c}."},
  {"clave": "mascota.buho.sinClasificar.0", "texto": "Salvato non classificato. Fammi sapere la stanza quando puoi. 🦉"},
  {"clave": "mascota.buho.sinClasificar.1", "texto": "Non riesco a identificare la stanza. Qual è quella giusta?"},
  {"clave": "mascota.buho.agregar.0", "texto": "{c} aggiunto alla mappa."},
  {"clave": "mascota.buho.agregar.1", "texto": "Ho incorporato {c} nella tua casa. 🦉"},
  {"clave": "mascota.buho.quitar.0", "texto": "{c} rimosso dalla mappa."},
