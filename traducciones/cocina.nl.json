[
  { "ruta": "recetas.0.nombre", "texto": "Overnight oats" },
  { "ruta": "recetas.0.carpeta", "texto": "Hardloper" },
  { "ruta": "recetas.0.ingredientes.0", "texto": "60 g havermout" },
  { "ruta": "recetas.0.ingredientes.1", "texto": "150 ml melk (of havermelk)" },
  { "ruta": "recetas.0.ingredientes.2", "texto": "100 g Griekse yoghurt naturel" },
  { "ruta": "recetas.0.ingredientes.3", "texto": "1 eetlepel chiazaad (12 g)" },
  { "ruta": "recetas.0.ingredientes.4", "texto": "1 rijpe banaan" },
  { "ruta": "recetas.0.ingredientes.5", "texto": "1 theelepel honing" },
  { "ruta": "recetas.0.ingredientes.6", "texto": "1 snufje kaneel" },
  { "ruta": "recetas.0.ingredientes.7", "texto": "1 snufje zout" },
  { "ruta": "recetas.0.pasos.0", "texto": "Meng in een glazen pot de havermout, chiazaad, kaneel en het zout." },
  { "ruta": "recetas.0.pasos.1", "texto": "Voeg de melk en de yoghurt toe en roer tot er geen droge klontjes meer zijn." },
  { "ruta": "recetas.0.pasos.2", "texto": "Prak een halve banaan met een vork en meng die erdoor; bewaar de andere helft in de koelkast." },
  { "ruta": "recetas.0.pasos.3", "texto": "Doe het deksel erop en zet 6 tot 10 uur in de koelkast." },
  { "ruta": "recetas.0.pasos.4", "texto": "Werk 's ochtends af met de rest van de banaan in plakjes en de honing. Eet het 90 minuten voordat je gaat hardlopen." },
  { "ruta": "recetas.1.nombre", "texto": "Koolhydraatpasta voor de avond ervoor" },
  { "ruta": "recetas.1.carpeta", "texto": "Hardloper" },
  { "ruta": "recetas.1.ingredientes.0", "texto": "200 g spaghetti" },
  { "ruta": "recetas.1.ingredientes.1", "texto": "400 g gepureerde tomaten" },
  { "ruta": "recetas.1.ingredientes.2", "texto": "2 teentjes knoflook" },
  { "ruta": "recetas.1.ingredientes.3", "texto": "2 eetlepels olijfolie" },
  { "ruta": "recetas.1.ingredientes.4", "texto": "1 theelepel gedroogde oregano" },
  { "ruta": "recetas.1.ingredientes.5", "texto": "1 theelepel suiker" },
  { "ruta": "recetas.1.ingredientes.6", "texto": "40 g geraspte Parmezaanse kaas" },
  { "ruta": "recetas.1.ingredientes.7", "texto": "6 blaadjes verse basilicum" },
  { "ruta": "recetas.1.ingredientes.8", "texto": "Zout" },
  { "ruta": "recetas.1.pasos.0", "texto": "Breng een grote pan met ruim water en zout aan de kook." },
  { "ruta": "recetas.1.pasos.1", "texto": "Bak ondertussen de in plakjes gesneden knoflook 2 minuten op middellaag vuur goudbruin in de olie, zonder dat hij verbrandt." },
  { "ruta": "recetas.1.pasos.2", "texto": "Voeg de tomaten, oregano, suiker en een snufje zout toe; laat 15 minuten zachtjes sudderen." },
  { "ruta": "recetas.1.pasos.3", "texto": "Kook de pasta één minuut korter dan op de verpakking staat en bewaar een half glas kookvocht." },
  { "ruta": "recetas.1.pasos.4", "texto": "Schep de pasta 1 minuut door de saus met een scheutje van het bewaarde kookvocht." },
  { "ruta": "recetas.1.pasos.5", "texto": "Serveer met de Parmezaanse kaas en de basilicum. Lichte avondmaaltijd, weinig vet en niet pittig: morgen is de wedstrijd." },
  { "ruta": "recetas.2.nombre", "texto": "Kipbowl voor de hele week" },
  { "ruta": "recetas.2.ingredientes.0", "texto": "600 g kipfilet" },
  { "ruta": "recetas.2.ingredientes.1", "texto": "300 g zilvervliesrijst (ongekookt)" },
  { "ruta": "recetas.2.ingredientes.2", "texto": "400 g zoete aardappel in blokjes" },
  { "ruta": "recetas.2.ingredientes.3", "texto": "400 g broccoliroosjes" },
  { "ruta": "recetas.2.ingredientes.4", "texto": "3 eetlepels olijfolie" },
  { "ruta": "recetas.2.ingredientes.5", "texto": "1 theelepel zoete paprikapoeder" },
  { "ruta": "recetas.2.ingredientes.6", "texto": "1 theelepel gemalen komijn" },
  { "ruta": "recetas.2.ingredientes.7", "texto": "200 g Griekse yoghurt naturel" },
  { "ruta": "recetas.2.ingredientes.8", "texto": "1 citroen" },
  { "ruta": "recetas.2.ingredientes.9", "texto": "Zout en peper" },
  { "ruta": "recetas.2.pasos.0", "texto": "Verwarm de oven voor op 200 °C." },
  { "ruta": "recetas.2.pasos.1", "texto": "Meng de zoete aardappel met 1 eetlepel olie, zout en peper; bak 25 minuten in de oven." },
  { "ruta": "recetas.2.pasos.2", "texto": "Breng de kip op smaak met zout en peper, wrijf in met de paprikapoeder, komijn en 1 eetlepel olie en bak 6 minuten per kant in een grillpan. Laat 5 minuten rusten en snijd in reepjes." },
  { "ruta": "recetas.2.pasos.3", "texto": "Kook de zilvervliesrijst 25 minuten in gezouten water en giet af." },
  { "ruta": "recetas.2.pasos.4", "texto": "Stoom de broccoli 5 minuten: hij moet stevig blijven, zodat hij het houdt tot donderdag." },
  { "ruta": "recetas.2.pasos.5", "texto": "Klop de yoghurt los met het sap van een halve citroen, zout en de resterende eetlepel olie." },
  { "ruta": "recetas.2.pasos.6", "texto": "Verdeel alles over vier bakjes en bewaar de saus apart. Blijft vier dagen goed in de koelkast." },
  { "ruta": "recetas.3.nombre", "texto": "Thuisgemaakte Japanse curry" },
  { "ruta": "recetas.3.carpeta", "texto": "Uit Japan" },
  { "ruta": "recetas.3.ingredientes.0", "texto": "500 g kippendij in blokjes" },
  { "ruta": "recetas.3.ingredientes.1", "texto": "2 uien in dunne halve ringen" },
  { "ruta": "recetas.3.ingredientes.2", "texto": "2 wortels in dikke plakken" },
  { "ruta": "recetas.3.ingredientes.3", "texto": "400 g aardappel in blokjes" },
  { "ruta": "recetas.3.ingredientes.4", "texto": "40 g boter" },
  { "ruta": "recetas.3.ingredientes.5", "texto": "40 g bloem" },
  { "ruta": "recetas.3.ingredientes.6", "texto": "2 eetlepels currypoeder" },
  { "ruta": "recetas.3.ingredientes.7", "texto": "1 theelepel garam masala" },
  { "ruta": "recetas.3.ingredientes.8", "texto": "1 eetlepel sojasaus" },
  { "ruta": "recetas.3.ingredientes.9", "texto": "1 theelepel honing" },
  { "ruta": "recetas.3.ingredientes.10", "texto": "700 ml kippenbouillon" },
  { "ruta": "recetas.3.ingredientes.11", "texto": "1 eetlepel olie" },
  { "ruta": "recetas.3.ingredientes.12", "texto": "300 g kortkorrelige rijst (ongekookt)" },
  { "ruta": "recetas.3.pasos.0", "texto": "Maak de roux: smelt de boter, voeg de bloem toe en roer 5 minuten op laag vuur tot de kleur van hazelnoot. Voeg de curry en garam masala toe, roer 1 minuut en haal van het vuur." },
  { "ruta": "recetas.3.pasos.1", "texto": "Bak de kip in een pan met de olie bruin en haal eruit." },
  { "ruta": "recetas.3.pasos.2", "texto": "Fruit de ui 8 minuten tot hij goudbruin is; voeg de wortel en aardappel toe en bak 2 minuten mee." },
  { "ruta": "recetas.3.pasos.3", "texto": "Voeg de kip weer toe, giet de bouillon erbij en laat 20 minuten sudderen op middelhoog vuur." },
  { "ruta": "recetas.3.pasos.4", "texto": "Los de roux op met een schep hete bouillon en giet hem in de pan. Kook nog 5 minuten al roerend tot het indikt." },
  { "ruta": "recetas.3.pasos.5", "texto": "Voeg de sojasaus en honing toe, proef of er zout bij moet en serveer op vers gekookte rijst." },
  { "ruta": "recetas.4.nombre", "texto": "Snelle misoramen" },
  { "ruta": "recetas.4.carpeta", "texto": "Uit Japan" },
  { "ruta": "recetas.4.ingredientes.0", "texto": "200 g gedroogde ramennoedels" },
  { "ruta": "recetas.4.ingredientes.1", "texto": "900 ml kippenbouillon" },
  { "ruta": "recetas.4.ingredientes.2", "texto": "2 eetlepels misopasta" },
  { "ruta": "recetas.4.ingredientes.3", "texto": "1 eetlepel sojasaus" },
  { "ruta": "recetas.4.ingredientes.4", "texto": "1 theelepel sesamolie" },
  { "ruta": "recetas.4.ingredientes.5", "texto": "2 teentjes knoflook, fijngehakt" },
  { "ruta": "recetas.4.ingredientes.6", "texto": "10 g geraspte gember" },
  { "ruta": "recetas.4.ingredientes.7", "texto": "200 g buikspek of kip in reepjes" },
  { "ruta": "recetas.4.ingredientes.8", "texto": "2 eieren" },
  { "ruta": "recetas.4.ingredientes.9", "texto": "100 g suikermaïs" },
  { "ruta": "recetas.4.ingredientes.10", "texto": "2 lente-uitjes in ringetjes" },
  { "ruta": "recetas.4.ingredientes.11", "texto": "1 vel nori" },
  { "ruta": "recetas.4.pasos.0", "texto": "Kook de eieren 6 minuten en 30 seconden, koel ze af in ijswater en pel ze." },
  { "ruta": "recetas.4.pasos.1", "texto": "Bak het buikspek of de kip bruin in een pan met de sesamolie; voeg de knoflook en gember toe en bak 1 minuut mee." },
  { "ruta": "recetas.4.pasos.2", "texto": "Giet de bouillon erbij en laat 15 minuten zachtjes koken. Haal van het vuur." },
  { "ruta": "recetas.4.pasos.3", "texto": "Los de miso op in een soeplepel bouillon en giet terug in de pan samen met de sojasaus. Laat het niet meer koken." },
  { "ruta": "recetas.4.pasos.4", "texto": "Kook de noedels apart volgens de verpakking en giet ze goed af." },
  { "ruta": "recetas.4.pasos.5", "texto": "Vul de kommen: noedels, bouillon, vlees, maïs, het ei doormidden gesneden, lente-ui en nori." },
  { "ruta": "recetas.5.nombre", "texto": "Bananenbrood van de koffiezaak" },
  { "ruta": "recetas.5.carpeta", "texto": "Zoet" },
  { "ruta": "recetas.5.ingredientes.0", "texto": "3 zeer rijpe bananen (350 g gepeld)" },
  { "ruta": "recetas.5.ingredientes.1", "texto": "2 eieren" },
  { "ruta": "recetas.5.ingredientes.2", "texto": "80 g bruine suiker" },
  { "ruta": "recetas.5.ingredientes.3", "texto": "60 ml zonnebloemolie" },
  { "ruta": "recetas.5.ingredientes.4", "texto": "220 g tarwebloem" },
  { "ruta": "recetas.5.ingredientes.5", "texto": "1 theelepel bakpoeder" },
  { "ruta": "recetas.5.ingredientes.6", "texto": "1/2 theelepel zuiveringszout" },
  { "ruta": "recetas.5.ingredientes.7", "texto": "1 theelepel kaneel" },
  { "ruta": "recetas.5.ingredientes.8", "texto": "1/2 theelepel zout" },
  { "ruta": "recetas.5.ingredientes.9", "texto": "60 g gehakte walnoten" },
  { "ruta": "recetas.5.pasos.0", "texto": "Verwarm de oven voor op 175 °C en bekleed een cakevorm van 22 cm met bakpapier." },
  { "ruta": "recetas.5.pasos.1", "texto": "Prak de bananen met een vork tot een grove puree." },
  { "ruta": "recetas.5.pasos.2", "texto": "Klop de eieren met de suiker en de olie en meng de bananenpuree erdoor." },
  { "ruta": "recetas.5.pasos.3", "texto": "Meng in een aparte kom de bloem, het bakpoeder, zuiveringszout, kaneel en zout." },
  { "ruta": "recetas.5.pasos.4", "texto": "Spatel de droge en natte ingrediënten door elkaar zonder te veel te roeren en voeg de walnoten toe." },
  { "ruta": "recetas.5.pasos.5", "texto": "Giet het beslag in de vorm en bak 50-55 minuten, tot een satéprikker er schoon uit komt." },
  { "ruta": "recetas.5.pasos.6", "texto": "Haal uit de vorm en laat afkoelen op een rooster. In tien plakken gesneden blijft het drie dagen goed in papier." },
  { "ruta": "recetas.6.nombre", "texto": "Romige rode linzensoep" },
  { "ruta": "recetas.6.ingredientes.0", "texto": "250 g rode linzen" },
  { "ruta": "recetas.6.ingredientes.1", "texto": "1 ui, fijngesneden" },
  { "ruta": "recetas.6.ingredientes.2", "texto": "2 wortels in blokjes" },
  { "ruta": "recetas.6.ingredientes.3", "texto": "2 teentjes knoflook" },
  { "ruta": "recetas.6.ingredientes.4", "texto": "1 theelepel gemalen komijn" },
  { "ruta": "recetas.6.ingredientes.5", "texto": "1 theelepel kurkuma" },
  { "ruta": "recetas.6.ingredientes.6", "texto": "1 liter groentebouillon" },
  { "ruta": "recetas.6.ingredientes.7", "texto": "2 eetlepels olijfolie" },
  { "ruta": "recetas.6.ingredientes.8", "texto": "100 ml kokosmelk" },
  { "ruta": "recetas.6.ingredientes.9", "texto": "1 citroen" },
  { "ruta": "recetas.6.ingredientes.10", "texto": "Zout en peper" },
  { "ruta": "recetas.6.pasos.0", "texto": "Fruit de ui en wortel 8 minuten in de olie met een snufje zout." },
  { "ruta": "recetas.6.pasos.1", "texto": "Voeg de fijngehakte knoflook, komijn en kurkuma toe en roer 1 minuut." },
  { "ruta": "recetas.6.pasos.2", "texto": "Spoel de linzen af, voeg ze samen met de bouillon toe en breng aan de kook." },
  { "ruta": "recetas.6.pasos.3", "texto": "Laat 20 minuten sudderen op middellaag vuur, af en toe roerend." },
  { "ruta": "recetas.6.pasos.4", "texto": "Pureer met de staafmixer, voeg de kokosmelk en het sap van een halve citroen toe en breng verder op smaak met zout." },
  { "ruta": "recetas.6.pasos.5", "texto": "Verdeel over bakjes; vriest goed in per portie." },
  { "ruta": "recetas.7.nombre", "texto": "Teriyakizalm met spinazie" },
  { "ruta": "recetas.7.carpeta", "texto": "Uit Japan" },
  { "ruta": "recetas.7.ingredientes.0", "texto": "2 zalmfilets van 150 g" },
  { "ruta": "recetas.7.ingredientes.1", "texto": "3 eetlepels sojasaus" },
  { "ruta": "recetas.7.ingredientes.2", "texto": "2 eetlepels mirin" },
  { "ruta": "recetas.7.ingredientes.3", "texto": "1 eetlepel suiker" },
  { "ruta": "recetas.7.ingredientes.4", "texto": "1 theelepel geraspte gember" },
  { "ruta": "recetas.7.ingredientes.5", "texto": "1 theelepel maizena" },
  { "ruta": "recetas.7.ingredientes.6", "texto": "1 eetlepel olie" },
  { "ruta": "recetas.7.ingredientes.7", "texto": "150 g kortkorrelige rijst (ongekookt)" },
  { "ruta": "recetas.7.ingredientes.8", "texto": "200 g verse spinazie" },
  { "ruta": "recetas.7.ingredientes.9", "texto": "1 theelepel sesamzaad" },
  { "ruta": "recetas.7.pasos.0", "texto": "Zet de rijst op volgens de verpakking." },
  { "ruta": "recetas.7.pasos.1", "texto": "Meng de sojasaus, mirin, suiker, gember en maizena in een glas." },
  { "ruta": "recetas.7.pasos.2", "texto": "Dep de zalm goed droog en bak hem met de velkant naar beneden 4 minuten in de olie." },
  { "ruta": "recetas.7.pasos.3", "texto": "Draai om, bak nog 2 minuten en giet de saus erbij; laat 2 minuten indikken en schep de saus over de vis." },
  { "ruta": "recetas.7.pasos.4", "texto": "Bak de spinazie 2 minuten in dezelfde pan, naast de zalm, met een snufje zout." },
  { "ruta": "recetas.7.pasos.5", "texto": "Serveer op de rijst met de saus erover en het sesamzaad." },
  { "ruta": "recetas.8.nombre", "texto": "Rokerige linzentaco's" },
  { "ruta": "recetas.8.ingredientes.0", "texto": "400 g gekookte bruine linzen, uitgelekt" },
  { "ruta": "recetas.8.ingredientes.1", "texto": "1 ui, fijngesneden" },
  { "ruta": "recetas.8.ingredientes.2", "texto": "1 rode paprika in blokjes" },
  { "ruta": "recetas.8.ingredientes.3", "texto": "2 teentjes knoflook" },
  { "ruta": "recetas.8.ingredientes.4", "texto": "1 theelepel komijn" },
  { "ruta": "recetas.8.ingredientes.5", "texto": "1 theelepel gerookte paprikapoeder" },
  { "ruta": "recetas.8.ingredientes.6", "texto": "200 g gepureerde tomaten" },
  { "ruta": "recetas.8.ingredientes.7", "texto": "2 eetlepels olijfolie" },
  { "ruta": "recetas.8.ingredientes.8", "texto": "8 maïstortilla's" },
  { "ruta": "recetas.8.ingredientes.9", "texto": "1 avocado" },
  { "ruta": "recetas.8.ingredientes.10", "texto": "1 limoen" },
  { "ruta": "recetas.8.ingredientes.11", "texto": "Verse koriander" },
  { "ruta": "recetas.8.ingredientes.12", "texto": "100 g yoghurt naturel" },
  { "ruta": "recetas.8.ingredientes.13", "texto": "Zout" },
  { "ruta": "recetas.8.pasos.0", "texto": "Fruit de ui en paprika 8 minuten in de olie." },
  { "ruta": "recetas.8.pasos.1", "texto": "Voeg de knoflook, komijn en gerookte paprikapoeder toe en roer 1 minuut." },
  { "ruta": "recetas.8.pasos.2", "texto": "Voeg de tomaten en linzen toe en laat 10 minuten sudderen; druk er af en toe wat van plat met de lepel zodat het bindt." },
  { "ruta": "recetas.8.pasos.3", "texto": "Breng op smaak met zout en voeg het sap van een halve limoen toe." },
  { "ruta": "recetas.8.pasos.4", "texto": "Verwarm de tortilla's 30 seconden per kant in een droge koekenpan." },
  { "ruta": "recetas.8.pasos.5", "texto": "Vul met de linzen, de avocado in plakjes, de yoghurt en de koriander. Twee taco's per persoon." },
  { "ruta": "recetas.9.nombre", "texto": "Herstelsmoothie" },
  { "ruta": "recetas.9.carpeta", "texto": "Hardloper" },
  { "ruta": "recetas.9.ingredientes.0", "texto": "1 bevroren banaan in plakjes" },
  { "ruta": "recetas.9.ingredientes.1", "texto": "200 ml melk" },
  { "ruta": "recetas.9.ingredientes.2", "texto": "150 g Griekse yoghurt naturel" },
  { "ruta": "recetas.9.ingredientes.3", "texto": "100 g bevroren rood fruit" },
  { "ruta": "recetas.9.ingredientes.4", "texto": "1 eetlepel pindakaas (16 g)" },
  { "ruta": "recetas.9.ingredientes.5", "texto": "1 theelepel pure cacaopoeder" },
  { "ruta": "recetas.9.ingredientes.6", "texto": "1 snufje zout" },
  { "ruta": "recetas.9.pasos.0", "texto": "Doe alles in de blender, vloeistoffen eerst." },
  { "ruta": "recetas.9.pasos.1", "texto": "Blend 45 seconden tot het romig is; te dik? Voeg een scheutje melk toe." },
  { "ruta": "recetas.9.pasos.2", "texto": "Drink het binnen 30 minuten na de lange training, rechtstreeks uit de blenderbeker om minder af te hoeven wassen." },
  { "ruta": "dietas.0.nombre", "texto": "Marathonweek" },
  { "ruta": "dietas.0.descripcion", "texto": "De zeven dagen voor de wedstrijd. Van maandag tot donderdag eet ik zoals altijd (kipbowl uit de batch van zondag, havermout voor de rustige duurlopen); van vrijdag tot zaterdag verhoog ik de koolhydraten en verlaag ik vezels en vet. De avond ervoor pasta met tomaat en geen experimenten. De smoothie is voor het halfuur na de finish, samen met het stuk bananenbrood dat ik donderdag al had gebakken." },
  { "ruta": "dietas.0.recetas.0", "texto": "Overnight oats" },
  { "ruta": "dietas.0.recetas.1", "texto": "Koolhydraatpasta voor de avond ervoor" },
  { "ruta": "dietas.0.recetas.2", "texto": "Kipbowl voor de hele week" },
  { "ruta": "dietas.0.recetas.3", "texto": "Herstelsmoothie" },
  { "ruta": "dietas.0.recetas.4", "texto": "Bananenbrood van de koffiezaak" },
  { "ruta": "dietas.1.nombre", "texto": "Terug uit Japan, licht" },
  { "ruta": "dietas.1.descripcion", "texto": "Drie weken ramen, konbini-eten en katsu curry lieten mijn lijf zwaar en de koelkast leeg achter. Twee weken lichte avondmaaltijden met veel peulvruchten en groenten, één fatsoenlijke vismaaltijd per week en ontbijt dat de avond ervoor al klaarstaat, zodat ik niet hoef te improviseren voor de dienst van zeven uur. Een knipoog naar Japan, maar thuis gemaakt en met mate." },
