  { "ruta": "hitos.0.nota", "texto": "Wypłata z kawiarni co dwa tygodnie, podstawa całego miesiąca." },
  { "ruta": "hitos.1.nota", "texto": "Czesne za fizykę: studia zaoczne, które sprawiają wrażenie pełnoetatowych." },
  { "ruta": "hitos.2.nota", "texto": "Czynsz za pokój, zawsze pierwsza rzecz, którą odkładam." },
  { "ruta": "hitos.3.nota", "texto": "Internet i prąd, bez nich nie ma odrabiania zadań." },
  { "ruta": "hitos.4.nota", "texto": "Abonament za telefon, minimum, które jeszcze wczytuje mapy." },
  { "ruta": "hitos.5.nota", "texto": "Streaming: moje kino science fiction bez wychodzenia z domu." },
  { "ruta": "hitos.6.nota", "texto": "Ubezpieczenie samochodu, nudna opłata, którą kiedyś docenię." },
  { "ruta": "hitos.7.nota", "texto": "Moje pierwsze prawdziwe buty do biegania; koniec z wymówkami." },
  { "ruta": "hitos.8.nota", "texto": "Zapisy na 5 km: mój pierwszy numer startowy w życiu." },
  { "ruta": "hitos.9.nota", "texto": "Zapisy na 10 km, tym razem bez tylu wątpliwości." },
  { "ruta": "hitos.10.nota", "texto": "Opłacony półmaraton; kolano w końcu wytrzymało." },
  { "ruta": "hitos.11.nota", "texto": "Czterdzieści dwa kilometry opłacone. Nie ma odwrotu." },
  { "ruta": "hitos.12.nota", "texto": "Odnowienie paszportu sprawiło, że Japonia przestała być mrzonką." },
  { "ruta": "hitos.13.nota", "texto": "Plecak podróżny, przymierzony i obnoszony po całym mieszkaniu." },
  { "ruta": "hitos.14.nota", "texto": "Bilet lotniczy kupiony, ręce same się trzęsły: to się dzieje naprawdę." },
  { "ruta": "hitos.15.nota", "texto": "JR Pass gotowy, trzy tygodnie pociągów na moje nazwisko." },
  { "ruta": "hitos.16.nota", "texto": "Zapłacony nocleg: Tokio, Hakone, Kioto, Osaka, Hiroszima." },
  { "ruta": "hitos.17.nota", "texto": "Wydawanie oszczędności całego roku, grosz do grosza zarobionego." },
  { "ruta": "hitos.18.nota", "texto": "Samochód umarł, a razem z nim cała moja poduszka finansowa." },
  { "ruta": "hitos.19.nota", "texto": "Fizjoterapia kolana: drogo, ale to było to albo poddanie się." },
  { "ruta": "hitos.20.nota", "texto": "Nowe opony, bo stare zaczynały już straszyć." },
  { "ruta": "hitos.21.nota", "texto": "Duży przegląd samochodu — konserwacja z wyboru, nie z konieczności." },
  { "ruta": "hitos.22.nota", "texto": "Formalności samochodowe, podatek za posiadanie ukochanego gruchota." },
  { "ruta": "hitos.23.nota", "texto": "Trzynastka z kawiarni: prosto do funduszu awaryjnego." },
  { "ruta": "hitos.24.nota", "texto": "Prezenty dla rodziny, po zagraniu im na pianinie." },
  { "ruta": "hitos.25.nota", "texto": "Szczepienia Laiki; ona nie zna się na budżecie." },
