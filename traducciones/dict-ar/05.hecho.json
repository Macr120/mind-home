[
  { "clave": "corazon.gato.noche.1", "texto": "ليلة هادئة. لا داعي لإفسادها 🐾" },
  { "clave": "corazon.gato.rutina.0", "texto": "مرحبًا، «{r}» في {h}. لن أتحرك 🐾" },
  { "clave": "corazon.gato.rutina.1", "texto": "اقترب موعد «{r}» ({h}). الأمر بإمكانك، وأنا سأتولى المراقبة 🐱" },
  { "clave": "corazon.gato.generica.0", "texto": "كل شيء تحت السيطرة. تفقدت الأمر أثناء قيلولتي 🐾" },
  { "clave": "corazon.gato.generica.1", "texto": "همم. البيت ما زال قائمًا. لا شكر على واجب 🐱" },
  { "clave": "corazon.perro.manana.0", "texto": "صباح الخير! رائحة هذا اليوم تبشّر بيوم رائع! 🐶" },
  { "clave": "corazon.perro.manana.1", "texto": "حان الصباح! هيا بنا، هيا بنا! 🦴" },
  { "clave": "corazon.perro.tarde.0", "texto": "ظهيرة مثالية لإنجاز الأمور! هاو! 🐶" },
  { "clave": "corazon.perro.tarde.1", "texto": "ما زلت هنا، أراقب كل شيء! 🎉" },
  { "clave": "corazon.perro.noche.0", "texto": "يا له من يوم رائع قضيناه! أليس كذلك؟ أليس كذلك؟ 🐶" },
  { "clave": "corazon.perro.noche.1", "texto": "ليلة هادئة… سأحرس المكان! 🦴" },
  { "clave": "corazon.perro.rutina.0", "texto": "«{r}» في {h}! الأمر بإمكانك! 🎉" },
  { "clave": "corazon.perro.rutina.1", "texto": "تذكير: «{r}» في {h}! هاو! 🐶" },
  { "clave": "corazon.perro.generica.0", "texto": "أحب هذا البيت! 🐶" },
  { "clave": "corazon.perro.generica.1", "texto": "أنا هنا لأي طلب! أي شيء! 🦴" },
  { "clave": "corazon.buho.manana.0", "texto": "الفجر. وقت مثالي لتخطيط اليوم بهدوء. 🦉" },
  { "clave": "corazon.buho.manana.1", "texto": "الصباح المنظم يُثمر ضعفين." },
  { "clave": "corazon.buho.tarde.0", "texto": "منتصف النهار: لحظة جيدة لمراجعة التقدم. 🦉" },
  { "clave": "corazon.buho.tarde.1", "texto": "تسير الظهيرة كما هو مخطط لها." },
  { "clave": "corazon.buho.noche.0", "texto": "يحل الليل. أقترح إنهاء اليوم بملاحظة. 🦉" },
  { "clave": "corazon.buho.noche.1", "texto": "الليل يدعو إلى التأمل." },
  { "clave": "corazon.buho.rutina.0", "texto": "تنبيه في وقته: «{r}» في {h}. 🦉" },
  { "clave": "corazon.buho.rutina.1", "texto": "جدولك الزمني يتضمن «{r}» في {h}." },
  { "clave": "corazon.buho.generica.0", "texto": "أراقب وأدوّن الملاحظات. كل شيء على ما يرام. 🦉" },
  { "clave": "corazon.buho.generica.1", "texto": "المعرفة تتراكم يومًا بعد يوم." },
  { "clave": "corazon.robot.manana.0", "texto": "☀ بدأت دورة اليوم. الأنظمة بنسبة 100%. 🤖" },
  { "clave": "corazon.robot.manana.1", "texto": "صباح الخير. البطارية ممتلئة. ✓" },
  { "clave": "corazon.robot.tarde.0", "texto": "اكتمل مسح الظهيرة. لا يوجد خلل. ✓" },
  { "clave": "corazon.robot.tarde.1", "texto": "الإنتاجية ضمن المعايير المحددة. 🤖" },
  { "clave": "corazon.robot.noche.0", "texto": "وضع الليل نشط. المراقبة جارية. 🤖" },
  { "clave": "corazon.robot.noche.1", "texto": "توصية: إعادة شحن الوحدة البشرية (النوم). ✓" },
  { "clave": "corazon.robot.rutina.0", "texto": "تذكير: موعد «{r}» في {h}. ✓" },
  { "clave": "corazon.robot.rutina.1", "texto": "تنبيه: «{r}» في {h}. 🤖" },
  { "clave": "corazon.robot.generica.0", "texto": "جميع الأنظمة تعمل بشكل طبيعي. 🤖" },
  { "clave": "corazon.robot.generica.1", "texto": "بانتظار التعليمات. الأمر غير عاجل. ✓" },
