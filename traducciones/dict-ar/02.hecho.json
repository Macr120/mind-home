  },
  {
    "clave": "ejercicio.ejDesc.aperturas-con-mancuernas",
    "texto": "استلقِ وافتح ذراعيك في قوس، ثم أعدهما لبعضهما مع إبقاء مرفقيك مثنيين قليلاً."
  },
  {
    "clave": "ejercicio.ejDesc.cruce-en-polea",
    "texto": "قف بين بكرتين عاليتين وقرّب يديك أمامك مع الضغط على عضلات صدرك."
  },
  {
    "clave": "ejercicio.ejDesc.fondos-en-paralelas",
    "texto": "تعلّق على المتوازي، وأنزل جسمك بثني مرفقيك مع إمالة جذعك للأمام، ثم ادفع نفسك للأعلى مجدداً."
  },
  {
    "clave": "ejercicio.ejDesc.flexiones",
    "texto": "استلقِ على وجهك، وأنزل صدرك نحو الأرض مع إبقاء جسمك مستقيماً، ثم ادفع نفسك للأعلى."
  },
  {
    "clave": "ejercicio.ejDesc.dominadas",
    "texto": "تعلّق من البار، واسحب جسمك للأعلى حتى تتجاوز ذقنك مستوى البار."
  },
  {
    "clave": "ejercicio.ejDesc.jalon-al-pecho",
    "texto": "اجلس أمام بكرة عالية واسحب البار نحو صدرك مع دفع مرفقيك للأسفل."
  },
  {
    "clave": "ejercicio.ejDesc.remo-con-barra",
    "texto": "انحنِ مع إبقاء ظهرك مستقيماً، واسحب البار نحو بطنك مع الضغط على عضلات ظهرك."
  },
  {
    "clave": "ejercicio.ejDesc.remo-con-mancuerna",
    "texto": "استند على مقعد واسحب الدمبل نحو جانبك دون لف جذعك."
  },
  {
    "clave": "ejercicio.ejDesc.remo-en-polea-baja",
    "texto": "اجلس واسحب المقبض نحو بطنك مع إبقاء ظهرك منتصباً."
  },
  {
    "clave": "ejercicio.ejDesc.pull-over",
    "texto": "استلقِ وأنزل الدمبل خلف رأسك، ثم أعده فوق صدرك."
  },
  {
    "clave": "ejercicio.ejDesc.face-pull",
    "texto": "عند بكرة بارتفاع الوجه، اسحب الحبل نحو جبهتك مع فتح مرفقيك للخارج."
  },
  {
    "clave": "ejercicio.ejDesc.hiperextensiones",
    "texto": "على المقعد، أنزل جذعك ثم ارفعه مجدداً مع تمديد أسفل ظهرك."
  },
  {
    "clave": "ejercicio.ejDesc.press-militar",
    "texto": "قف وادفع البار من كتفيك إلى أعلى فوق رأسك."
  },
  {
    "clave": "ejercicio.ejDesc.press-arnold",
    "texto": "اجلس وادفع الدمبلين فوق رأسك مع تدوير راحتي يديك من الداخل إلى الخارج."
  },
  {
    "clave": "ejercicio.ejDesc.elevaciones-laterales",
    "texto": "قف وارفع الدمبلين جانبياً حتى مستوى الكتفين."
  },
  {
    "clave": "ejercicio.ejDesc.elevaciones-frontales",
    "texto": "قف وارفع الدمبل أمامك حتى مستوى العينين."
  },
  {
    "clave": "ejercicio.ejDesc.pajaros",
