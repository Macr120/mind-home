[
  {
    "clave": "corazon.gato.noche.1",
    "texto": "Malam yang tenang. Jangan rusak 🐾"
  },
  {
    "clave": "corazon.gato.rutina.0",
    "texto": "Hei, “{r}” jam {h}. Aku nggak bakal gerak 🐾"
  },
  {
    "clave": "corazon.gato.rutina.1",
    "texto": "“{r}” segera tiba ({h}). Kamu pasti bisa, aku yang awasi 🐱"
  },
  {
    "clave": "corazon.gato.generica.0",
    "texto": "Semua terkendali. Aku periksa sambil tidur siang 🐾"
  },
  {
    "clave": "corazon.gato.generica.1",
    "texto": "Hmm. Rumah masih berdiri. Sama-sama 🐱"
  },
  {
    "clave": "corazon.perro.manana.0",
    "texto": "Selamat pagi! Hari ini baunya seperti hari yang hebat! 🐶"
  },
  {
    "clave": "corazon.perro.manana.1",
    "texto": "Sudah pagi! Ayo ayo ayo! 🦴"
  },
  {
    "clave": "corazon.perro.tarde.0",
    "texto": "Sore yang sempurna buat menyelesaikan semuanya! Guk! 🐶"
  },
  {
    "clave": "corazon.perro.tarde.1",
    "texto": "Masih di sini, mengawasi semuanya! 🎉"
  },
  {
    "clave": "corazon.perro.noche.0",
    "texto": "Hari yang hebat, kan? Kan? 🐶"
  },
  {
    "clave": "corazon.perro.noche.1",
    "texto": "Malam yang tenang… Aku yang jaga! 🦴"
  },
  {
    "clave": "corazon.perro.rutina.0",
    "texto": "“{r}” jam {h}! Kamu pasti bisa! 🎉"
  },
  {
    "clave": "corazon.perro.rutina.1",
    "texto": "Jangan lupa “{r}” jam {h}! Guk! 🐶"
  },
  {
    "clave": "corazon.perro.generica.0",
    "texto": "Aku suka rumah ini! 🐶"
  },
  {
    "clave": "corazon.perro.generica.1",
    "texto": "Panggil aku kalau butuh apa-apa! Apa saja! 🦴"
  },
  {
    "clave": "corazon.buho.manana.0",
    "texto": "Fajar. Waktu ideal untuk merencanakan hari dengan tenang. 🦉"
  },
  {
    "clave": "corazon.buho.manana.1",
    "texto": "Pagi yang tertata memberi hasil dua kali lipat."
  },
  {
    "clave": "corazon.buho.tarde.0",
    "texto": "Tengah hari: saat yang baik untuk meninjau kemajuan. 🦉"
  },
  {
    "clave": "corazon.buho.tarde.1",
    "texto": "Sore berjalan sesuai rencana."
  },
  {
    "clave": "corazon.buho.noche.0",
    "texto": "Malam tiba. Aku sarankan menutup hari dengan sebuah catatan. 🦉"
  },
  {
    "clave": "corazon.buho.noche.1",
    "texto": "Malam mengundang perenungan."
  },
  {
    "clave": "corazon.buho.rutina.0",
    "texto": "Pemberitahuan tepat waktu: “{r}” jam {h}. 🦉"
  },
  {
    "clave": "corazon.buho.rutina.1",
    "texto": "Linimasamu mencantumkan “{r}” jam {h}."
  },
  {
    "clave": "corazon.buho.generica.0",
    "texto": "Aku mengamati dan mencatat. Semua beres. 🦉"
  },
  {
    "clave": "corazon.buho.generica.1",
    "texto": "Pengetahuan bertambah hari demi hari."
  },
  {
    "clave": "corazon.robot.manana.0",
    "texto": "☀ SIKLUS HARI DIMULAI. SISTEM 100%. 🤖"
  },
  {
    "clave": "corazon.robot.manana.1",
    "texto": "SELAMAT PAGI. BATERAI PENUH. ✓"
  },
  {
    "clave": "corazon.robot.tarde.0",
    "texto": "PINDAI SORE SELESAI. TIDAK ADA ANOMALI. ✓"
  },
  {
    "clave": "corazon.robot.tarde.1",
    "texto": "PRODUKTIVITAS SESUAI PARAMETER. 🤖"
  },
  {
    "clave": "corazon.robot.noche.0",
    "texto": "MODE MALAM AKTIF. PENGAWASAN BERLANGSUNG. 🤖"
  },
  {
    "clave": "corazon.robot.noche.1",
    "texto": "REKOMENDASI: ISI ULANG UNIT MANUSIA (TIDUR). ✓"
  },
  {
    "clave": "corazon.robot.rutina.0",
