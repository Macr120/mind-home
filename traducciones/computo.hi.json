[
  { "ruta": "carpetas.0.nombre", "texto": "भौतिकी II" },
  { "ruta": "carpetas.1.nombre", "texto": "मिडटर्म परीक्षाएं" },
  { "ruta": "carpetas.1.formulas.0.nombre", "texto": "स्थिर त्वरण में स्थिति" },
  { "ruta": "carpetas.1.formulas.0.variables.0.nombre", "texto": "प्रारंभिक स्थिति" },
  { "ruta": "carpetas.1.formulas.0.variables.1.nombre", "texto": "प्रारंभिक वेग" },
  { "ruta": "carpetas.1.formulas.0.variables.2.nombre", "texto": "त्वरण" },
  { "ruta": "carpetas.1.formulas.0.variables.3.nombre", "texto": "समय" },
  { "ruta": "carpetas.1.formulas.1.nombre", "texto": "टोरिसेली (समय के बिना वेग)" },
  { "ruta": "carpetas.1.formulas.1.variables.0.nombre", "texto": "प्रारंभिक वेग" },
  { "ruta": "carpetas.1.formulas.1.variables.1.nombre", "texto": "त्वरण" },
  { "ruta": "carpetas.1.formulas.1.variables.2.nombre", "texto": "विस्थापन" },
  { "ruta": "carpetas.1.formulas.2.nombre", "texto": "गतिज ऊर्जा" },
  { "ruta": "carpetas.1.formulas.2.descripcion", "texto": "द्रव्यमान को स्थिर मानकर, दौड़ते समय अक्सर इसकी गणना ख़ुद के लिए की जाती है।" },
  { "ruta": "carpetas.1.formulas.2.variables.0.nombre", "texto": "द्रव्यमान" },
  { "ruta": "carpetas.1.formulas.2.variables.1.nombre", "texto": "वेग" },
  { "ruta": "carpetas.1.formulas.3.nombre", "texto": "हुक का नियम" },
  { "ruta": "carpetas.1.formulas.3.variables.0.nombre", "texto": "स्प्रिंग स्थिरांक" },
  { "ruta": "carpetas.1.formulas.3.variables.1.nombre", "texto": "विरूपण" },
  { "ruta": "carpetas.1.formulas.4.nombre", "texto": "सरल लोलक का आवर्तकाल" },
  { "ruta": "carpetas.1.formulas.4.variables.0.nombre", "texto": "लंबाई" },
  { "ruta": "carpetas.1.formulas.4.variables.1.nombre", "texto": "गुरुत्वीय त्वरण" },
  { "ruta": "carpetas.2.nombre", "texto": "कैफ़े" },
  { "ruta": "carpetas.2.formulas.0.nombre", "texto": "प्रति कप लागत" },
  { "ruta": "carpetas.2.formulas.0.descripcion", "texto": "समय को छोड़कर, एक कप परोसने में जो लागत आती है।" },
  { "ruta": "carpetas.2.formulas.0.variables.0.nombre", "texto": "एक किलो कॉफ़ी की कीमत" },
  { "ruta": "carpetas.2.formulas.0.variables.1.nombre", "texto": "प्रति कप ग्राम" },
  { "ruta": "carpetas.2.formulas.0.variables.2.nombre", "texto": "दूध की लागत" },
  { "ruta": "carpetas.2.formulas.0.variables.3.nombre", "texto": "कप और ढक्कन" },
  { "ruta": "carpetas.2.formulas.1.nombre", "texto": "कीमत पर मार्जिन" },
  { "ruta": "carpetas.2.formulas.1.tex", "texto": "मार्जिन = \\dfrac{कीमत - लागत}{कीमत} \\times 100" },
  { "ruta": "carpetas.2.formulas.1.variables.0.nombre", "texto": "बिक्री मूल्य" },
  { "ruta": "carpetas.2.formulas.1.variables.1.nombre", "texto": "कप की लागत" },
  { "ruta": "carpetas.3.nombre", "texto": "दौड़ना" },
  { "ruta": "carpetas.3.formulas.0.nombre", "texto": "प्रति किलोमीटर पेस" },
  { "ruta": "carpetas.3.formulas.0.tex", "texto": "पेस = \\dfrac{मिनट}{किमी}" },
  { "ruta": "carpetas.3.formulas.0.variables.0.nombre", "texto": "कुल मिनट" },
  { "ruta": "carpetas.3.formulas.0.variables.1.nombre", "texto": "किलोमीटर" },
  { "ruta": "carpetas.3.formulas.1.nombre", "texto": "मैराथन लक्ष्य के लिए पेस" },
  { "ruta": "carpetas.3.formulas.1.variables.0.nombre", "texto": "मिनटों में लक्ष्य" },
  { "ruta": "carpetas.3.formulas.2.nombre", "texto": "अनुमानित अधिकतम VO₂" },
  { "ruta": "carpetas.3.formulas.2.tex", "texto": "VO_{2}\\,अधिकतम \\approx 15.3\\,\\dfrac{HR_{अधिकतम}}{HR_{विश्राम}}" },
  { "ruta": "carpetas.3.formulas.2.descripcion", "texto": "उथ का फ़ॉर्मूला: अनुमानित, पर यह देखने के लिए काफ़ी है कि प्रगति हो रही है या नहीं।" },
  { "ruta": "carpetas.3.formulas.2.variables.0.nombre", "texto": "अधिकतम हृदय गति" },
  { "ruta": "carpetas.3.formulas.2.variables.0.unidad", "texto": "बीपीएम" },
  { "ruta": "carpetas.3.formulas.2.variables.1.nombre", "texto": "आराम की हृदय गति" },
  { "ruta": "carpetas.3.formulas.2.variables.1.unidad", "texto": "बीपीएम" },
