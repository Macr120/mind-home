  { "ruta": "plantillas.7.notas.7", "texto": "يوم اثنين راكد" },
  { "ruta": "hitos.0.nota", "texto": "راتب المقهى كل أسبوعين، هو أساس شهري بأكمله." },
  { "ruta": "hitos.1.nota", "texto": "رسوم دراسة الفيزياء، تخصص جزئي يبدو دوامًا كاملاً." },
  { "ruta": "hitos.2.nota", "texto": "إيجار الغرفة، أول ما أجنّبه دائمًا." },
  { "ruta": "hitos.3.nota", "texto": "الإنترنت والكهرباء، بدونهما لا واجبات." },
  { "ruta": "hitos.4.nota", "texto": "باقة الهاتف، الحد الأدنى الذي ما زال يفتح الخرائط." },
  { "ruta": "hitos.5.nota", "texto": "البث: سينما الخيال العلمي الخاصة بي دون مغادرة البيت." },
  { "ruta": "hitos.6.nota", "texto": "تأمين السيارة، دفعة مملة سأشكر نفسي عليها يومًا ما." },
  { "ruta": "hitos.7.nota", "texto": "أول حذاء جري حقيقي لي؛ لم يعد هناك عذر." },
  { "ruta": "hitos.8.nota", "texto": "التسجيل في سباق 5 كم: أول رقم مشاركة في حياتي." },
  { "ruta": "hitos.9.nota", "texto": "التسجيل في سباق 10 كم، هذه المرة دون كل ذلك التردد." },
  { "ruta": "hitos.10.nota", "texto": "دفع رسوم نصف الماراثون؛ الركبة تحملت أخيرًا." },
  { "ruta": "hitos.11.nota", "texto": "دفع رسوم الاثنين وأربعين كيلومترًا. لا عودة الآن." },
  { "ruta": "hitos.12.nota", "texto": "تجديد جواز السفر جعل اليابان تخرج من الخيال إلى الخطة." },
  { "ruta": "hitos.13.nota", "texto": "حقيبة السفر، جربتها محمّلة في أنحاء الشقة كلها." },
  { "ruta": "hitos.14.nota", "texto": "اشتريت تذكرة الطيران وارتجفت يداي: الأمر حقيقي." },
  { "ruta": "hitos.15.nota", "texto": "تذكرة JR Pass جاهزة، ثلاثة أسابيع من القطارات باسمي." },
  { "ruta": "hitos.16.nota", "texto": "دفع الإقامة: طوكيو وهاكوني وكيوتو وأوساكا وهيروشيما." },
  { "ruta": "hitos.17.nota", "texto": "أنفق مدخرات عام كامل، قرشًا قرشًا كسبته." },
  { "ruta": "hitos.18.nota", "texto": "تعطلت السيارة نهائيًا وأخذت معها كل مدخراتي الاحتياطية." },
  { "ruta": "hitos.19.nota", "texto": "علاج طبيعي للركبة: مكلف، لكن البديل كان الاستسلام." },
  { "ruta": "hitos.20.nota", "texto": "إطارات جديدة لأن القديمة صارت تخيف." },
  { "ruta": "hitos.21.nota", "texto": "صيانة كبرى للسيارة، صيانة اخترتها فعلاً هذه المرة." },
  { "ruta": "hitos.22.nota", "texto": "أوراق السيارة وضرائبها، ثمن حب الخردة القديمة." },
  { "ruta": "hitos.23.nota", "texto": "مكافأة نهاية العام من المقهى: مباشرة إلى صندوق الطوارئ." },
  { "ruta": "hitos.24.nota", "texto": "هدايا لعائلتي، بعد أن عزفت لهم على البيانو." },
  { "ruta": "hitos.25.nota", "texto": "تطعيمات لايكا؛ فهي لا تفهم في الميزانية." },
