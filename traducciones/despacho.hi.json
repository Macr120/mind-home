  {
    "ruta": "hitos.0.nota",
    "texto": "कैफ़े की पखवाड़े की तनख़्वाह — पूरे महीने की नींव।"
  },
  {
    "ruta": "hitos.1.nota",
    "texto": "फ़िज़िक्स की फ़ीस — पार्ट टाइम पढ़ाई, पर पूरे समय जैसी महसूस होती है।"
  },
  {
    "ruta": "hitos.2.nota",
    "texto": "कमरे का किराया — हमेशा सबसे पहले अलग रखी जाने वाली रकम।"
  },
  {
    "ruta": "hitos.3.nota",
    "texto": "इंटरनेट और बिजली — इनके बिना कोई भी होमवर्क नहीं होता।"
  },
  {
    "ruta": "hitos.4.nota",
    "texto": "फ़ोन का प्लान — बस इतना कि नक़्शे भर खुल जाएं।"
  },
  {
    "ruta": "hitos.5.nota",
    "texto": "स्ट्रीमिंग: घर बैठे मेरा साइंस-फ़िक्शन सिनेमा।"
  },
  {
    "ruta": "hitos.6.nota",
    "texto": "कार इंश्योरेंस — एक उबाऊ भुगतान, जिसके लिए किसी दिन दिल से शुक्रिया कहा जाएगा।"
  },
  {
    "ruta": "hitos.7.nota",
    "texto": "पहले असली रनिंग शूज़ — अब कोई बहाना नहीं बचा।"
  },
  {
    "ruta": "hitos.8.nota",
    "texto": "5K के लिए रजिस्ट्रेशन — ज़िंदगी का पहला रेस नंबर।"
  },
  {
    "ruta": "hitos.9.nota",
    "texto": "10K के लिए रजिस्ट्रेशन — इस बार इतना सोचे बिना।"
  },
  {
    "ruta": "hitos.10.nota",
    "texto": "हाफ़ मैराथन की फ़ीस भरी — घुटने ने आख़िरकार साथ दिया।"
  },
  {
    "ruta": "hitos.11.nota",
    "texto": "बयालीस किलोमीटर की फ़ीस भर दी गई। अब पीछे हटने का कोई रास्ता नहीं।"
  },
  {
    "ruta": "hitos.12.nota",
    "texto": "पासपोर्ट रिन्यू होने से जापान अब सिर्फ़ ख़्वाब नहीं, एक योजना बन गया।"
  },
  {
    "ruta": "hitos.13.nota",
    "texto": "यात्रा वाला बैकपैक — पूरे घर में भरकर आज़माया गया।"
  },
  {
    "ruta": "hitos.14.nota",
    "texto": "टिकट बुक हुआ — और हाथ कांप उठे: यह सच है।"
  },
  {
    "ruta": "hitos.15.nota",
    "texto": "JR Pass तैयार — मेरे नाम तीन हफ़्तों की ट्रेनें।"
  },
  {
    "ruta": "hitos.16.nota",
    "texto": "ठहरने का भुगतान — टोक्यो, हाकोने, क्योटो, ओसाका, हिरोशिमा।"
  },
  {
    "ruta": "hitos.17.nota",
    "texto": "पूरे साल की कमाई — पाई-पाई करके ख़र्च हो रही है।"
  },
  {
    "ruta": "hitos.18.nota",
    "texto": "गाड़ी बंद हो गई, और साथ में पूरी जमा-पूंजी भी ख़त्म हो गई।"
  },
  {
    "ruta": "hitos.19.nota",
    "texto": "घुटने की फ़िज़ियोथेरेपी — महंगी, पर विकल्प था बस यही या हार मान लेना।"
  },
  {
    "ruta": "hitos.20.nota",
    "texto": "नए टायर — पुराने अब डरावने लगने लगे थे।"
  },
  {
    "ruta": "hitos.21.nota",
    "texto": "गाड़ी की बड़ी सर्विस — वह मेंटेनेंस जो सचमुच अपनी मर्ज़ी से चुना गया।"
  },
  {
    "ruta": "hitos.22.nota",
    "texto": "गाड़ी के कागज़ात और टैक्स — पुरानी पर प्यारी गाड़ी रखने की कीमत।"
  },
  {
    "ruta": "hitos.23.nota",
    "texto": "कैफ़े का सालाना बोनस — सीधा आपातकालीन कोष में।"
  },
  {
    "ruta": "hitos.24.nota",
    "texto": "परिवार के लिए तोहफ़े — उनके लिए पियानो बजाने के बाद।"
  },
  {
    "ruta": "hitos.25.nota",
    "texto": "लाइका के टीके — उसे बजट-वजट की कोई समझ नहीं।"
  },
